---
/**
 * Icono.astro
 * ─────────────────────────────────────────────────────────────
 * Pinta un símbolo del catálogo de `src/lib/iconos.ts`.
 *
 * Es la única forma de pintar un icono en el sitio: un dibujo copiado en
 * varios archivos termina con versiones distintas que nadie detecta leyendo.
 *
 * ── TAMAÑO Y TRAZO ──────────────────────────────────────────────────────
 * `tam` solo admite los pasos de TAMANOS_ICONO (12, 14, 16, 20, 24, 28): el
 * sitio llegó a usar once tamaños, de 10 a 28, y cuatro grosores de trazo
 * puestos a mano, así que dos iconos vecinos nunca pesaban lo mismo. El
 * grosor ya no se elige: sale del tamaño (ver trazoPara). Un 12 necesita más
 * trazo para no desaparecer; un 28 con el mismo trazo se ve tosco.
 *
 * ── LO QUE ESTE COMPONENTE NO HACE ──────────────────────────────────────
 * No reduce el peso de la página. El HTML publicado sigue llevando el trazado
 * completo en cada sitio donde aparece el icono: esto es reutilización de
 * código fuente, no de bytes servidos. Para lo segundo haría falta un sprite
 * con <use>, que es otra decisión y tiene sus propias contrapartidas.
 *
 * ── EL `set:html` Y LA REGLA 1 DE CLAUDE.md ─────────────────────────────
 * El interior del <svg> se inyecta, así que sus hijos NO llevan el
 * `data-astro-cid` de la página. Estilar un hijo del símbolo desde el <style>
 * de una página no engancha: ese estilo va en design-system.css.
 *
 * Uso:
 *   <Icono nombre="descarga" tam={14} />
 *   <Icono nombre="chevron-abajo" tam={12} class="nav-chevron" />
 */
import { ICONOS, trazoPara, type NombreIcono, type TamIcono } from '../lib/iconos';

interface Props {
  nombre: NombreIcono;
  /** Lado del cuadrado en px, de la escala TAMANOS_ICONO. El viewBox siempre es 0 0 24 24. */
  tam?: TamIcono;
  class?: string;
}

const { nombre, tam = 16, class: clase } = Astro.props;
const icono = ICONOS[nombre];
---

{icono.tipo === 'trazo' ? (
  <svg
    width={tam}
    height={tam}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={trazoPara(tam)}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class={clase}
    set:html={icono.d}
  />
) : (
  <svg
    width={tam}
    height={tam}
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    class={clase}
    set:html={icono.d}
  />
)}
