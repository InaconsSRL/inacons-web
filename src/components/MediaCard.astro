---
/**
 * MediaCard.astro
 * ─────────────────────────────────────────────────────────────
 * Tarjeta de imagen a sangre con velo y cuerpo anclado abajo. La usan
 * servicios y proyectos en el home, /servicios/ y /proyectos/.
 *
 * El chrome vive en design-system.css (.card--media y sus partes). La
 * imagen pasa por astro:assets: sale en WebP, con srcset y con las
 * dimensiones reales, aunque el original sea una foto de 1920 px.
 *
 * Uso:
 *   <MediaCard href="/servicios/obras-civiles/" image={servicio.data.imagen}
 *     alt="" title="Obras Civiles" desc="…" />
 *   <MediaCard href={`/proyectos/${p.id}/`} image={p.data.imagen} alt={p.data.titulo}
 *     tag={p.data.categoria} title={p.data.titulo} meta="Piura · 2025" ratio="4/5" />
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icono from './Icono.astro';

interface Props {
  href: string;
  image: ImageMetadata;
  /** Vacío cuando el título ya nombra la imagen: así no se lee dos veces. */
  alt: string;
  title: string;
  /** Párrafo bajo el título — servicios */
  desc?: string;
  /** Línea de metadatos bajo el título — ubicación, año */
  meta?: string;
  /** Etiqueta sobre el título — categoría del proyecto */
  tag?: string;
  /**
   * Texto de un pseudo-botón al pie. La tarjeta entera ya es un enlace, así
   * que va como <span>: un control dentro de un enlace es markup inválido.
   */
  cta?: string;
  /** Proporción de la tarjeta. Por defecto 4/3 */
  ratio?: string;
  /** Proporción por debajo de 768px. Por defecto, la misma que ratio */
  ratioMobile?: string;
  loading?: 'lazy' | 'eager';
}

const { href, image, alt, title, desc, meta, tag, cta, ratio, ratioMobile, loading = 'lazy' } = Astro.props;

const ratioVars = [
  ratio && `--card-ratio: ${ratio}`,
  ratioMobile && `--card-ratio-mobile: ${ratioMobile}`,
].filter(Boolean).join('; ');
---

<a href={href} class="card card--media" style={ratioVars || undefined}>
  <Image
    quality={70}
    class="card-media-img"
    src={image}
    alt={alt}
    widths={[400, 640, 960]}
    sizes="(min-width: 1024px) 380px, (min-width: 768px) 50vw, 100vw"
    loading={loading}
  />
  <div class="card-media-overlay"></div>
  <div class="card-media-body">
    {tag && <span class="card-media-tag">{tag}</span>}
    <h3 class="card-media-title">{title}</h3>
    {desc && <p class="card-media-desc">{desc}</p>}
    {meta && <p class="card-media-meta">{meta}</p>}
    {cta && (
      <span class="btn btn-outline-light btn-sm card-media-cta">
        {cta}
        <Icono nombre="flecha-derecha" tam={14} />
      </span>
    )}
  </div>
</a>
