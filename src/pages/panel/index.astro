---
// PANEL DE ADMINISTRACIÓN — /panel/
//
// Fase 3: administra los códigos QR. Reemplaza a /empresa/admin.php, que sigue
// en pie hasta que este panel haga lo mismo; el 301 se activa al final de esta
// fase, no antes.
//
// Sobre la autenticación en un sitio estático: no hay servidor propio que
// proteja esta URL, así que el HTML es público. Eso no es un agujero. Este
// archivo no contiene ni un dato: todo lo pide a Supabase con la sesión del
// visitante, y quien decide si responde es RLS, del lado de la base. Esconder
// el HTML no protegería nada, y no esconderlo no expone nada.
//
// El <style> de acá es SOLO layout de esta página. Campos, botones, avisos,
// superficies, tablas y diálogos salen del sistema de diseño — ver /sistema/.
// Si hace falta un componente nuevo, se agrega allá, no acá.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabaseConfigurado } from '../../lib/supabase';
---

<BaseLayout
  title="Panel | INACONS"
  description="Administración interna."
  robots="noindex, nofollow"
  minimalChrome={true}
>

  <style slot="head">
    .pnl { min-height: 100vh; background: var(--c-bg-muted); padding: var(--sp-l1) var(--sp-5) var(--sp-l4); }
    .pnl-caja  { width: 100%; max-width: 420px; margin: 0 auto; }
    .pnl-ancho { width: 100%; max-width: 1040px; margin: 0 auto; }

    .pnl-marca { text-align: center; margin-bottom: var(--sp-7); }
    .pnl-marca img { height: 38px; width: auto; }
    .pnl-rotulo {
      display: block;
      margin-top: var(--sp-3);
      font-size: var(--fs-2xs);
      font-weight: var(--fw-semibold);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--c-text-muted);
    }

    .pnl-barra {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-4);
      align-items: center;
      justify-content: space-between;
      margin-bottom: var(--sp-5);
    }
    .pnl-sesion { font-size: var(--fs-sm); color: var(--c-text-muted); min-width: 0; word-break: break-word; }
    .pnl-sesion strong { color: var(--c-text-heading); font-weight: var(--fw-semibold); }

    .pnl-encabezado {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-4);
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: var(--sp-5);
    }
    .pnl-encabezado > div { min-width: 0; }

    .pnl-herramientas { display: flex; flex-wrap: wrap; gap: var(--sp-2); }

    /* Solo el marco. El tamaño del SVG lo resuelve .qr-lienzo del sistema:
       el símbolo lo inyecta JS y no lleva el cid de esta página. */
    .pnl-qr-vista {
      padding: var(--sp-5);
      background: var(--c-bg-muted);
      border-radius: var(--radius);
    }

    .pnl-pie { margin-top: var(--sp-6); text-align: center; font-size: var(--fs-xs); color: var(--c-text-muted); }
    .pnl-pie a { color: var(--c-secondary); }

    .pnl-espacio { margin-top: var(--sp-5); }

    /*
      Hoja de impresión.

      No se abre en otra ventana: los bloqueadores de ventanas emergentes la
      matan sin avisar, y quien la manda a imprimir cree que falló la impresora.
      Vive en esta misma página, oculta, y al imprimir se esconde todo lo demás.
    */
    .pnl-hoja { display: none; }

    @media print {
      body > *:not(.pnl-hoja),
      .pnl { display: none !important; }

      .pnl-hoja {
        display: block !important;
        position: absolute;
        inset: 0;
        padding: 24mm;
        text-align: center;
        background: #fff;
      }
      .pnl-hoja img.pnl-hoja-logo { height: 14mm; width: auto; margin-bottom: 14mm; }
      .pnl-hoja h1 { font-size: 20pt; color: #14172d; margin-bottom: 4mm; }
            /*  La URL legible debajo del símbolo es el plan B: si el QR no escanea
          por reflejo, distancia o mala posición, la persona todavía puede
          teclearla. Monoespaciada para que no se confunda 0 con O. */
      .pnl-hoja .pnl-hoja-url {
        margin-top: 8mm;
        font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
        font-size: 13pt;
        color: #14172d;
        word-break: break-all;
      }
      .pnl-hoja .pnl-hoja-nota { margin-top: 6mm; font-size: 9pt; color: #5a6280; }
    }
  </style>

  <div class="pnl">

    {!supabaseConfigurado && (
      <div class="pnl-caja">
        <div class="pnl-marca">
          <img src="/assets/imagenes/logos/logo_inacons.svg" alt="INACONS" width="140" height="38" />
          <span class="pnl-rotulo">Panel</span>
        </div>
        <div class="panel panel--raised">
          <h2 class="panel-title">Panel sin configurar</h2>
          <p class="panel-desc">
            Faltan <code>PUBLIC_SUPABASE_URL</code> y <code>PUBLIC_SUPABASE_ANON_KEY</code>
            en el entorno de compilación. Este aviso se genera en el build, no en
            el navegador: el panel no llegó a construirse con conexión a la base.
          </p>
        </div>
      </div>
    )}

    {supabaseConfigurado && (
      <>
        <!-- ════ ENTRAR ════ -->
        <div class="pnl-caja" id="vista-login">
          <div class="pnl-marca">
            <img src="/assets/imagenes/logos/logo_inacons.svg" alt="INACONS" width="140" height="38" />
            <span class="pnl-rotulo">Panel</span>
          </div>

          <div class="panel panel--raised panel--accent">
            <div class="notice notice--error" id="login-error" hidden></div>
            <form id="form-login" novalidate>
              <div class="form-group">
                <label for="correo">Correo</label>
                <input type="email" id="correo" class="form-input" autocomplete="username" required />
              </div>
              <div class="form-group">
                <label for="clave">Contraseña</label>
                <input type="password" id="clave" class="form-input" autocomplete="current-password" required />
              </div>
              <button type="submit" class="btn btn-primary btn-block" id="btn-entrar">Entrar</button>
            </form>
          </div>

          <p class="pnl-pie">Acceso restringido. <a href="/">Volver al sitio</a></p>
        </div>

        <!-- ════ DENTRO ════ -->
        <div class="pnl-ancho" id="vista-sesion" hidden>
          <div class="pnl-barra">
            <div class="pnl-sesion">Sesión iniciada como <strong id="sesion-correo"></strong></div>
            <button type="button" class="btn btn-outline btn-sm" id="btn-salir">Cerrar sesión</button>
          </div>

          <!--
            Tener sesión y ser administrador son dos cosas distintas. Sin este
            aviso, alguien fuera de la allowlist entraría, vería la tabla vacía
            y concluiría que no hay códigos, en vez de que no tiene acceso.
          -->
          <div class="notice" id="aviso-admin" hidden></div>

          <!--
            docs/deploy.md y docs/ESPECIFICACION.md llevaban meses describiendo
            este botón como si existiera. TABLAS y getSupabaseAnonimo() estaban
            escritos en src/lib/supabase.ts exactamente para esto, y nada los
            importaba: el criterio de aceptación de la Fase 1 ("con la clave
            anónima, sin sesión, no se puede leer ni escribir ninguna tabla")
            se verificó a mano una vez, con curl, y no quedó nada que lo repita.
          -->
          <div class="panel panel--raised pnl-espacio">
            <div class="pnl-encabezado">
              <div>
                <h2 class="panel-title">Seguridad</h2>
                <p class="panel-desc">
                  Prueba, con la clave anónima y sin sesión, que ninguna tabla
                  responde. Conviene repetirlo cada vez que se agregue una
                  tabla o se toque una política.
                </p>
              </div>
              <div class="pnl-herramientas">
                <button type="button" class="btn btn-outline btn-sm" id="btn-rls">Probar aislamiento (RLS)</button>
              </div>
            </div>
            <ul class="data-list" id="rls-resultados" hidden></ul>
          </div>

          <div class="panel panel--raised pnl-espacio">
            <div class="pnl-encabezado">
              <div>
                <h2 class="panel-title">Códigos QR</h2>
                <p class="panel-desc" id="resumen-codigos">Cargando…</p>
              </div>
              <div class="pnl-herramientas">
                <button type="button" class="btn btn-outline btn-sm" id="btn-refrescar-stats">Actualizar escaneos</button>
                <button type="button" class="btn btn-primary btn-sm" id="btn-nuevo">Nuevo código</button>
              </div>
            </div>

            <div class="notice" id="aviso-codigos" hidden></div>

            <div class="tabla-scroll">
              <table class="tabla">
                <thead>
                  <tr>
                    <th>Código</th>
                    <th>Tipo</th>
                    <th>Destino</th>
                    <th>Estado</th>
                    <th class="tabla-num">Escaneos</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody id="tabla-codigos">
                  <tr><td colspan="6" class="tabla-vacia">Cargando…</td></tr>
                </tbody>
              </table>
            </div>

            <p class="form-hint pnl-espacio">
              Los códigos no se borran, solo se desactivan. Un código borrado cuyo QR
              está impreso deja papel que nadie puede arreglar.
            </p>
          </div>

          <p class="pnl-pie"><a href="/">Volver al sitio</a></p>
        </div>

        <!-- ════ DIÁLOGO: ALTA Y EDICIÓN ════ -->
        <div class="dialogo" id="dlg-codigo" role="dialog" aria-modal="true" aria-labelledby="dlg-codigo-titulo" hidden>
          <div class="dialogo-caja">
            <button type="button" class="dialogo-cerrar" data-cerrar="dlg-codigo" aria-label="Cerrar">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>

            <h3 class="dialogo-titulo" id="dlg-codigo-titulo">Nuevo código</h3>
            <p class="dialogo-desc" id="dlg-codigo-desc"></p>

            <div class="notice notice--error" id="dlg-codigo-error" hidden></div>

            <form id="form-codigo" novalidate>
              <div class="form-group" id="grupo-codigo">
                <label for="f-codigo">Código</label>
                <input type="text" id="f-codigo" class="form-input" autocapitalize="characters" spellcheck="false" />
                <span class="form-hint">
                  Letras, números, <code>-</code> y <code>_</code>. Se guarda en mayúsculas y
                  al resolver no distingue mayúsculas ni el tipo de guión.
                  <button type="button" class="btn btn-outline btn-sm" id="btn-generar" style="margin-top: var(--sp-2)">Generar uno opaco</button>
                </span>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="f-tipo">Tipo</label>
                  <select id="f-tipo" class="form-select">
                    <option value="url">URL</option>
                    <option value="evento">Evento</option>
                    <option value="empleado">Empleado</option>
                    <option value="recurso">Recurso</option>
                    <option value="wifi">WiFi</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="f-impreso">¿Va a material impreso?</label>
                  <select id="f-impreso" class="form-select">
                    <option value="false">No</option>
                    <option value="true">Sí</option>
                  </select>
                  <span class="form-hint">Marca la diferencia entre reasignar tranquilo y saber que hay papel circulando.</span>
                </div>
              </div>

              <div class="form-group">
                <label for="f-destino">Destino</label>
                <input type="url" id="f-destino" class="form-input" placeholder="https://home.inacons.com.pe/…" required />
                <span class="form-hint" id="hint-destino">El dominio tiene que estar en la lista permitida.</span>
              </div>

              <div class="form-group" id="grupo-motivo" hidden>
                <label for="f-motivo">Motivo del cambio</label>
                <input type="text" id="f-motivo" class="form-input" placeholder="Ej. el flyer cambió de destino" />
                <span class="form-hint">Queda en el registro de auditoría junto al destino anterior.</span>
              </div>

              <div class="form-group">
                <label for="f-notas">Notas</label>
                <input type="text" id="f-notas" class="form-input" />
              </div>

              <div class="dialogo-acciones">
                <button type="button" class="btn btn-outline" data-cerrar="dlg-codigo">Cancelar</button>
                <button type="submit" class="btn btn-primary" id="btn-guardar">Guardar</button>
              </div>
            </form>
          </div>
        </div>

        <!-- ════ DIÁLOGO: QR ════ -->
        <div class="dialogo" id="dlg-qr" role="dialog" aria-modal="true" aria-labelledby="dlg-qr-titulo" hidden>
          <div class="dialogo-caja">
            <button type="button" class="dialogo-cerrar" data-cerrar="dlg-qr" aria-label="Cerrar">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>

            <h3 class="dialogo-titulo" id="dlg-qr-titulo">Código QR</h3>

            <div class="form-group">
              <label for="f-perfil">Perfil</label>
              <select id="f-perfil" class="form-select">
                <option value="impresion">Impresión — azul, ECC H</option>
                <option value="pantalla">Pantalla / video — negro, ECC M</option>
              </select>
              <span class="form-hint" id="hint-perfil"></span>
            </div>

            <div class="pnl-qr-vista qr-lienzo" id="qr-vista" style="--qr-lado: 210px"></div>
            <p class="form-hint" id="qr-datos" style="text-align:center"></p>

            <!--
              Las dos filas juntas y no solo la primera: viendo únicamente la
              URL corta, cuesta creer que lleve al sitio correcto, porque no se
              parece en nada al destino. Ponerlas una encima de la otra explica
              la indirección sin tener que explicarla.
            -->
            <ul class="data-list pnl-espacio">
              <li><span class="data-key">URL del QR</span><span class="data-value" id="qr-url"></span></li>
              <li><span class="data-key">Lleva a</span><span class="data-value" id="qr-destino"></span></li>
            </ul>

            <div class="dialogo-acciones">
              <button type="button" class="btn btn-outline btn-sm" id="btn-hoja">Hoja para imprimir</button>
              <button type="button" class="btn btn-outline btn-sm" id="btn-svg">SVG</button>
              <button type="button" class="btn btn-primary btn-sm" id="btn-png">PNG</button>
            </div>
          </div>
        </div>

        <!-- Hoja de impresión: oculta salvo al imprimir. -->
        <div class="pnl-hoja" id="hoja">
          <img src="/assets/imagenes/logos/logo_inacons.svg" alt="INACONS" class="pnl-hoja-logo" width="200" height="52" />
          <h1 id="hoja-titulo"></h1>
          <div class="pnl-hoja-qr qr-lienzo" id="hoja-qr" style="--qr-lado: 90mm"></div>
          <p class="pnl-hoja-url" id="hoja-url"></p>
          <p class="pnl-hoja-nota">Escanea el código o escribe la dirección en tu navegador.</p>
        </div>
      </>
    )}

  </div>

  <script>
    import { getSupabase, getSupabaseAnonimo, TABLAS } from '../../lib/supabase';
    import { generarQR, pngDeUrl, urlDeCodigo, urlLegible, metadatosGeneracion, PERFILES, type PerfilQR } from '../../lib/qr';

    const vistaLogin  = document.getElementById('vista-login');
    const vistaSesion = document.getElementById('vista-sesion');

    if (vistaLogin && vistaSesion) {
      const supabase = getSupabase();

      const $ = (id: string) => document.getElementById(id)!;

      // ── Sesión ───────────────────────────────────────────────────────────
      const formLogin  = $('form-login') as HTMLFormElement;
      const btnEntrar  = $('btn-entrar') as HTMLButtonElement;
      const loginError = $('login-error');
      const avisoAdmin = $('aviso-admin');

      let esAdmin = false;

      async function comprobarAdmin() {
        const { data, error } = await supabase.rpc('es_admin');
        esAdmin = data === true;

        if (error) {
          avisoAdmin.className = 'notice notice--error';
          avisoAdmin.textContent = `No se pudo comprobar el acceso: ${error.message}`;
        } else if (esAdmin) {
          avisoAdmin.hidden = true;
          return;
        } else {
          avisoAdmin.className = 'notice notice--error';
          avisoAdmin.textContent =
            'Hay sesión, pero este usuario NO está en la tabla administradores: ' +
            'toda consulta va a devolver cero filas.';
        }
        avisoAdmin.hidden = false;
      }

      function mostrar(sesion: { user: { email?: string } } | null) {
        vistaLogin!.hidden  = Boolean(sesion);
        vistaSesion!.hidden = !sesion;
        if (sesion) {
          $('sesion-correo').textContent = sesion.user.email ?? '—';
          comprobarAdmin().then(cargarCodigos);
        }
      }

      supabase.auth.getSession().then(({ data }) => mostrar(data.session));
      supabase.auth.onAuthStateChange((_e, sesion) => mostrar(sesion));

      formLogin.addEventListener('submit', async (e) => {
        e.preventDefault();
        loginError.hidden = true;
        btnEntrar.disabled = true;
        btnEntrar.textContent = 'Entrando…';

        const { error } = await supabase.auth.signInWithPassword({
          email: ($('correo') as HTMLInputElement).value.trim(),
          password: ($('clave') as HTMLInputElement).value,
        });

        if (error) {
          // Mensaje único: decir cuál de los dos falló le confirma a quien
          // prueba correos si una cuenta existe.
          loginError.textContent = error.message === 'Invalid login credentials'
            ? 'Correo o contraseña incorrectos.'
            : `No se pudo entrar: ${error.message}`;
          loginError.hidden = false;
        }

        btnEntrar.disabled = false;
        btnEntrar.textContent = 'Entrar';
      });

      $('btn-salir').addEventListener('click', () => supabase.auth.signOut());

      // ── Prueba de aislamiento (RLS) ────────────────────────────────────────
      //
      // Con un cliente SIN sesión, distinto del de este panel, para no arrastrar
      // el token de quien está logueado. Por cada tabla se pide una fila con
      // `head: true`: la cabecera dice si la fila existe sin que el cuerpo de la
      // respuesta la traiga — así, si una política queda mal escrita y el error
      // no aparece, esta prueba tampoco descarga los datos reales que expuso.
      //
      // Con RLS activo y cero políticas, Postgres niega TODO comando sobre esa
      // tabla, no solo el que se prueba: bloquear el SELECT ya certifica que
      // INSERT/UPDATE/DELETE están igual de cerrados. Por eso alcanza con leer.
      $('btn-rls').addEventListener('click', async () => {
        const btn = $('btn-rls') as HTMLButtonElement;
        const lista = $('rls-resultados');
        btn.disabled = true;
        lista.hidden = false;
        lista.innerHTML = '<li><span class="data-key">Probando…</span></li>';

        const anon = getSupabaseAnonimo();
        const filas: string[] = [];

        for (const tabla of TABLAS) {
          try {
            const { error, count } = await anon
              .from(tabla)
              .select('*', { count: 'exact', head: true });

            filas.push(
              error
                ? `<li><span class="data-key">${tabla}</span><span class="data-value status-ok">Bloqueada ✓</span></li>`
                : `<li><span class="data-key">${tabla}</span><span class="data-value status-error">¡Expuesta! (${count ?? '?'} fila(s) visibles)</span></li>`
            );
          } catch {
            filas.push(
              `<li><span class="data-key">${tabla}</span><span class="data-value status-warn">No se pudo probar</span></li>`
            );
          }
        }

        lista.innerHTML = filas.join('');
        btn.disabled = false;
      });

      // ── Diálogos ─────────────────────────────────────────────────────────
      let ultimoFoco: HTMLElement | null = null;

      function abrirDialogo(id: string) {
        ultimoFoco = document.activeElement as HTMLElement;
        $(id).hidden = false;
        document.body.style.overflow = 'hidden';
        ($(id).querySelector('input, select, button') as HTMLElement | null)?.focus();
      }

      function cerrarDialogo(id: string) {
        $(id).hidden = true;
        document.body.style.overflow = '';
        ultimoFoco?.focus();
      }

      document.querySelectorAll('[data-cerrar]').forEach((b) =>
        b.addEventListener('click', () => cerrarDialogo(b.getAttribute('data-cerrar')!))
      );

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        document.querySelectorAll('.dialogo:not([hidden])').forEach((d) => cerrarDialogo(d.id));
      });

      // ── Listado ──────────────────────────────────────────────────────────
      type Codigo = {
        codigo: string; tipo: string; destino_url: string | null;
        activo: boolean; en_material_impreso: boolean;
        escaneos_previos: number; notas: string | null;
      };

      let codigos: Codigo[] = [];
      const escaneos = new Map<string, number>();

      const avisoCodigos = $('aviso-codigos');

      function avisar(clase: string, texto: string) {
        avisoCodigos.className = `notice ${clase}`;
        avisoCodigos.textContent = texto;
        avisoCodigos.hidden = false;
      }

      async function cargarCodigos() {
        if (!esAdmin) return;

        const [resCodigos, resDiarios] = await Promise.all([
          supabase.from('qr_codes').select('*').order('codigo'),
          supabase.from('escaneos_diarios').select('qr_codigo, total'),
        ]);

        if (resCodigos.error) {
          avisar('notice--error', `No se pudieron leer los códigos: ${resCodigos.error.message}`);
          return;
        }

        codigos = (resCodigos.data ?? []) as Codigo[];

        escaneos.clear();
        for (const f of resDiarios.data ?? []) {
          escaneos.set(f.qr_codigo, (escaneos.get(f.qr_codigo) ?? 0) + f.total);
        }

        pintarTabla();
      }

      function totalEscaneos(c: Codigo) {
        return (c.escaneos_previos ?? 0) + (escaneos.get(c.codigo) ?? 0);
      }

      function pintarTabla() {
        const cuerpo = $('tabla-codigos');

        if (codigos.length === 0) {
          cuerpo.innerHTML = '<tr><td colspan="6" class="tabla-vacia">Todavía no hay códigos.</td></tr>';
          $('resumen-codigos').textContent = 'Ninguno todavía.';
          return;
        }

        const activos = codigos.filter((c) => c.activo).length;
        $('resumen-codigos').textContent =
          `${codigos.length} en total, ${activos} activo(s). ` +
          `Los escaneos se agregan cada madrugada; "Actualizar escaneos" los recalcula ahora.`;

        cuerpo.innerHTML = codigos.map((c) => {
          const impreso = c.en_material_impreso
            ? '<span class="status-warn" title="Hay material impreso circulando">· impreso</span>'
            : '';
          return `
            <tr>
              <td class="tabla-codigo">${esc(c.codigo)}${impreso}</td>
              <td>${esc(c.tipo)}</td>
              <td class="tabla-url" title="${esc(c.destino_url ?? '')}">${esc(c.destino_url ?? '—')}</td>
              <td>${c.activo ? '<span class="status-ok">Activo</span>' : '<span class="status-off">Dado de baja</span>'}</td>
              <td class="tabla-num">${totalEscaneos(c)}</td>
              <td>
                <div class="tabla-acciones">
                  <button type="button" class="btn btn-outline btn-sm" data-qr="${esc(c.codigo)}">QR</button>
                  <button type="button" class="btn btn-outline btn-sm" data-editar="${esc(c.codigo)}">Editar</button>
                  <button type="button" class="btn btn-outline btn-sm" data-estado="${esc(c.codigo)}">${c.activo ? 'Dar de baja' : 'Reactivar'}</button>
                </div>
              </td>
            </tr>`;
        }).join('');

        cuerpo.querySelectorAll('[data-qr]').forEach((b) =>
          b.addEventListener('click', () => abrirQR(b.getAttribute('data-qr')!)));
        cuerpo.querySelectorAll('[data-editar]').forEach((b) =>
          b.addEventListener('click', () => abrirCodigo(b.getAttribute('data-editar')!)));
        cuerpo.querySelectorAll('[data-estado]').forEach((b) =>
          b.addEventListener('click', () => alternarEstado(b.getAttribute('data-estado')!)));
      }

      const esc = (t: string) =>
        t.replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]!));

      // ── Alta y edición ───────────────────────────────────────────────────
      let editando: Codigo | null = null;

      function abrirCodigo(codigo?: string) {
        editando = codigo ? codigos.find((c) => c.codigo === codigo) ?? null : null;
        $('dlg-codigo-error').hidden = true;

        const campoCodigo = $('f-codigo') as HTMLInputElement;
        campoCodigo.value = editando?.codigo ?? '';
        campoCodigo.readOnly = Boolean(editando);
        $('grupo-codigo').hidden = false;

        ($('f-tipo') as HTMLSelectElement).value = editando?.tipo ?? 'url';
        ($('f-impreso') as HTMLSelectElement).value = String(editando?.en_material_impreso ?? false);
        ($('f-destino') as HTMLInputElement).value = editando?.destino_url ?? '';
        ($('f-notas') as HTMLInputElement).value = editando?.notas ?? '';
        ($('f-motivo') as HTMLInputElement).value = '';

        // El motivo solo tiene sentido al cambiar un destino que ya existía.
        $('grupo-motivo').hidden = !editando;

        $('dlg-codigo-titulo').textContent = editando ? `Editar ${editando.codigo}` : 'Nuevo código';
        $('dlg-codigo-desc').textContent = editando
          ? (editando.en_material_impreso
              ? 'Este código está en material impreso: cambiar el destino afecta papel que ya circula y no se puede actualizar.'
              : 'El código no se puede cambiar. Para un código distinto, crea uno nuevo.')
          : 'Un código legible se puede teclear si el QR no escanea. Uno opaco no revela a dónde lleva.';

        abrirDialogo('dlg-codigo');
      }

      $('btn-nuevo').addEventListener('click', () => abrirCodigo());

      $('btn-generar').addEventListener('click', async () => {
        const { data, error } = await supabase.rpc('generar_codigo_opaco', { p_largo: 5 });
        if (error) {
          $('dlg-codigo-error').textContent = `No se pudo generar: ${error.message}`;
          $('dlg-codigo-error').hidden = false;
          return;
        }
        ($('f-codigo') as HTMLInputElement).value = data as string;
      });

      ($('form-codigo') as HTMLFormElement).addEventListener('submit', async (e) => {
        e.preventDefault();
        const error = $('dlg-codigo-error');
        error.hidden = true;

        const btn = $('btn-guardar') as HTMLButtonElement;
        btn.disabled = true;

        const codigo  = ($('f-codigo') as HTMLInputElement).value.trim().toUpperCase();
        const destino = ($('f-destino') as HTMLInputElement).value.trim();
        const motivo  = ($('f-motivo') as HTMLInputElement).value.trim();

        try {
          if (!editando) {
            if (!/^[A-Z0-9_-]{2,24}$/.test(codigo)) {
              throw new Error('El código admite letras, números, guión y guión bajo, entre 2 y 24 caracteres.');
            }
            const { error: err } = await supabase.from('qr_codes').insert({
              codigo,
              tipo: ($('f-tipo') as HTMLSelectElement).value,
              destino_url: destino,
              en_material_impreso: ($('f-impreso') as HTMLSelectElement).value === 'true',
              notas: ($('f-notas') as HTMLInputElement).value.trim() || null,
            });
            if (err) throw new Error(traducir(err.message));
          } else {
            // El destino pasa por reasignar_qr: es lo que garantiza que el
            // motivo quede en la auditoría, en la misma transacción.
            if (destino !== editando.destino_url) {
              const { error: err } = await supabase.rpc('reasignar_qr', {
                p_codigo: editando.codigo, p_destino: destino, p_motivo: motivo || null,
              });
              if (err) throw new Error(traducir(err.message));
            }
            const { error: err2 } = await supabase.from('qr_codes').update({
              tipo: ($('f-tipo') as HTMLSelectElement).value,
              en_material_impreso: ($('f-impreso') as HTMLSelectElement).value === 'true',
              notas: ($('f-notas') as HTMLInputElement).value.trim() || null,
            }).eq('codigo', editando.codigo);
            if (err2) throw new Error(traducir(err2.message));
          }

          cerrarDialogo('dlg-codigo');
          await cargarCodigos();
          avisar('notice--ok', editando ? `${codigo} actualizado.` : `${codigo} creado.`);
        } catch (ex) {
          error.textContent = (ex as Error).message;
          error.hidden = false;
        } finally {
          btn.disabled = false;
        }
      });

      /* Los mensajes de Postgres son precisos y no dicen nada al que los lee. */
      function traducir(mensaje: string): string {
        if (mensaje.includes('qr_codes_codigo_check'))
          return 'El código solo admite letras, números, guión y guión bajo.';
        if (mensaje.includes('qr_codes_forma_normalizada') || mensaje.includes('duplicate key'))
          return 'Ya existe un código igual (el guión y el guión bajo cuentan como el mismo).';
        if (mensaje.includes('qr_destino_presente'))
          return 'Hace falta un destino.';
        return mensaje;
      }

      async function alternarEstado(codigo: string) {
        const c = codigos.find((x) => x.codigo === codigo);
        if (!c) return;

        if (c.activo && c.en_material_impreso &&
            !confirm(`${codigo} está en material impreso. Darlo de baja deja ese papel sin destino. ¿Continuar?`)) {
          return;
        }

        const { error } = await supabase.from('qr_codes').update({ activo: !c.activo }).eq('codigo', codigo);
        if (error) { avisar('notice--error', error.message); return; }

        await cargarCodigos();
        avisar('notice--ok', `${codigo} ${c.activo ? 'dado de baja' : 'reactivado'}.`);
      }

      $('btn-refrescar-stats').addEventListener('click', async () => {
        const btn = $('btn-refrescar-stats') as HTMLButtonElement;
        btn.disabled = true;
        const { error } = await supabase.rpc('agregar_escaneos_diarios', { p_dias_atras: 30 });
        if (error) avisar('notice--error', error.message);
        else { await cargarCodigos(); avisar('notice--ok', 'Escaneos recalculados.'); }
        btn.disabled = false;
      });

      // ── QR ───────────────────────────────────────────────────────────────
      let qrCodigo = '';

      async function pintarQR() {
        const perfil = ($('f-perfil') as HTMLSelectElement).value as PerfilQR;
        const url = urlDeCodigo(qrCodigo);

        $('hint-perfil').textContent = PERFILES[perfil].consejo;

        // Se codifica `url` (mayúsculas, símbolo más chico) y se enseña la
        // legible. Las dos llevan al mismo sitio.
        $('qr-url').textContent = urlLegible(qrCodigo);
        $('qr-destino').textContent =
          codigos.find((c) => c.codigo === qrCodigo)?.destino_url ?? '—';

        const r = await generarQR(url, { perfil });
        $('qr-vista').innerHTML = r.svg;
        $('qr-datos').textContent =
          `${r.modulos}×${r.modulos} módulos · ECC ${r.ecc} · no imprimir a menos de ${r.mmMinimos} mm`;

        $('hoja-titulo').textContent = qrCodigo;
        $('hoja-qr').innerHTML = r.svg;
        $('hoja-url').textContent = urlLegible(qrCodigo);
      }

      async function abrirQR(codigo: string) {
        qrCodigo = codigo;
        $('dlg-qr-titulo').textContent = `QR de ${codigo}`;
        await pintarQR();
        abrirDialogo('dlg-qr');
      }

      ($('f-perfil') as HTMLSelectElement).addEventListener('change', pintarQR);

      function descargar(blob: Blob, nombre: string) {
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = nombre;
        a.click();
        URL.revokeObjectURL(a.href);
      }

      /**
       * Deja constancia de con qué parámetros salió el QR que se acaba de
       * exportar o imprimir. Existe para que no se repita lo del PNG de
       * Expomina: generado con una herramienta externa, sin rastro de su
       * configuración, y hoy nadie puede regenerarlo igual.
       *
       * Best-effort: si falla, no debe impedir la descarga que el
       * administrador ya tiene en la mano. Se registra en segundo plano.
       */
      function registrarGeneracion(perfil: PerfilQR) {
        supabase
          .from('qr_codes')
          .update(metadatosGeneracion(perfil))
          .eq('codigo', qrCodigo)
          .then(({ error }) => {
            if (error) console.warn(`No se pudo registrar la generación de ${qrCodigo}:`, error.message);
          });
      }

      $('btn-svg').addEventListener('click', async () => {
        const perfil = ($('f-perfil') as HTMLSelectElement).value as PerfilQR;
        const r = await generarQR(urlDeCodigo(qrCodigo), { perfil });
        descargar(new Blob([r.svg], { type: 'image/svg+xml' }), `qr-${qrCodigo.toLowerCase()}.svg`);
        registrarGeneracion(perfil);
      });

      $('btn-png').addEventListener('click', async () => {
        const btn = $('btn-png') as HTMLButtonElement;
        btn.disabled = true;
        try {
          const perfil = ($('f-perfil') as HTMLSelectElement).value as PerfilQR;
          const r = await pngDeUrl(urlDeCodigo(qrCodigo), { perfil }, 1200);
          descargar(r.blob, `qr-${qrCodigo.toLowerCase()}-${r.lado}px.png`);
          registrarGeneracion(perfil);
        } finally {
          btn.disabled = false;
        }
      });

      $('btn-hoja').addEventListener('click', () => {
        registrarGeneracion(($('f-perfil') as HTMLSelectElement).value as PerfilQR);
        window.print();
      });
    }
  </script>

</BaseLayout>
