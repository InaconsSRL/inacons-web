---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import Icono from '../components/Icono.astro';
import type { NombreIcono } from '../lib/iconos';
import imagenHero from '../assets/imagenes/home_about.webp';

const certificaciones = (await getCollection('certificaciones'))
  .sort((a, b) => (a.data.orden ?? 99) - (b.data.orden ?? 99));

// El icono es markup, no contenido: no viaja en el .md, que describe la norma y
// no como se dibuja. La norma elige el simbolo, y hay uno detras por defecto
// para que una norma nueva salga pintada aunque nadie le haya elegido icono.
const ICONO_POR_NORMA: Record<string, NombreIcono> = {
  'ISO 9001':  'premio',
  'ISO 14001': 'hoja',
  'ISO 45001': 'escudo-check',
  'ISO 37001': 'balanza',
};
const ICONO_POR_DEFECTO: NombreIcono = 'premio';
---

<BaseLayout title="Documentos | INACONS" description="Certificaciones ISO y documentos corporativos de INACONS — transparencia y compromiso con la calidad">

  <style slot="head">
    /* Intro de sección */
    .docs-intro {
      max-width: 640px;
      margin-bottom: var(--sp-l2);
    }
    .docs-intro p {
      font-size: var(--fs-md);
      color: var(--c-text-muted);
      line-height: 1.85;
    }

    /* Cards */
    .cert-grid .feature-item:nth-child(4) { grid-column: 1; }
    .cert-grid .feature-item:nth-child(5) { grid-column: 2; }

    /* Banda de normas */
    .norms-band {
      display: flex; justify-content: center; flex-wrap: wrap; gap: 0;
      margin-top: var(--sp-l2);
      border: 1px solid var(--c-border-light); border-radius: var(--radius); overflow: hidden;
    }
    .norm-item {
      flex: 1; min-width: 160px;
      display: flex; flex-direction: column; align-items: center;
      padding: var(--sp-6) var(--sp-5);
      border-right: 1px solid var(--c-border-light);
      text-align: center; transition: background var(--t);
    }
    .norm-item:last-child { border-right: none; }
    .norm-item:hover { background: color-mix(in srgb, var(--c-secondary) 4%, transparent); }

    /* Responsive */
    @media (max-width: 767.98px) {
      .cert-grid .feature-item:nth-child(4),
      .cert-grid .feature-item:nth-child(5) { grid-column: 1; }
      .norms-band { flex-direction: column; }
      .norm-item { border-right: none; border-bottom: 1px solid var(--c-border-light); }
      .norm-item:last-child { border-bottom: none; }
    }
    @media (min-width: 768px) and (max-width: 1023.98px) {
      .cert-grid .feature-item:nth-child(4),
      .cert-grid .feature-item:nth-child(5) { grid-column: auto; }
    }
  </style>

  <!-- HERO -->
  <PageHero
    image={imagenHero}
    title="Transparencia en<br>cada proceso"
    subtitle="Certificaciones y políticas que respaldan nuestra forma de trabajar"
    current="Documentos"
    bgPosition="center top"
  />

  <!-- CONTENIDO CON PESTAÑAS -->
  <section class="sec sec--white">
    <div class="container">

      <!-- Intro -->
      <div class="docs-intro" data-aos="fade-up">
        <div class="sh">
          <p class="sh-label">Gestión y Calidad</p>
          <h2 class="sh-title">Nuestro Sistema Integrado</h2>
        </div>
        <p>Nuestros clientes operan en sectores donde el cumplimiento no es negociable: minería, inmobiliaria, energía, saneamiento. Por eso, desde 2020 sostenemos certificación continua en las cuatro normas ISO, auditadas de forma independiente e integradas en nuestro Sistema Integrado de Gestión. No solo presentamos certificados: presentamos evidencia de cómo trabajamos, proyecto por proyecto.</p>
      </div>

      <!-- Pestañas -->
      <div class="tabs" role="tablist" aria-label="Tipo de documento" data-aos="fade-up">
        <button type="button" class="tab" role="tab" id="tabbtn-certificaciones" aria-selected="true" aria-controls="tab-certificaciones">
          Certificaciones ISO
        </button>
        <button type="button" class="tab" role="tab" id="tabbtn-politicas" aria-selected="false" aria-controls="tab-politicas" tabindex="-1">
          Políticas Corporativas
        </button>
      </div>

      <!-- Panel: Certificaciones -->
      <div id="tab-certificaciones" role="tabpanel" aria-labelledby="tabbtn-certificaciones">
        <div class="cert-grid grid-3">
          {/*
            Las normas salen de src/content/certificaciones/ (regla 3).

            El retardo de la animacion se calcula por posicion. La tarjeta de
            INCE-489, que va debajo, sigue escrita a mano y cierra la serie con
            400: no es una norma ISO ni esta en la coleccion.
          */}
          {certificaciones.map((c, i) => (
            <a href={c.data.certificado} target="_blank" class="feature-item feature-item--card feature-item--accion" data-aos="fade-up" data-aos-delay={String((i + 1) * 80)}>
              <span class="feature-num feature-num--marca" aria-hidden="true">{c.data.norma.replace('ISO ', '')}</span>
              <div class="feature-icon"><Icono nombre={ICONO_POR_NORMA[c.data.norma] ?? ICONO_POR_DEFECTO} tam={24} /></div>
              <p class="panel-label">{c.data.norma}</p>
              <h3 class="feature-title">{c.data.encabezado ?? c.data.titulo}</h3>
              <p class="feature-desc">{c.data.descripcion}</p>
              <span class="btn btn-outline btn-sm">
                <Icono nombre="descarga" tam={14} /> Descargar
              </span>
            </a>
          ))}
          <a href="/assets/documentos/certificado_ince_489.pdf" target="_blank" class="feature-item feature-item--card feature-item--accion" data-aos="fade-up" data-aos-delay="400">
            <span class="feature-num feature-num--marca" aria-hidden="true">INCE</span>
            <div class="feature-icon"><Icono nombre="insignia-check" tam={24} /></div>
            <p class="panel-label">INCE-489</p>
            <h3 class="feature-title">Certificado de Capacidad Técnica</h3>
            <p class="feature-desc">Acredita nuestra capacidad técnica y experiencia comprobada en la ejecución de proyectos.</p>
            <span class="btn btn-outline btn-sm">
              <Icono nombre="descarga" tam={14} /> Descargar
            </span>
          </a>
        </div>
        <div class="norms-band" data-aos="fade-up">
          {certificaciones.map((c) => (
            <div class="card--stat card--stat-sm norm-item"><span class="stat-num">{c.data.norma}</span><span class="stat-label">{c.data.etiqueta ?? c.data.titulo}</span></div>
          ))}
          <div class="card--stat card--stat-sm norm-item"><span class="stat-num">INCE-489</span><span class="stat-label">Cap. Técnica</span></div>
        </div>
      </div>

      <!-- Panel: Políticas -->
      <div id="tab-politicas" role="tabpanel" hidden aria-labelledby="tabbtn-politicas">
        <div class="cert-grid grid-3">
          <a href="/assets/documentos/politica_alcohol_drogas.pdf" target="_blank" class="feature-item feature-item--card feature-item--accion">
            <span class="feature-num feature-num--marca" aria-hidden="true">PDF</span>
            <div class="feature-icon"><Icono nombre="escudo-alerta" tam={24} /></div>
            <p class="panel-label">Política</p>
            <h3 class="feature-title">Alcohol y Drogas</h3>
            <p class="feature-desc">Normativa sobre prevención y control del consumo de sustancias en el entorno de trabajo.</p>
            <span class="btn btn-outline btn-sm">
              <Icono nombre="descarga" tam={14} /> Ver documento
            </span>
          </a>
          <a href="/assets/documentos/politica_negativa_trabajo_inseguro.pdf" target="_blank" class="feature-item feature-item--card feature-item--accion">
            <span class="feature-num feature-num--marca" aria-hidden="true">PDF</span>
            <div class="feature-icon"><Icono nombre="escudo-aspa" tam={24} /></div>
            <p class="panel-label">Política</p>
            <h3 class="feature-title">Negativa al Trabajo Inseguro</h3>
            <p class="feature-desc">Derecho de los trabajadores a rechazar actividades que pongan en riesgo su seguridad.</p>
            <span class="btn btn-outline btn-sm">
              <Icono nombre="descarga" tam={14} /> Ver documento
            </span>
          </a>
          <a href="/assets/documentos/politica_sig.pdf" target="_blank" class="feature-item feature-item--card feature-item--accion">
            <span class="feature-num feature-num--marca" aria-hidden="true">PDF</span>
            <div class="feature-icon"><Icono nombre="ajustes" tam={24} /></div>
            <p class="panel-label">Política</p>
            <h3 class="feature-title">Sistema Integrado de Gestión</h3>
            <p class="feature-desc">Política del Sistema Integrado de Gestión de Calidad, Medio Ambiente y Seguridad.</p>
            <span class="btn btn-outline btn-sm">
              <Icono nombre="descarga" tam={14} /> Ver documento
            </span>
          </a>
          <a href="/assets/documentos/politica_antisoborno.pdf" target="_blank" class="feature-item feature-item--card feature-item--accion">
            <span class="feature-num feature-num--marca" aria-hidden="true">PDF</span>
            <div class="feature-icon"><Icono nombre="mano" tam={24} />
            </div>
            <p class="panel-label">Política</p>
            <h3 class="feature-title">Antisoborno</h3>
            <p class="feature-desc">Compromiso con la integridad y prevención de prácticas corruptas en todas las operaciones.</p>
            <span class="btn btn-outline btn-sm">
              <Icono nombre="descarga" tam={14} /> Ver documento
            </span>
          </a>
          <a href="/assets/documentos/otros_alcance_sig.pdf" target="_blank" class="feature-item feature-item--card feature-item--accion">
            <span class="feature-num feature-num--marca" aria-hidden="true">PDF</span>
            <div class="feature-icon"><Icono nombre="documento-texto" tam={24} /></div>
            <p class="panel-label">Documento</p>
            <h3 class="feature-title">Alcance del SIG</h3>
            <p class="feature-desc">Documentación complementaria sobre el alcance de nuestro Sistema Integrado de Gestión.</p>
            <span class="btn btn-outline btn-sm">
              <Icono nombre="descarga" tam={14} /> Ver documento
            </span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <CtaBand
    label="¿Falta algún documento?"
    title="Te enviamos lo que necesites para tu expediente"
    description="Certificados, pólizas y constancias para procesos de homologación o licitación."
    primaryHref="/contacto/"
    primaryLabel="Solicitar documento"
  />

</BaseLayout>
