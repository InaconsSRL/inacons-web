---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Documentos | INACONS" description="Certificaciones ISO y documentos corporativos de INACONS — transparencia y compromiso con la calidad">

  <style slot="head">
    /* Pestañas */
    .tabs-wrap {
      display: flex;
      gap: 0;
      border-bottom: 2px solid var(--c-border-light);
      margin-bottom: var(--sp-l2);
    }
    .tab-btn {
      padding: var(--sp-4) var(--sp-7);
      font-family: 'Montserrat', sans-serif;
      font-size: var(--fs-sm);
      font-weight: var(--fw-semibold);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--c-text-muted);
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      margin-bottom: -2px;
      cursor: pointer;
      transition: color .2s, border-color .2s;
    }
    .tab-btn:hover { color: var(--c-text-heading); }
    .tab-btn.active {
      color: var(--c-secondary);
      border-bottom-color: var(--c-secondary);
    }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    /* Intro de sección */
    .docs-intro {
      max-width: 640px;
      margin-bottom: var(--sp-l2);
    }
    .docs-intro p {
      font-size: var(--fs-md);
      color: var(--c-text-muted);
      line-height: 1.85;
    }

    /* Cards */
    .cert-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-1); }
    .cert-grid .feature-item:nth-child(4) { grid-column: 1; }
    .cert-grid .feature-item:nth-child(5) { grid-column: 2; }

    /* Banda de normas */
    .norms-band {
      display: flex; justify-content: center; flex-wrap: wrap; gap: 0;
      margin-top: var(--sp-l2);
      border: 1px solid var(--c-border-light); border-radius: 2px; overflow: hidden;
    }
    .norm-item {
      flex: 1; min-width: 160px;
      display: flex; flex-direction: column; align-items: center;
      padding: var(--sp-6) var(--sp-5);
      border-right: 1px solid var(--c-border-light);
      text-align: center; transition: background .22s;
    }
    .norm-item:last-child { border-right: none; }
    .norm-item:hover { background: rgba(27,82,120,0.04); }

    /* Responsive */
    @media (max-width: 767.98px) {
      .cert-grid { grid-template-columns: 1fr; }
      .cert-grid .feature-item:nth-child(4),
      .cert-grid .feature-item:nth-child(5) { grid-column: 1; }
      .norms-band { flex-direction: column; }
      .norm-item { border-right: none; border-bottom: 1px solid var(--c-border-light); }
      .norm-item:last-child { border-bottom: none; }
      .tab-btn { padding: var(--sp-3) var(--sp-4); font-size: var(--fs-xs); }
    }
    @media (min-width: 768px) and (max-width: 1023.98px) {
      .cert-grid { grid-template-columns: repeat(2, 1fr); }
      .cert-grid .feature-item:nth-child(4),
      .cert-grid .feature-item:nth-child(5) { grid-column: auto; }
    }
  </style>

  <!-- HERO -->
  <PageHero
    image="/assets/imagenes/home_about.webp"
    title="Transparencia en<br>cada proceso"
    subtitle="Certificaciones y políticas que respaldan nuestra forma de trabajar"
    current="Documentos"
    bgPosition="center top"
  />

  <!-- CONTENIDO CON PESTAÑAS -->
  <section class="sec sec--white">
    <div class="container">

      <!-- Intro -->
      <div class="docs-intro" data-aos="fade-up">
        <div class="sh">
          <p class="sh-label">Gestión y Calidad</p>
          <h2 class="sh-title">Nuestro Sistema Integrado</h2>
        </div>
        <p>INACONS opera bajo un Sistema Integrado de Gestión que articula calidad, medio ambiente, seguridad y anticorrupción en cada proyecto. Aquí encontrarás los certificados que acreditan nuestros estándares y los documentos corporativos que rigen nuestra conducta.</p>
      </div>

      <!-- Pestañas -->
      <div class="tabs-wrap" data-aos="fade-up">
        <button class="tab-btn active" data-tab="certificaciones">
          Certificaciones ISO
        </button>
        <button class="tab-btn" data-tab="politicas">
          Políticas Corporativas
        </button>
      </div>

      <!-- Panel: Certificaciones -->
      <div class="tab-panel active" id="tab-certificaciones">
        <div class="cert-grid">
          <a href="/assets/documentos/inacons_9001.pdf" target="_blank" class="feature-item feature-item--card feature-item--accion" data-aos="fade-up" data-aos-delay="80">
            <span class="feature-num feature-num--marca" aria-hidden="true">9001</span>
            <div class="feature-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg></div>
            <p class="panel-label">ISO 9001</p>
            <h3 class="feature-title">Sistema de Gestión de Calidad</h3>
            <p class="feature-desc">Garantiza la satisfacción del cliente y la mejora continua de nuestros procesos en todos los proyectos.</p>
            <span class="btn btn-outline btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="3" y2="15"/></svg> Descargar
            </span>
          </a>
          <a href="/assets/documentos/inacons_14001.pdf" target="_blank" class="feature-item feature-item--card feature-item--accion" data-aos="fade-up" data-aos-delay="160">
            <span class="feature-num feature-num--marca" aria-hidden="true">14001</span>
            <div class="feature-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg></div>
            <p class="panel-label">ISO 14001</p>
            <h3 class="feature-title">Sistema de Gestión Ambiental</h3>
            <p class="feature-desc">Demuestra nuestro compromiso con la protección del medio ambiente y el desarrollo sostenible.</p>
            <span class="btn btn-outline btn-sm">
