            </span>
          </a>
          <a href="/assets/documentos/certificado_ince_489.pdf" target="_blank" class="feature-item feature-item--card feature-item--accion" data-aos="fade-up" data-aos-delay="400">
            <span class="feature-num feature-num--marca" aria-hidden="true">INCE</span>
            <div class="feature-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/></svg></div>
