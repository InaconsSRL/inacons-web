            <h3 class="feature-title">Antisoborno</h3>
            <p class="feature-desc">Compromiso con la integridad y prevención de prácticas corruptas en todas las operaciones.</p>
            <span class="btn btn-outline btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="3" y2="15"/></svg> Ver documento
            </span>
          </a>
          <a href="/assets/documentos/otros_alcance_sig.pdf" target="_blank" class="feature-item feature-item--card feature-item--accion">
            <span class="feature-num feature-num--marca" aria-hidden="true">PDF</span>
            <div class="feature-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg></div>
            <p class="panel-label">Documento</p>
            <h3 class="feature-title">Alcance del SIG</h3>
            <p class="feature-desc">Documentación complementaria sobre el alcance de nuestro Sistema Integrado de Gestión.</p>
            <span class="btn btn-outline btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="3" y2="15"/></svg> Ver documento
            </span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <CtaBand
    label="¿Falta algún documento?"
    title="Te enviamos lo que necesites para tu expediente"
    description="Certificados, pólizas y constancias para procesos de homologación o licitación."
    primaryHref="/contacto/"
    primaryLabel="Solicitar documento"
  />

</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const btns = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');

    btns.forEach(btn => {
      btn.addEventListener('click', function () {
        const target = this.getAttribute('data-tab');

        btns.forEach(b => b.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));

        this.classList.add('active');
        document.getElementById('tab-' + target).classList.add('active');

        // Reinicializar Lucide por si los íconos del panel no estaban visibles
        if (typeof lucide !== 'undefined') lucide.createIcons();
      });
    });
  });
</script>