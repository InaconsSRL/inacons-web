---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Nosotros | INACONS"
  description="Conoce más sobre INACONS: nuestra misión, visión y los valores que nos han consolidado como líderes en construcción e ingeniería durante más de 15 años."
>

  <PageHero
    image="/assets/imagenes/image_nosotros.webp"
    title="Comprometidos con la<br>Excelencia en Construcción"
    subtitle="Más de 15 años construyendo confianza en el Perú"
    current="Nosotros"
  />

  <!-- QUIÉNES SOMOS -->
  <section class="sec sec--white">
    <div class="container">
      <div class="about-intro-grid">
        <div data-aos="fade-right">
          <div class="sh">
            <p class="sh-label">Quiénes Somos</p>
            <h2 class="sh-title">Una empresa construida sobre confianza y resultados</h2>
          </div>
          <p class="body-text">
            Somos INACONS, una empresa con más de 15 años de experiencia en ingeniería y construcción en el Perú. Desarrollamos proyectos de alta complejidad con los más altos estándares de calidad, seguridad y sostenibilidad.
          </p>
          <p class="body-text" style="margin-bottom:36px;">
            Nuestro equipo multidisciplinario, conformado por más de 200 profesionales, nos permite ofrecer soluciones especializadas y cumplir con nuestra misión: transformar espacios y construir confianza en cada proyecto.
          </p>
          <!-- data-counter y data-suffix son leídos por main.js -->
          <div class="about-stat-row">
            <div class="about-stat">
              <strong data-counter="15" data-suffix="+">0+</strong>
              <span>Años de experiencia</span>
            </div>
            <div class="about-stat">
              <strong data-counter="200" data-suffix="+">0+</strong>
              <span>Profesionales</span>
            </div>
            <div class="about-stat">
              <strong data-counter="150" data-suffix="+">0+</strong>
              <span>Proyectos ejecutados</span>
            </div>
          </div>
          <a href="/contacto" class="btn btn-primary" style="margin-top:36px;">
            Trabajemos juntos
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="about-intro-img" data-aos="fade-left">
          <img src="/assets/imagenes/about_section.webp" alt="Equipo INACONS en obra" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- MISIÓN / VISIÓN / VALORES -->
  <section class="sec sec--muted">
    <div class="container">
      <div class="mvv-grid">
        <div>
          <div class="sh" data-aos="fade-up">
            <p class="sh-label">Ingeniería que Construye</p>
            <h2 class="sh-title">Principios que guían cada proyecto</h2>
          </div>
          <div class="mvv-block" data-aos="fade-up" data-aos-delay="80">
            <p class="mvv-label">Misión</p>
            <h3 class="mvv-title">Generamos valor en cada obra</h3>
            <p class="mvv-desc">Desarrollar servicios de ingeniería y construcción en obras civiles, infraestructura y electromecánicas, transformando la calidad de vida y asegurando la continuidad operativa de nuestros clientes, con innovación y desarrollo responsable.</p>
          </div>
          <div class="mvv-block" data-aos="fade-up" data-aos-delay="160">
            <p class="mvv-label">Visión</p>
            <h3 class="mvv-title">Referentes en Latinoamérica</h3>
            <p class="mvv-desc">Ser reconocidos como una empresa sólida en ingeniería y construcción, con capacidad para diversificar sus servicios y consolidar su presencia en Latinoamérica para 2030.</p>
          </div>
          <div class="mvv-block" data-aos="fade-up" data-aos-delay="240">
            <p class="mvv-label">Valores</p>
            <h3 class="mvv-title">Lo que nos define como equipo</h3>
            <div class="valores-list">
              <div class="valor-item">
                <span class="valor-name">Confianza</span>
                <p class="valor-desc">El pilar de nuestras relaciones.</p>
              </div>
              <div class="valor-item">
                <span class="valor-name">Innovación</span>
                <p class="valor-desc">Evolución constante en procesos y tecnología.</p>
              </div>
              <div class="valor-item">
                <span class="valor-name">Trascender</span>
                <p class="valor-desc">Dejar un legado de calidad en cada obra.</p>
              </div>
              <div class="valor-item">
                <span class="valor-name">Lealtad</span>
                <p class="valor-desc">Compromiso recíproco a largo plazo.</p>
              </div>
              <div class="valor-item">
                <span class="valor-name">Identidad</span>
                <p class="valor-desc">Comprometerse con los objetivos de la organización, asumiéndolos como propios.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="mvv-img" data-aos="fade-left">
          <img src="/assets/imagenes/about_team.webp" alt="Equipo INACONS" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- VIDEO INSTITUCIONAL -->
  <section class="sec sec--white video-inst-sec" aria-labelledby="video-institucional-heading">
    <div class="container">
      <div class="sh sh--center sh--narrow video-inst-sh" data-aos="fade-up">
        <p class="sh-label">INACONS</p>
        <h2 id="video-institucional-heading" class="sh-title">Video institucional</h2>
      </div>
      <div class="contenedor-video" data-aos="fade-up" data-aos-delay="80">
        <iframe
          src="https://www.youtube-nocookie.com/embed/mlrYw3IldXs?modestbranding=1&rel=0"
          title="Video institucional INACONS"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- POR QUÉ INACONS -->
  <section class="sec sec--muted">
    <div class="container">
      <div class="sh sh--center sh--medium" data-aos="fade-up">
        <p class="sh-label">Lo que nos diferencia</p>
        <h2 class="sh-title">Por qué elegir INACONS</h2>
        <p class="sh-desc">Cuatro pilares que definen nuestra forma de trabajar y nos distinguen como líderes en el sector de la construcción e ingeniería.</p>
      </div>
      <div class="pillars-grid">
        <div class="pillar-card" data-aos="fade-up" data-aos-delay="80">
          <div class="pillar-num">01</div>
          <h3 class="pillar-title">Experiencia</h3>
          <p class="pillar-desc">Más de 15 años de trayectoria nos respaldan como líderes en el sector, desarrollando proyectos innovadores y sostenibles a lo largo de todo el Perú.</p>
        </div>
        <div class="pillar-card" data-aos="fade-up" data-aos-delay="160">
          <div class="pillar-num">02</div>
          <h3 class="pillar-title">Innovación y Sostenibilidad</h3>
          <p class="pillar-desc">Implementamos las últimas tecnologías y prácticas sostenibles para crear espacios que respeten el medio ambiente y mejoren la calidad de vida.</p>
        </div>
        <div class="pillar-card" data-aos="fade-up" data-aos-delay="240">
          <div class="pillar-num">03</div>
          <h3 class="pillar-title">Orientación al Cliente</h3>
          <p class="pillar-desc">Nuestro compromiso es superar las expectativas de cada cliente, brindando soluciones personalizadas y un servicio de excelencia en cada proyecto.</p>
        </div>
        <div class="pillar-card" data-aos="fade-up" data-aos-delay="320">
          <div class="pillar-num">04</div>
          <h3 class="pillar-title">Equipo Humano</h3>
          <p class="pillar-desc">Contamos con un equipo multicultural que se adapta a cualquier contexto y tiene la experiencia para enfrentar todo tipo de retos con excelencia.</p>
        </div>
      </div>
    </div>
  </section>

  <!--
    NOTA: El contador animado (data-counter) ya lo maneja main.js
    con IntersectionObserver. No necesitas el <script is:inline> que
    había antes — lo puedes eliminar.
  -->

</BaseLayout>

<style>
  .body-text {
    font-size: var(--fs-md);
    color: var(--c-text-body);
    line-height: 1.85;
    margin-bottom: 20px;
  }

  /* Quiénes somos */
  .about-intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .about-intro-img {
    position: relative;
    height: 500px;
  }

  .about-intro-img::before {
    content: '';
    position: absolute;
    top: -10px; left: -10px; right: 10px; bottom: 10px;
    border: 1.5px solid var(--c-border);
    border-radius: 2px;
    z-index: 0;
  }

  .about-intro-img img {
    position: relative; z-index: 1;
    width: 100%; height: 100%; object-fit: cover; border-radius: 2px;
  }

  .about-stat-row { display: flex; gap: 40px; margin-top: 40px; }

  .about-stat strong {
    display: block;
    font-size: var(--fs-display); font-weight: 800;
    color: var(--c-primary); letter-spacing: var(--ls-tight); line-height: 1;
  }

  .about-stat span {
    font-size: var(--fs-sm); color: var(--c-text-muted);
    font-weight: 500; text-transform: uppercase; letter-spacing: 1px;
  }

  /* Misión / Visión / Valores */
  .mvv-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: start;
  }

  .mvv-grid > div:first-child > .sh {
    margin-bottom: 28px;
  }

  .mvv-img {
    position: sticky; top: 120px;
    height: 520px; border-radius: 2px; overflow: hidden;
  }

  .mvv-img img { width: 100%; height: 100%; object-fit: cover; }

  .mvv-block {
    padding: 16px 0;
    border-top: 1px solid var(--c-border-light);
  }

  .mvv-block:first-child { border-top: none; padding-top: 0; }

  .mvv-label {
    font-size: var(--fs-2xs); font-weight: 700; letter-spacing: var(--ls-label);
    text-transform: uppercase; color: var(--c-secondary);
    margin-bottom: 6px;
  }

  .mvv-title {
    font-size: var(--fs-lg); font-weight: 700;
    color: var(--c-text-heading); margin-bottom: 8px;
  }

  .mvv-desc { font-size: var(--fs-base); color: var(--c-text-muted); line-height: 1.75; }

  .valores-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 14px;
    margin-top: 10px;
  }

  .valor-item {
    padding: 10px 12px;
    border: 1px solid var(--c-border-light);
    border-radius: 2px;
    background: var(--c-bg-white);
  }

  .valor-name {
    display: block;
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.4px;
    color: var(--c-text-heading);
    margin-bottom: 4px;
  }

  .valor-desc {
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  /* Video institucional */
  .video-inst-sec .video-inst-sh {
    margin-bottom: 28px;
  }

  .video-inst-sec .video-inst-sh .sh-title {
    margin-bottom: 0;
  }

  .contenedor-video {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    max-width: 900px;
    margin: 0 auto;
    border-radius: 2px;
    box-shadow: 0 12px 40px rgba(20, 23, 45, 0.08);
  }

  .contenedor-video iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Pilares */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3px;
    margin-top: 48px;
  }

  .pillar-card {
    padding: 40px 28px;
    background: var(--c-bg-white);
    border: 1px solid var(--c-border-light);
    position: relative;
  }

  .pillar-card::before {
    content: '';
    position: absolute; top: 0; left: 0;
    width: 100%; height: 3px;
    background: var(--c-border-light);
    transition: background .25s;
  }

  .pillar-card:hover::before { background: var(--c-secondary); }

  .pillar-num {
    font-size: var(--fs-display); font-weight: 800;
    color: rgba(20,23,45,0.05);
    line-height: 1; margin-bottom: 20px;
    letter-spacing: var(--ls-tight);
  }

  .pillar-title { font-size: var(--fs-md); font-weight: 700; color: var(--c-text-heading); margin-bottom: 12px; }
  .pillar-desc { font-size: var(--fs-sm); color: var(--c-text-muted); line-height: 1.75; }

  @media (max-width: 1023px) {
    .about-intro-grid { grid-template-columns: 1fr; gap: 40px; }
    .about-intro-img { height: 360px; }
    .mvv-grid { grid-template-columns: 1fr; gap: 40px; }
    .mvv-img { position: relative; top: 0; height: 280px; }
    .valores-list { grid-template-columns: 1fr; }
    .pillars-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .pillars-grid { grid-template-columns: 1fr; }
    .about-stat-row { flex-wrap: wrap; gap: 24px; }
  }
</style>
