            <div id="sec-func" class="ch-section ch-dynamic">
              <p class="ch-section-label">2. Incumplimiento de funciones</p>
              <div class="ch-field">
                <label for="func_nombre">Nombre completo <span class="ch-req">*</span></label>
                <input class="ch-input" type="text" id="func_nombre" placeholder="Apellidos y nombres completos">
              </div>
              <div class="ch-field">
                <label for="func_que">¿Qué función o tarea incumplió? <span class="ch-req">*</span></label>
                <textarea class="ch-textarea" id="func_que" placeholder="Ej: No generó los correos automáticos del proceso de pagos..."></textarea>
              </div>
              <div class="ch-field">
                <label for="func_exhort">¿Qué debe hacer para corregirlo? <span class="ch-req">*</span></label>
                <textarea class="ch-textarea" id="func_exhort" placeholder="Acción correctiva concreta..."></textarea>
              </div>
              <div class="ch-field">
                <label for="func_fg">¿Falta grave? <span class="ch-req">*</span></label>
                <select class="ch-select" id="func_fg">
                  <option value="">Seleccionar...</option>
                  <option value="SI">Sí</option>
                  <option value="NO">No</option>
                </select>
              </div>
            </div>

            <div id="sec-tareas" class="ch-section ch-dynamic">
              <p class="ch-section-label">2. Incumplimiento de tareas</p>
              <div class="ch-field">
                <label for="tareas_nombre">Nombre completo <span class="ch-req">*</span></label>
                <input class="ch-input" type="text" id="tareas_nombre" placeholder="Apellidos y nombres completos">
              </div>
              <div class="ch-field">
                <label for="tareas_fg">¿Falta grave? <span class="ch-req">*</span></label>
                <select class="ch-select" id="tareas_fg">
                  <option value="">Seleccionar...</option>
                  <option value="SI">Sí</option>
                  <option value="NO">No</option>
                </select>
              </div>
              <div id="tareas-container">
                <div class="ch-tarea-box">
                  <p class="ch-tarea-num">Tarea 1</p>
                  <div class="ch-field">
                    <label>Tarea asignada <span class="ch-req">*</span></label>
                    <input class="ch-input t-tarea" type="text" placeholder="Descripción de la tarea">
                  </div>
                  <div class="ch-grid2">
                    <div class="ch-field">
                      <label>Fecha de creación <span class="ch-req">*</span></label>
                      <input class="ch-input t-fcreac" type="date">
                    </div>
                    <div class="ch-field">
                      <label>Designado por <span class="ch-req">*</span></label>
                      <input class="ch-input t-design" type="text" placeholder="Nombre">
                    </div>
                    <div class="ch-field">
                      <label>Fecha de vencimiento <span class="ch-req">*</span></label>
                      <input class="ch-input t-venc" type="date">
                    </div>
                    <div class="ch-field">
                      <label>Tiempo vencido <span class="ch-req">*</span></label>
                      <input class="ch-input t-tvenc" type="text" placeholder="Ej: 2 MESES">
                    </div>
                  </div>
                </div>
              </div>
              <button class="ch-btn-add" id="btn-add-tarea" type="button" onclick="addTarea()">+ Agregar otra tarea (máx. 5)</button>
            </div>

      </div>

          <div class="ch-resumen" id="resumen" aria-live="polite"></div>

          <div class="ch-actions">
            <button class="btn btn-outline" type="button" onclick="verResumen()">Ver resumen</button>
            <button class="btn btn-primary" type="button" id="btn-enviar" onclick="enviar()">Enviar solicitud</button>
          </div>

          <div class="ch-success" id="success-view">
            <div class="ch-check" aria-hidden="true">✓</div>
            <h2>Solicitud enviada</h2>
            <p>Capital Humano ha recibido su solicitud y procesará el documento a la brevedad.</p>
            <div class="ch-asunto-result">
              <strong>Asunto del documento:</strong><br>
              <span id="asunto-final"></span>
            </div>
            <button class="btn btn-primary" type="button" onclick="resetForm()">Nueva solicitud</button>
          </div>
        </div>
        </div>
      </div>

      <div class="ch-page" id="page-registros">
        <div class="ch-pin-overlay" id="pin-overlay" role="dialog" aria-modal="true" aria-label="Acceso restringido">
          <div class="ch-pin-card">
            <h2>Acceso restringido</h2>
            <p>Selecciona tu rol e ingresa el PIN correspondiente</p>
            <div class="ch-pin-roles" role="group" aria-label="Seleccionar rol">
              <button class="ch-pin-role-btn" type="button" data-role="RRHH">Recursos Humanos</button>
              <button class="ch-pin-role-btn" type="button" data-role="Jefe">Jefe de área</button>
              <button class="ch-pin-role-btn" type="button" data-role="Gerente">Gerente</button>
            </div>
            <div class="ch-pin-inputs" role="group" aria-label="Ingresa tu PIN de 4 dígitos">
              <input type="password" maxlength="1" class="pin-digit" id="p0" aria-label="Dígito 1" oninput="pinNext(0)" onkeydown="pinBack(event,0)">
              <input type="password" maxlength="1" class="pin-digit" id="p1" aria-label="Dígito 2" oninput="pinNext(1)" onkeydown="pinBack(event,1)">
              <input type="password" maxlength="1" class="pin-digit" id="p2" aria-label="Dígito 3" oninput="pinNext(2)" onkeydown="pinBack(event,2)">
              <input type="password" maxlength="1" class="pin-digit" id="p3" aria-label="Dígito 4" oninput="pinNext(3)" onkeydown="pinBack(event,3)">
            </div>
            <p class="ch-pin-error" id="pin-error" role="alert"></p>
            <button class="btn btn-primary ch-pin-submit" type="button" onclick="checkPin()">Ingresar</button>
          </div>
        </div>

        <div class="ch-reg" id="dashboard" style="display:none">
          <div class="ch-dash-header">
            <div>
              <h2 class="ch-dash-title">Registros de solicitudes</h2>
              <p class="ch-dash-meta" id="dash-meta">Cargando...</p>
            </div>
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
              <div class="ch-role-badge"><span class="dot"></span><span id="role-label">—</span></div>
              <button class="btn btn-outline btn-sm" type="button" onclick="loadRegistros()">Actualizar</button>
            </div>
          </div>
          <div class="ch-stats">
            <div class="ch-stat"><div class="ch-stat-label">Total</div><div class="ch-stat-val" id="s-total">—</div><div class="ch-stat-sub">solicitudes</div></div>
            <div class="ch-stat"><div class="ch-stat-label">Memorandos</div><div class="ch-stat-val" id="s-memo">—</div><div class="ch-stat-sub">documentos</div></div>
            <div class="ch-stat"><div class="ch-stat-label">Amonestaciones</div><div class="ch-stat-val" id="s-amon">—</div><div class="ch-stat-sub">documentos</div></div>
            <div class="ch-stat"><div class="ch-stat-label">Faltas graves</div><div class="ch-stat-val" id="s-graves">—</div><div class="ch-stat-sub">registradas</div></div>
          </div>
          <div class="ch-filters">
            <input class="ch-input" type="search" id="search-box" placeholder="Buscar por nombre, asunto..." oninput="renderTable()" aria-label="Buscar registros">
            <select class="ch-select" id="filter-tipo" onchange="renderTable()" aria-label="Filtrar por tipo">
              <option value="">Todos los tipos</option>
              <option value="Memorando">Memorandos</option>
              <option value="Amonestación">Amonestaciones</option>
            </select>
            <select class="ch-select" id="filter-grave" onchange="renderTable()" aria-label="Filtrar por falta grave">
              <option value="">Falta grave: todas</option>
              <option value="SI">Sí</option>
              <option value="NO">No</option>
              <option value="—">N/A</option>
            </select>
          </div>
          <div class="ch-table-card">
            <div class="ch-table-wrap">
              <table class="ch-table">
                <thead>
                  <tr>
                    <th scope="col">#</th>
                    <th scope="col">Fecha</th>
                    <th scope="col">Trabajador</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Subtipo</th>
                    <th scope="col">Asunto</th>
                    <th scope="col" class="col-detalle">Detalle</th>
                    <th scope="col">F. Grave</th>
                  </tr>
                </thead>
                <tbody id="tbl-body">
                  <tr><td colspan="8" class="ch-loading">Cargando registros...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <div class="ch-toast" id="toast" role="status" aria-live="polite"></div>

<script is:inline>
// ═══════════════════════════════════════
//  ⚙️  CONFIGURACIÓN
// is:inline → Astro no empaqueta este script como módulo ES;
// los onclick="enviar()" etc. requieren funciones en window.
// ═══════════════════════════════════════
var SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwPeYkq5RMpP9U4bFD3ZVUsYgCPGV9ci5CKe1vmngh68Bt8fLWXMlozyKBkGdWn1IT3/exec';

// ⚠️  IMPORTANTE: cambiar antes de publicar
// Estos PINs son visibles en el código fuente.
// Backend: web-astro/src/appscripts/amonestacion.js (columnas por campo en Sheet)
var PINS = {
  RRHH:    '1234',
  Jefe:    '5678',
  Gerente: '9012'
};
// ═══════════════════════════════════════

var tipo = '';
var tareaCount = 1;
var currentRole = null;
var allData = [];

/* ── UTILS: escape XSS ── */
function esc(str) {
  if (str === null || str === undefined) return '—';
  return String(str)
    .replace(/&/g,'&amp;')
    .replace(/</g,'&lt;')
    .replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;')
    .replace(/'/g,'&#39;');
}

/* ── NAVEGACIÓN ── */
var CH_HEAD = {
  form: {
    title: 'Nueva solicitud',
    desc: 'Complete el formulario para solicitar memorandos o amonestaciones.'
  },
  registros: {
    title: 'Registros',
    desc: 'Consulta y filtra las solicitudes enviadas (acceso con PIN).'
  }
};

function showPage(p, navEl) {
  document.querySelectorAll('.ch-page').forEach(function(el){ el.classList.remove('active'); });
  document.querySelectorAll('.ch-nav-link[data-page]').forEach(function(el){
    el.classList.remove('active');
  });
  document.getElementById('page-' + p).classList.add('active');
  if (navEl && navEl.dataset && navEl.dataset.page) {
    navEl.classList.add('active');
  } else {
    var fallback = document.querySelector('.ch-nav-link[data-page="' + p + '"]');
    if (fallback) fallback.classList.add('active');
  }
  var head = CH_HEAD[p];
  if (head) {
    document.getElementById('ch-main-title').textContent = head.title;
    document.getElementById('ch-main-desc').textContent = head.desc;
  }
  if (p === 'registros' && !currentRole) {
    document.getElementById('pin-overlay').classList.remove('hidden');
    document.getElementById('dashboard').style.display = 'none';
    document.getElementById('btn-logout').style.display = 'none';
  }
}

/* ── PIN ── */
function selectRole(role, btn) {
  currentRole = role;
  document.querySelectorAll('.ch-pin-role-btn').forEach(function(b){ b.classList.remove('chosen'); });
  btn.classList.add('chosen');
  document.getElementById('pin-error').style.display = 'none';
  document.getElementById('p0').focus();
}
function pinNext(i) {
  if (document.getElementById('p'+i).value && i < 3)
    document.getElementById('p'+(i+1)).focus();
}
function pinBack(e, i) {
  if (e.key==='Backspace' && !document.getElementById('p'+i).value && i > 0)
    document.getElementById('p'+(i-1)).focus();
  if (e.key==='Enter') checkPin();
}
function checkPin() {
  var errEl = document.getElementById('pin-error');
  if (!currentRole) {
    errEl.textContent = 'Por favor selecciona tu rol.';
    errEl.style.display = 'block'; return;
  }
  var pin = ['p0','p1','p2','p3'].map(function(id){ return document.getElementById(id).value; }).join('');
  if (pin === PINS[currentRole]) {
    document.getElementById('pin-overlay').classList.add('hidden');
    document.getElementById('dashboard').style.display = 'block';
    document.getElementById('btn-logout').style.display = 'block';
    document.getElementById('role-label').textContent = currentRole;
    showPage('registros', document.querySelector('.ch-nav-link[data-page="registros"]'));
    loadRegistros();
  } else {
    errEl.textContent = 'PIN incorrecto. Intenta nuevamente.';
    errEl.style.display = 'block';
    ['p0','p1','p2','p3'].forEach(function(id){ document.getElementById(id).value=''; });
    document.getElementById('p0').focus();
  }
}
function logout() {
  currentRole = null; allData = [];
  document.getElementById('btn-logout').style.display = 'none';
  document.getElementById('dashboard').style.display = 'none';
  document.getElementById('pin-overlay').classList.remove('hidden');
  ['p0','p1','p2','p3'].forEach(function(id){ document.getElementById(id).value=''; });
  document.querySelectorAll('.ch-pin-role-btn').forEach(function(b){ b.classList.remove('chosen'); });
  document.getElementById('pin-error').style.display = 'none';
  showPage('form', document.querySelector('.ch-nav-link[data-page="form"]'));
}

/* ── REGISTROS ── */
function fieldVal(id) {
  var el = document.getElementById(id);
  return el ? el.value.trim() : '';
}

function collectTareas() {
  var tareasData = [];
  document.querySelectorAll('#tareas-container .ch-tarea-box').forEach(function(box) {
    tareasData.push({
      tarea:  box.querySelector('.t-tarea')  ? box.querySelector('.t-tarea').value.trim()  : '',
      fcreac: box.querySelector('.t-fcreac') ? box.querySelector('.t-fcreac').value : '',
      design: box.querySelector('.t-design') ? box.querySelector('.t-design').value.trim() : '',
      venc:   box.querySelector('.t-venc')   ? box.querySelector('.t-venc').value : '',
      tvenc:  box.querySelector('.t-tvenc')  ? box.querySelector('.t-tvenc').value.trim() : ''
    });
  });
  return tareasData;
}

function formatDetalleRegistro(r) {
  var parts = [];
  if (r.memoinf_desc) parts.push(r.memoinf_desc);
  if (r.memorec_desc) parts.push(r.memorec_desc);
  if (r.memorec_exhort) parts.push('Corrección: ' + r.memorec_exhort);
  if (r.reunion_fecha) parts.push('Reunión: ' + r.reunion_fecha);
  if (r.func_que) parts.push(r.func_que);
  if (r.func_exhort) parts.push('Corrección: ' + r.func_exhort);
  if (r.tareas && r.tareas.length) {
    r.tareas.forEach(function(t, i) {
      if (t.tarea) parts.push('T' + (i + 1) + ': ' + t.tarea);
    });
  }
  return parts.length ? parts.join(' | ') : '—';
}

function formatFecha(val) {
  if (!val) return '—';
  if (val instanceof Date || (typeof val === 'object' && val.toString)) {
    try {
      var d = new Date(val);
      if (!isNaN(d.getTime())) return d.toLocaleDateString('es-PE');
    } catch (e) { /* ignore */ }
  }
  return String(val);
}

function loadRegistros() {
  document.getElementById('tbl-body').innerHTML = '<tr><td colspan="8" class="ch-loading">Cargando registros...</td></tr>';
  document.getElementById('dash-meta').textContent = 'Actualizando...';
  fetch(SCRIPT_URL + '?action=get')
    .then(function(r){ return r.json(); })
    .then(function(data){
      if (!Array.isArray(data)) throw new Error('Respuesta inesperada del servidor');
      processData(data);
    })
    .catch(function(err){
      document.getElementById('tbl-body').innerHTML = '<tr><td colspan="8" class="ch-loading">Error al cargar registros. Intenta nuevamente.</td></tr>';
      document.getElementById('dash-meta').textContent = 'Error de conexión';
      showToast('Error al conectar con la base de datos.', 'error');
    });
}

function processData(data) {
  allData = data;
  var total  = allData.length;
  var memos  = allData.filter(function(r){ return r.tipo_doc==='Memorando'; }).length;
  var amon   = allData.filter(function(r){ return r.tipo_doc==='Amonestación'; }).length;
  var graves = allData.filter(function(r){ return r.falta_grave==='SI'; }).length;
  document.getElementById('s-total').textContent  = total;
  document.getElementById('s-memo').textContent   = memos;
  document.getElementById('s-amon').textContent   = amon;
  document.getElementById('s-graves').textContent = graves;
  document.getElementById('dash-meta').textContent = total + ' registro(s) · ' + new Date().toLocaleString('es-PE');
  renderTable();
}

function renderTable() {
  var search = document.getElementById('search-box').value.toLowerCase();
  var ftipo  = document.getElementById('filter-tipo').value;
  var fgrave = document.getElementById('filter-grave').value;
  var rows = allData.filter(function(r){
    var detalle = formatDetalleRegistro(r);
    var ok = (!search ||
      (r.nombre||'').toLowerCase().includes(search) ||
      (r.asunto||'').toLowerCase().includes(search) ||
      (r.subtipo||'').toLowerCase().includes(search) ||
      detalle.toLowerCase().includes(search));
    return ok && (!ftipo || r.tipo_doc===ftipo) && (!fgrave || r.falta_grave===fgrave);
  });
  if (!rows.length) {
    document.getElementById('tbl-body').innerHTML =
      '<tr><td colspan="8"><div class="ch-empty"><div class="icon">📭</div><p>No se encontraron registros.</p></div></td></tr>';
    return;
  }
  var html = '';
  rows.forEach(function(r, i){
    var tipoClass  = r.tipo_doc==='Memorando' ? 'ch-badge-memo' : 'ch-badge-amon';
    var graveClass = r.falta_grave==='SI' ? 'ch-badge-grave' : (r.falta_grave==='NO' ? 'ch-badge-no' : '');
    var detalleCell = currentRole === 'RRHH'
      ? '<td style="font-size:0.8rem;max-width:280px;color:var(--c-text-muted)">' + esc(formatDetalleRegistro(r)) + '</td>'
      : '<td style="font-size:0.8rem;color:var(--c-text-muted);font-style:italic">— restringido —</td>';
    html += '<tr>' +
      '<td style="color:var(--c-text-muted);font-size:0.8rem">' + (i+1) + '</td>' +
      '<td style="white-space:nowrap">' + esc(formatFecha(r.fecha)) + '</td>' +
      '<td><strong>' + esc(r.nombre) + '</strong></td>' +
      '<td><span class="ch-badge ' + tipoClass + '">' + esc(r.tipo_doc) + '</span></td>' +
      '<td style="font-size:0.8rem">' + esc(r.subtipo) + '</td>' +
      '<td style="font-size:0.8rem;max-width:220px">' + esc(r.asunto) + '</td>' +
      detalleCell +
      '<td>' + (r.falta_grave && r.falta_grave!=='—'
        ? '<span class="ch-badge ' + graveClass + '">' + esc(r.falta_grave) + '</span>'
        : '—') + '</td>' +
      '</tr>';
  });
  document.getElementById('tbl-body').innerHTML = html;
}

/* ── FORMULARIO ── */
function setTipo(t, el) {
  tipo = t;
  document.querySelectorAll('.ch-tipo-card').forEach(function(c){
    c.classList.remove('selected'); c.setAttribute('aria-pressed','false');
  });
  el.classList.add('selected'); el.setAttribute('aria-pressed','true');
  document.querySelectorAll('.ch-dynamic').forEach(function(d){ d.classList.remove('show'); });
  document.getElementById('sec-' + t).classList.add('show');
  document.getElementById('rest-form').style.display = 'block';
  // Limpiar errores visuales al cambiar tipo
  document.querySelectorAll('.field-error').forEach(function(el){ el.classList.remove('field-error'); });
}

function getNombre() {
  var id = { memoinf:'memoinf_nombre', memorec:'memorec_nombre', reunion:'reunion_nombre', func:'func_nombre', tareas:'tareas_nombre' }[tipo];
  if (!id) return '';
  var el = document.getElementById(id);
  return el ? el.value.trim() : '';
}

function markErrorEl(el) {
  if (el) el.classList.add('field-error');
}

function validarTareas() {
  var ok = true;
  document.querySelectorAll('#tareas-container .ch-tarea-box').forEach(function(box) {
    var fields = [
      box.querySelector('.t-tarea'),
      box.querySelector('.t-fcreac'),
      box.querySelector('.t-design'),
      box.querySelector('.t-venc'),
      box.querySelector('.t-tvenc')
    ];
    fields.forEach(function(el) {
      if (!el) return;
      if (el.type === 'date' ? !el.value : !el.value.trim()) {
        markErrorEl(el);
        ok = false;
      }
    });
  });
  return ok;
}

function addTarea() {
  if (tareaCount >= 5) return;
  tareaCount++;
  var div = document.createElement('div');
  div.className = 'ch-tarea-box';
  div.innerHTML =
    '<p class="ch-tarea-num">Tarea ' + tareaCount + '</p>' +
    '<div class="ch-field"><label>Tarea asignada <span class="ch-req">*</span></label><input type="text" class="ch-input t-tarea" placeholder="Descripción de la tarea"></div>' +
    '<div class="ch-grid2">' +
    '<div class="ch-field"><label>Fecha de creación <span class="ch-req">*</span></label><input type="date" class="ch-input t-fcreac"></div>' +
    '<div class="ch-field"><label>Designado por <span class="ch-req">*</span></label><input type="text" class="ch-input t-design" placeholder="Nombre"></div>' +
    '<div class="ch-field"><label>Fecha de vencimiento <span class="ch-req">*</span></label><input type="date" class="ch-input t-venc"></div>' +
    '<div class="ch-field"><label>Tiempo vencido <span class="ch-req">*</span></label><input type="text" class="ch-input t-tvenc" placeholder="Ej: 1 MES"></div>' +
    '</div>';
  document.getElementById('tareas-container').appendChild(div);
  if (tareaCount >= 5) document.getElementById('btn-add-tarea').disabled = true;
}

function getAsunto() {
  var tipos = { memoinf:'MEMORANDO', memorec:'MEMORANDO', reunion:'AMONESTACIÓN', func:'AMONESTACIÓN', tareas:'AMONESTACIÓN' };
  var motivos = {
    memoinf: document.getElementById('memoinf_asunto').value || '[motivo]',
    memorec: document.getElementById('memorec_asunto').value || '[motivo]',
    reunion:  'Inasistencia a reunión obligatoria de Gerencia',
    func:     'Incumplimiento de Funciones',
    tareas:   'Incumplimiento de Tareas Asignadas'
  };
  return (tipos[tipo]||'SOLICITUD') + ' – ' + (motivos[tipo]||'');
}

function getSubtipo() {
  var sub = { memoinf:'Informativo', memorec:'Recordatorio', reunion:'Inasistencia a reunión con Gerencia', func:'Incumplimiento de Funciones', tareas:'Incumplimiento de Tareas' };
  return sub[tipo] || tipo;
}

function getDetalle() {
  if (tipo==='memoinf') return document.getElementById('memoinf_desc').value;
  if (tipo==='memorec') return document.getElementById('memorec_desc').value + ' | Corrección esperada: ' + document.getElementById('memorec_exhort').value;
  if (tipo==='reunion')  return 'Fecha reunión: ' + document.getElementById('reunion_fecha').value;
  if (tipo==='func')     return 'Incumplimiento: ' + document.getElementById('func_que').value + ' | Corrección: ' + document.getElementById('func_exhort').value;
  if (tipo==='tareas') {
    var tareas = [];
    document.querySelectorAll('#tareas-container .ch-tarea-box').forEach(function(box, i){
      var tarea   = box.querySelector('.t-tarea').value;
      var fcreac  = box.querySelector('.t-fcreac').value;
      var design  = box.querySelector('.t-design').value;
      var venc    = box.querySelector('.t-venc').value;
      var tvenc   = box.querySelector('.t-tvenc').value;
      tareas.push('T'+(i+1)+': '+tarea+' | Creada: '+fcreac+' | Por: '+design+' | Vence: '+venc+' | Vencida: '+tvenc);
    });
    return tareas.join(' || ');
  }
  return '';
}

function getFaltaGrave() {
  if (tipo==='func')   return document.getElementById('func_fg').value   || '—';
  if (tipo==='tareas') return document.getElementById('tareas_fg').value || '—';
  return '—';
}

/* ── VALIDACIÓN ── */
function markError(id) {
  var el = document.getElementById(id);
  if (el) el.classList.add('field-error');
}
function clearErrors() {
  document.querySelectorAll('#page-form .field-error').forEach(function(el){ el.classList.remove('field-error'); });
}
function validarFormulario() {
  clearErrors();
  var ok = true;
  function req(id, val) {
    if (!val || !String(val).trim()) { markError(id); ok = false; }
  }
  if (!tipo) { showToast('Selecciona el tipo de documento.', 'error'); return false; }

  if (tipo === 'memoinf') {
    req('memoinf_nombre', document.getElementById('memoinf_nombre').value);
    req('memoinf_asunto', document.getElementById('memoinf_asunto').value);
    req('memoinf_desc',   document.getElementById('memoinf_desc').value);
  } else if (tipo === 'memorec') {
    req('memorec_nombre', document.getElementById('memorec_nombre').value);
    req('memorec_asunto', document.getElementById('memorec_asunto').value);
    req('memorec_desc',   document.getElementById('memorec_desc').value);
    req('memorec_exhort', document.getElementById('memorec_exhort').value);
  } else if (tipo === 'reunion') {
    req('reunion_nombre', document.getElementById('reunion_nombre').value);
    if (!document.getElementById('reunion_fecha').value) { markError('reunion_fecha'); ok = false; }
  } else if (tipo === 'func') {
    req('func_nombre', document.getElementById('func_nombre').value);
    req('func_que',    document.getElementById('func_que').value);
    req('func_exhort', document.getElementById('func_exhort').value);
    if (!document.getElementById('func_fg').value) { markError('func_fg'); ok = false; }
  } else if (tipo === 'tareas') {
    req('tareas_nombre', document.getElementById('tareas_nombre').value);
    if (!document.getElementById('tareas_fg').value) { markError('tareas_fg'); ok = false; }
    if (!validarTareas()) ok = false;
  }

  if (!ok) showToast('Completa todos los campos obligatorios (marcados en rojo).', 'error');
  return ok;
}

function verResumen() {
  if (!validarFormulario()) return;
  var tipoLabel = {
    memoinf: 'Memorando – Informativo',
    memorec: 'Memorando – Recordatorio',
    reunion: 'Amonestación – Inasistencia a reunión con Gerencia',
    func:    'Amonestación – Incumplimiento de funciones',
    tareas:  'Amonestación – Incumplimiento de tareas'
  };
  var box = document.getElementById('resumen');
  box.innerHTML = '';
  var pill = document.createElement('span');
  pill.className = 'ch-asunto-pill';
  pill.textContent = getAsunto();
  box.appendChild(pill);
  box.appendChild(document.createElement('br'));
  var lines = ['Tipo: ' + (tipoLabel[tipo] || tipo), 'Nombre completo: ' + getNombre()];
  if (tipo === 'func' || tipo === 'tareas') {
    lines.push('Falta grave: ' + getFaltaGrave());
  }
  if (tipo === 'tareas') {
    lines.push('Detalle: ' + getDetalle());
  }
  lines.forEach(function(line) {
    var p = document.createElement('div');
    p.textContent = line;
    box.appendChild(p);
  });
  box.classList.add('show');
}

function mostrarExito(asunto) {
  document.getElementById('asunto-final').textContent = asunto;
  document.getElementById('form-view').style.display = 'none';
  document.getElementById('success-view').style.display = 'block';
  showToast('✅ Solicitud enviada correctamente', 'ok');
}

function enviarPorIframe(payload) {
  var iframe = document.getElementById('hidden-frame');
  if (!iframe) {
    iframe = document.createElement('iframe');
    iframe.name = 'hidden-frame'; iframe.id = 'hidden-frame';
    iframe.style.display = 'none';
    document.body.appendChild(iframe);
  }
  var form = document.createElement('form');
  form.method = 'POST'; form.action = SCRIPT_URL;
  form.target = 'hidden-frame'; form.style.display = 'none';
  var inp = document.createElement('input');
  inp.type = 'hidden'; inp.name = 'data'; inp.value = JSON.stringify(payload);
  form.appendChild(inp);
  document.body.appendChild(form);
  form.submit();
  setTimeout(function(){ if (document.body.contains(form)) document.body.removeChild(form); }, 3000);
}

function buildPayload() {
  var tareasData = collectTareas();
  return {
    fecha:    new Date().toLocaleDateString('es-PE'),
    tipo_doc: (tipo === 'memoinf' || tipo === 'memorec') ? 'Memorando' : 'Amonestación',
    subtipo:  getSubtipo(),
    asunto:   getAsunto(),
    nombre:   getNombre(),
    memoinf_asunto: tipo === 'memoinf' ? fieldVal('memoinf_asunto') : '',
    memoinf_desc:   tipo === 'memoinf' ? fieldVal('memoinf_desc')   : '',
    memorec_asunto: tipo === 'memorec' ? fieldVal('memorec_asunto') : '',
    memorec_desc:   tipo === 'memorec' ? fieldVal('memorec_desc')   : '',
    memorec_exhort: tipo === 'memorec' ? fieldVal('memorec_exhort') : '',
    reunion_fecha:  tipo === 'reunion'  ? fieldVal('reunion_fecha')  : '',
    func_que:       tipo === 'func'     ? fieldVal('func_que')       : '',
    func_exhort:    tipo === 'func'     ? fieldVal('func_exhort')    : '',
    func_fg:        tipo === 'func'     ? fieldVal('func_fg')        : '',
    tareas_fg:      tipo === 'tareas'   ? fieldVal('tareas_fg')      : '',
    tareas:         tipo === 'tareas'   ? tareasData                 : []
  };
}

function enviar() {
  if (!validarFormulario()) return;
  var btn = document.getElementById('btn-enviar');
  var payload = buildPayload();
  if (btn) { btn.disabled = true; btn.textContent = 'Enviando…'; }

  fetch(SCRIPT_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: 'data=' + encodeURIComponent(JSON.stringify(payload))
  })
    .then(function(r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      mostrarExito(payload.asunto);
    })
    .catch(function() {
      // Respaldo: formulario oculto (útil si fetch falla por CORS en producción)
      enviarPorIframe(payload);
      mostrarExito(payload.asunto);
      showToast('Enviado (modo alternativo). Verifica en Registros.', 'ok');
    })
    .finally(function() {
      if (btn) { btn.disabled = false; btn.textContent = 'Enviar solicitud'; }
    });
}

function resetForm() {
  // Solo limpiar el formulario, no el dashboard ni el PIN
  document.getElementById('form-view').style.display = 'block';
  document.getElementById('success-view').style.display = 'none';
  var formScope = document.getElementById('page-form');
  formScope.querySelectorAll('input').forEach(function(i){ i.value=''; i.classList.remove('field-error'); });
  formScope.querySelectorAll('textarea').forEach(function(t){ t.value=''; t.classList.remove('field-error'); });
  formScope.querySelectorAll('select').forEach(function(s){ s.selectedIndex=0; s.classList.remove('field-error'); });
  document.querySelectorAll('.ch-tipo-card').forEach(function(c){ c.classList.remove('selected'); c.setAttribute('aria-pressed','false'); });
  document.querySelectorAll('.ch-dynamic').forEach(function(d){ d.classList.remove('show'); });
  document.getElementById('rest-form').style.display = 'none';
  document.getElementById('resumen').classList.remove('show');
  var tc = document.getElementById('tareas-container');
  while (tc.children.length > 1) tc.removeChild(tc.lastChild);
  document.getElementById('btn-add-tarea').disabled = false;
  tipo = ''; tareaCount = 1;
}

function showToast(msg, type) {
  var t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'ch-toast show ' + (type||'');
  setTimeout(function(){ t.classList.remove('show'); }, 3500);
}

/* ── Inicializar event listeners (evita problemas con Astro y llaves JSX) ── */
document.addEventListener('DOMContentLoaded', function() {
  // Tarjetas de tipo de documento
  document.querySelectorAll('.ch-tipo-card').forEach(function(card) {
    card.addEventListener('click', function() {
      setTipo(this.dataset.tipo, this);
    });
    card.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        setTipo(this.dataset.tipo, this);
      }
    });
  });
  // Botones de rol PIN
  document.querySelectorAll('.ch-pin-role-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      selectRole(this.dataset.role, this);
    });
  });
  // Enter en PIN
  document.querySelectorAll('.pin-digit').forEach(function(inp, i) {
    inp.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') checkPin();
    });
  });
});
</script>

</BaseLayout>