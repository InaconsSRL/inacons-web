---
// Herramienta interna Capital Humano — INACONS
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Capital Humano — Solicitud de documentos | INACONS"
  description="Formulario interno de Capital Humano para solicitud de memorandos y amonestaciones."
  robots="noindex, nofollow"
  minimalChrome={true}
>

  <style slot="head">
    html.layout-minimal .main { padding: 0; min-height: 100vh; }
    html.layout-minimal body { min-height: 100vh; background: var(--c-bg-muted); }

    .ch-app { display: flex; min-height: 100vh; width: 100%; }
    .ch-sidebar {
      width: 248px; flex-shrink: 0;
      background: var(--c-primary);
      color: var(--c-text-white);
      display: flex; flex-direction: column;
      position: sticky; top: 0; align-self: flex-start;
      min-height: 100vh;
      border-right: 3px solid var(--c-accent);
    }
    .ch-sidebar-brand {
      padding: var(--sp-6) var(--sp-5) var(--sp-6);
      border-bottom: 1px solid var(--c-border-dark);
    }
    .ch-sidebar-brand img { height: 36px; width: auto; margin-bottom: var(--sp-3); }
    .ch-sidebar-brand strong {
      display: block; font-size: var(--fs-xs); font-weight: var(--fw-semibold);
      letter-spacing: var(--ls-label); text-transform: uppercase;
      color: var(--c-accent);
    }
    .ch-sidebar-brand span {
      display: block; font-size: var(--fs-md); font-weight: var(--fw-semibold);
      color: var(--c-on-dark-1); margin-top: var(--sp-1);
    }
    .ch-nav {
      flex: 1; padding: var(--sp-4) var(--sp-3);
      display: flex; flex-direction: column; gap: var(--sp-1);
    }
    .ch-nav-link {
      display: flex; align-items: center; gap: var(--sp-2);
      width: 100%; padding: var(--sp-3) var(--sp-3);
      border: none; border-radius: var(--radius);
      background: transparent; color: var(--c-on-dark-3);
      font-family: var(--font-ui); font-size: var(--fs-sm); font-weight: var(--fw-semibold);
      letter-spacing: var(--ls-label); text-transform: uppercase;
      text-decoration: none; cursor: pointer; text-align: left;
      transition: background var(--t), color var(--t);
    }
    .ch-nav-link:hover {
      background: var(--c-surface-dark-2);
      color: #fff;
    }
    .ch-nav-link.active {
      background: rgba(27, 82, 120, 0.55);
      color: #fff;
      box-shadow: inset 3px 0 0 var(--c-accent);
    }
    .ch-nav-link--ext::before {
      content: '↗'; font-size: var(--fs-base); opacity: 0.7;
    }
    .ch-sidebar-foot {
      padding: var(--sp-4) var(--sp-3) var(--sp-6);
      border-top: 1px solid var(--c-border-dark);
    }
    .ch-nav-logout { color: var(--c-on-dark-3); font-size: var(--fs-xs); }
    .ch-nav-logout:hover { color: #fff; }
    .ch-main {
      flex: 1; min-width: 0;
      padding: 32px clamp(16px, 4vw, 40px) 48px;
      background: var(--c-bg-muted);
    }
    .ch-main-head { margin-bottom: var(--sp-6); max-width: 720px; }
    .ch-main-head .sh-title { font-size: clamp(1.2rem, 2vw, 1.5rem); margin-bottom: var(--sp-2); }
    .ch-main-head .sh-desc { font-size: var(--fs-base); }
    .ch-page { display: none; }
    .ch-page.active { display: block; }
    .ch-form-card {
      max-width: 720px; margin: 0 auto;
      background: var(--c-bg-white);
      border: 1px solid var(--c-border-light);
      border-top: 3px solid var(--c-secondary);
      padding: var(--sp-l1) var(--sp-7);
      box-shadow: var(--shadow-card);
    }
    .ch-form-intro { margin-bottom: var(--sp-7); }
    .ch-form-intro .sh-title { font-size: clamp(1.25rem, 2vw, 1.55rem); margin-bottom: var(--sp-2); }
    .ch-form-intro .sh-desc { font-size: var(--fs-md); }
    .ch-section {
      border: 1px solid var(--c-border-light);
      border-radius: var(--radius);
      padding: var(--sp-5) var(--sp-5); margin-bottom: var(--sp-4);
      background: var(--c-bg-muted);
    }
    .ch-section-label {
      font-size: var(--fs-2xs); font-weight: var(--fw-semibold);
      letter-spacing: var(--ls-label); text-transform: uppercase;
      color: var(--c-secondary); margin-bottom: var(--sp-4);
      display: flex; align-items: center; gap: var(--sp-2);
    }
    .ch-section-label::before {
      content: ''; width: 18px; height: 2px;
      background: var(--c-secondary); flex-shrink: 0;
    }
    .ch-field { margin-bottom: var(--sp-4); }
    .ch-field:last-child { margin-bottom: 0; }
    .ch-field label {
      display: block; font-size: var(--fs-2xs); font-weight: var(--fw-semibold);
      letter-spacing: var(--ls-label); text-transform: uppercase;
      color: var(--c-text-muted); margin-bottom: var(--sp-2);
    }
    .ch-req { color: var(--c-accent); margin-left: 2px; }
    .ch-input, .ch-select, .ch-textarea {
      width: 100%; border: 1.5px solid var(--c-border);
      border-radius: var(--radius); padding: var(--sp-3) var(--sp-3);
      font-family: var(--font-ui); font-size: var(--fs-base);
      color: var(--c-text-heading); background: var(--c-bg-white);
      outline: none;
      transition: border-color var(--t), box-shadow var(--t), background var(--t);
    }
    .ch-input:focus, .ch-select:focus, .ch-textarea:focus {
      border-color: var(--c-secondary);
      box-shadow: 0 0 0 3px rgba(27, 82, 120, 0.09);
    }
    .ch-input.field-error, .ch-select.field-error, .ch-textarea.field-error {
      border-color: #c0392b; background: #fff8f8;
    }
    .ch-textarea { resize: vertical; min-height: 100px; line-height: 1.65; }
    .ch-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-3); }
    .ch-tipo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-2); }
    .ch-tipo-card {
      border: 1.5px solid var(--c-border-light);
      border-radius: var(--radius); padding: var(--sp-3) var(--sp-3);
      cursor: pointer; transition: all var(--t);
      user-select: none; background: var(--c-bg-white);
    }
    .ch-tipo-card:hover, .ch-tipo-card:focus {
      border-color: var(--c-secondary);
      background: rgba(27, 82, 120, 0.04); outline: none;
    }
    .ch-tipo-card.selected {
      border-color: var(--c-secondary);
      background: rgba(27, 82, 120, 0.08);
      box-shadow: inset 0 0 0 1px var(--c-secondary);
    }
    .ch-tc-title { font-size: var(--fs-sm); font-weight: var(--fw-bold); color: var(--c-text-heading); margin-bottom: var(--sp-1); }
    .ch-tc-desc { font-size: var(--fs-2xs); color: var(--c-text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
    .ch-dynamic { display: none; }
    .ch-dynamic.show { display: block; }
    .ch-tarea-box {
      background: var(--c-bg-white); border-radius: var(--radius);
      padding: var(--sp-4); margin-bottom: var(--sp-2);
      border: 1px solid var(--c-border-light);
    }
    .ch-tarea-num {
      font-size: var(--fs-2xs); font-weight: var(--fw-semibold); color: var(--c-text-muted);
      text-transform: uppercase; letter-spacing: var(--ls-label); margin-bottom: var(--sp-3);
    }
    .ch-btn-add {
      width: 100%; padding: var(--sp-3);
      border: 1.5px dashed var(--c-border); border-radius: var(--radius);
      background: transparent; color: var(--c-text-muted);
      font-size: var(--fs-sm); font-weight: var(--fw-semibold); cursor: pointer;
      margin-top: var(--sp-2); font-family: var(--font-ui);
      transition: all var(--t);
    }
    .ch-btn-add:hover { border-color: var(--c-secondary); color: var(--c-secondary); background: rgba(27,82,120,0.04); }
    .ch-btn-add:disabled { opacity: 0.45; cursor: not-allowed; }
    .ch-actions { display: flex; gap: var(--sp-3); margin-top: var(--sp-6); flex-wrap: wrap; }
    .ch-actions .btn { flex: 1; min-width: 140px; justify-content: center; }
    .ch-resumen {
      background: rgba(27, 82, 120, 0.06);
      border: 1px solid var(--c-border);
      border-left: 3px solid var(--c-secondary);
      border-radius: var(--radius); padding: var(--sp-4) var(--sp-4);
      margin-top: var(--sp-4); font-size: var(--fs-base); line-height: 1.85;
      display: none; color: var(--c-text-body);
    }
    .ch-resumen.show { display: block; }
    .ch-asunto-pill {
      display: inline-block; background: var(--c-primary);
      color: #fff; font-size: var(--fs-2xs); font-weight: var(--fw-semibold);
      padding: var(--sp-1) var(--sp-3); border-radius: var(--radius);
      margin-bottom: var(--sp-2); letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .ch-success { display: none; text-align: center; padding: var(--sp-5) 0 var(--sp-2); }
    .ch-success .ch-check { font-size: var(--fs-display); margin-bottom: var(--sp-4); line-height: 1; }
    .ch-success h2 { font-size: var(--fs-xl); color: var(--c-text-heading); margin-bottom: var(--sp-2); }
    .ch-success p { font-size: var(--fs-md); color: var(--c-text-muted); line-height: 1.7; margin-bottom: var(--sp-6); }
    .ch-asunto-result {
      background: var(--c-bg-muted); border: 1px solid var(--c-border-light);
      border-radius: var(--radius); padding: var(--sp-4);
      font-size: var(--fs-md); color: var(--c-text-heading); margin-bottom: var(--sp-6); text-align: left;
    }
    .ch-toast {
      position: fixed; bottom: 28px; right: 28px;
      background: var(--c-primary); color: #fff;
      padding: var(--sp-3) var(--sp-5); border-radius: var(--radius);
      font-size: var(--fs-base); font-weight: var(--fw-semibold);
      box-shadow: var(--shadow-card-hover);
      transform: translateY(80px); opacity: 0;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      z-index: 1100; max-width: min(360px, calc(100vw - 32px));
    }
    .ch-toast.show { transform: translateY(0); opacity: 1; }
    .ch-toast.error { background: #c0392b; }
    .ch-toast.ok { background: #1e7e5e; }
    /* Registros */
    .ch-reg { max-width: 1140px; margin: 0 auto; }
    .ch-pin-overlay {
      position: fixed; inset: 0;
      background: rgba(20, 23, 45, 0.72);
      backdrop-filter: blur(6px);
      display: flex; align-items: center; justify-content: center;
      z-index: 1100;
    }
    .ch-pin-overlay.hidden { display: none; }
    .ch-pin-card {
      background: var(--c-bg-white); border-radius: var(--radius);
      padding: var(--sp-l1) var(--sp-7); width: min(400px, calc(100vw - 32px));
      box-shadow: var(--shadow-card-hover); text-align: center;
      border-top: 3px solid var(--c-secondary);
    }
    .ch-pin-card h2 { font-size: var(--fs-xl); color: var(--c-text-heading); margin-bottom: var(--sp-2); }
    .ch-pin-card p { font-size: var(--fs-base); color: var(--c-text-muted); margin-bottom: var(--sp-6); }
    .ch-pin-inputs { display: flex; gap: var(--sp-2); justify-content: center; margin-bottom: var(--sp-5); }
    .ch-pin-inputs input {
      width: 52px; height: 56px; text-align: center;
      font-size: var(--fs-xl); font-weight: var(--fw-bold);
      border: 1.5px solid var(--c-border); border-radius: var(--radius);
      color: var(--c-text-heading); font-family: var(--font-ui);
    }
    .ch-pin-inputs input:focus {
      border-color: var(--c-secondary);
      box-shadow: 0 0 0 3px rgba(27, 82, 120, 0.09); outline: none;
    }
    .ch-pin-roles { display: flex; flex-direction: column; gap: var(--sp-2); margin-bottom: var(--sp-5); }
    .ch-pin-role-btn {
      padding: var(--sp-3); border-radius: var(--radius);
      font-size: var(--fs-sm); font-weight: var(--fw-semibold); cursor: pointer;
      border: 1.5px solid var(--c-border); background: var(--c-bg-muted);
      color: var(--c-text-body); font-family: var(--font-ui);
      transition: all var(--t);
    }
    .ch-pin-role-btn:hover { border-color: var(--c-secondary); color: var(--c-secondary); }
    .ch-pin-role-btn.chosen {
      border-color: var(--c-secondary); background: var(--c-secondary); color: #fff;
    }
    .ch-pin-error { color: #c0392b; font-size: var(--fs-sm); margin: -8px 0 var(--sp-3); display: none; }
    .ch-pin-submit { width: 100%; justify-content: center; }
    .ch-dash-header {
      display: flex; align-items: flex-start; justify-content: space-between;
      margin-bottom: var(--sp-6); flex-wrap: wrap; gap: var(--sp-4);
    }
    .ch-dash-title { font-size: clamp(1.2rem, 2vw, 1.6rem); color: var(--c-text-heading); margin-bottom: var(--sp-1); }
    .ch-dash-meta { font-size: var(--fs-base); color: var(--c-text-muted); }
    .ch-role-badge {
      display: inline-flex; align-items: center; gap: var(--sp-2);
      background: var(--c-primary); color: #fff;
      font-size: var(--fs-xs); font-weight: var(--fw-semibold); padding: var(--sp-2) var(--sp-3);
      border-radius: var(--radius); letter-spacing: 0.5px; text-transform: uppercase;
    }
    .ch-role-badge .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--c-accent); }
    .ch-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--sp-1); margin-bottom: var(--sp-6); }
    .ch-stat {
      background: var(--c-bg-white); border: 1px solid var(--c-border-light);
      padding: var(--sp-5) var(--sp-4); transition: box-shadow var(--t);
    }
    .ch-stat:hover { box-shadow: var(--shadow-card); }
    .ch-stat-label {
      font-size: var(--fs-2xs); color: var(--c-text-muted);
      text-transform: uppercase; letter-spacing: var(--ls-label);
    }
    .ch-stat-val {
      font-size: var(--fs-2xl); font-weight: var(--fw-bold); color: var(--c-secondary);
      margin-top: var(--sp-1); line-height: 1;
    }
    .ch-stat-sub { font-size: var(--fs-xs); color: var(--c-text-muted); margin-top: var(--sp-1); }
    .ch-filters { display: flex; gap: var(--sp-2); margin-bottom: var(--sp-5); flex-wrap: wrap; }
    .ch-filters .ch-input, .ch-filters .ch-select { flex: 1; min-width: 160px; }
    .ch-table-card {
      background: var(--c-bg-white);
      border: 1px solid var(--c-border-light);
      box-shadow: var(--shadow-card); overflow: hidden;
    }
    .ch-table-wrap { overflow-x: auto; }
    .ch-table { width: 100%; border-collapse: collapse; font-size: var(--fs-sm); }
    .ch-table thead tr { background: var(--c-primary); color: #fff; }
    .ch-table th {
      padding: var(--sp-3) var(--sp-3); text-align: left; font-weight: var(--fw-semibold);
      font-size: var(--fs-2xs); letter-spacing: 1px; text-transform: uppercase;
      white-space: nowrap;
    }
    .ch-table td {
      padding: var(--sp-3) var(--sp-3); border-bottom: 1px solid var(--c-border-light);
      color: var(--c-text-body); vertical-align: top;
    }
    .ch-table tr:last-child td { border-bottom: none; }
    .ch-table tbody tr:hover td { background: var(--c-bg-muted); }
    .ch-badge {
      display: inline-block; font-size: var(--fs-2xs); font-weight: var(--fw-semibold);
      padding: var(--sp-1) var(--sp-2); border-radius: var(--radius);
      text-transform: uppercase; letter-spacing: 0.5px;
    }
    .ch-badge-memo { background: rgba(27, 82, 120, 0.12); color: var(--c-secondary); }
    .ch-badge-amon { background: rgba(217, 130, 43, 0.15); color: #9a5e10; }
    .ch-badge-grave { background: #fdecea; color: #c0392b; }
    .ch-badge-no { background: #e8f5e9; color: #2e7d32; }
    .ch-empty { text-align: center; padding: var(--sp-l2) var(--sp-5); color: var(--c-text-muted); }
    .ch-empty .icon { font-size: var(--fs-display); margin-bottom: var(--sp-3); }
    .ch-loading td { text-align: center; color: var(--c-text-muted); font-style: italic; padding: var(--sp-6); }
    @media (max-width: 768px) {
      .ch-app { flex-direction: column; }
      .ch-sidebar {
        width: 100%; min-height: auto; position: relative;
        border-right: none; border-bottom: 3px solid var(--c-accent);
      }
      .ch-sidebar-brand {
        display: flex; align-items: center; gap: var(--sp-3);
        padding: var(--sp-4) var(--sp-4);
      }
      .ch-sidebar-brand img { height: 28px; margin-bottom: 0; }
      .ch-nav {
        flex-direction: row; flex-wrap: wrap;
        padding: 0 var(--sp-3) var(--sp-3); gap: var(--sp-1);
      }
      .ch-nav-link {
        flex: 1; min-width: calc(33% - 6px);
        justify-content: center; padding: var(--sp-2) var(--sp-2);
        font-size: var(--fs-2xs); box-shadow: none;
      }
      .ch-nav-link.active { box-shadow: inset 0 -3px 0 var(--c-accent); }
      .ch-sidebar-foot { display: none; }
      .ch-main { padding: var(--sp-5) var(--sp-4) var(--sp-l1); }
      .ch-form-card { padding: var(--sp-6) var(--sp-5); }
      .ch-tipo-grid { grid-template-columns: 1fr 1fr; }
      .ch-grid2 { grid-template-columns: 1fr; }
      .ch-actions { flex-direction: column; }
      .ch-actions .btn { width: 100%; }
      .ch-stats { grid-template-columns: 1fr 1fr; }
    }
  </style>

  <div class="ch-app">
    <aside class="ch-sidebar" aria-label="Navegación Capital Humano">
      <div class="ch-sidebar-brand">
        <img src="/assets/imagenes/logos/logo_inacons_white.svg" alt="INACONS" width="140" height="36" />
        <strong>INACONS</strong>
        <span>Capital Humano</span>
      </div>
      <nav class="ch-nav" role="navigation">
        <a href="/" class="ch-nav-link ch-nav-link--ext">Inicio</a>
        <button type="button" class="ch-nav-link active" data-page="form" onclick="showPage('form', this)">Formulario</button>
        <button type="button" class="ch-nav-link" data-page="registros" onclick="showPage('registros', this)">Registros</button>
      </nav>
      <div class="ch-sidebar-foot">
        <button type="button" class="ch-nav-link ch-nav-logout" id="btn-logout" style="display:none" onclick="logout()">Cerrar sesión</button>
      </div>
    </aside>

    <div class="ch-main">
      <header class="ch-main-head sh sh--left sh--narrow" id="ch-main-head">
        <p class="sh-label">Uso interno</p>
        <h1 class="sh-title" id="ch-main-title">Nueva solicitud</h1>
        <p class="sh-desc" id="ch-main-desc">Complete el formulario para solicitar memorandos o amonestaciones.</p>
      </header>

      <div class="ch-page active" id="page-form">
        <div class="ch-form-card">
          <div id="form-view">
            <div class="ch-section">
              <p class="ch-section-label">1. Tipo de documento</p>
              <div class="ch-tipo-grid" role="group" aria-label="Tipo de documento">
                <div class="ch-tipo-card" tabindex="0" role="button" aria-pressed="false" data-tipo="memoinf">
                  <p class="ch-tc-title">Informativo</p><p class="ch-tc-desc">Memorando</p>
                </div>
                <div class="ch-tipo-card" tabindex="0" role="button" aria-pressed="false" data-tipo="memorec">
                  <p class="ch-tc-title">Recordatorio</p><p class="ch-tc-desc">Memorando</p>
                </div>
                <div class="ch-tipo-card" tabindex="0" role="button" aria-pressed="false" data-tipo="reunion">
                  <p class="ch-tc-title">Inasistencia reunión</p><p class="ch-tc-desc">Con Gerencia</p>
                </div>
                <div class="ch-tipo-card" tabindex="0" role="button" aria-pressed="false" data-tipo="func">
                  <p class="ch-tc-title">Incumpl. funciones</p><p class="ch-tc-desc">Amonestación</p>
                </div>
                <div class="ch-tipo-card" tabindex="0" role="button" aria-pressed="false" data-tipo="tareas">
                  <p class="ch-tc-title">Incumpl. tareas</p><p class="ch-tc-desc">Amonestación</p>
                </div>
              </div>
            </div>

      <div id="rest-form" style="display:none">

            <div id="sec-memoinf" class="ch-section ch-dynamic">
              <p class="ch-section-label">2. Memorando informativo</p>
              <div class="ch-field">
                <label for="memoinf_nombre">Nombre completo <span class="ch-req">*</span></label>
                <input class="ch-input" type="text" id="memoinf_nombre" placeholder="Apellidos y nombres completos">
              </div>
              <div class="ch-field">
                <label for="memoinf_asunto">Asunto del memorando <span class="ch-req">*</span></label>
                <input class="ch-input" type="text" id="memoinf_asunto" placeholder="Ej: Comunicado sobre nuevos procedimientos">
              </div>
              <div class="ch-field">
                <label for="memoinf_desc">Descripción del hecho <span class="ch-req">*</span></label>
                <textarea class="ch-textarea" id="memoinf_desc" placeholder="Describe qué ocurrió, en qué fecha y cuál es el impacto..."></textarea>
              </div>
            </div>

            <div id="sec-memorec" class="ch-section ch-dynamic">
              <p class="ch-section-label">2. Memorando recordatorio</p>
              <div class="ch-field">
                <label for="memorec_nombre">Nombre completo <span class="ch-req">*</span></label>
                <input class="ch-input" type="text" id="memorec_nombre" placeholder="Apellidos y nombres completos">
              </div>
              <div class="ch-field">
                <label for="memorec_asunto">Asunto del memorando <span class="ch-req">*</span></label>
                <input class="ch-input" type="text" id="memorec_asunto" placeholder="Ej: Incumplimiento de plazos en Pucusana">
              </div>
              <div class="ch-field">
                <label for="memorec_desc">Descripción del hecho <span class="ch-req">*</span></label>
                <textarea class="ch-textarea" id="memorec_desc" placeholder="Describe qué ocurrió..."></textarea>
              </div>
              <div class="ch-field">
                <label for="memorec_exhort">¿Qué se espera que corrija? <span class="ch-req">*</span></label>
