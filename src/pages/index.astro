---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

type Proyecto = CollectionEntry<'proyectos'>;

// Proyectos destacados para el home
const proyectos = await getCollection('proyectos');
const destacados = proyectos
  .filter((p: Proyecto) => p.data.destacado)
  .sort((a: Proyecto, b: Proyecto) => (a.data.orden ?? 99) - (b.data.orden ?? 99))
  .slice(0, 3);
---

<BaseLayout
  title="INACONS | Empresa Constructora en Perú"
  description="Empresa constructora peruana con más de 15 años en obras civiles, infraestructura, electromecánica y consultoría a nivel nacional."
>
  <!-- Preload LCP — solo en home donde esta imagen es el elemento visual principal -->
  <link slot="head" rel="preload" as="image" href="/assets/imagenes/image_heroprincipal.webp" fetchpriority="high" />

  <style slot="head">
    /* ── HERO ── */
    .home-hero {
      position: relative;
      width: 100%;
      height: 100vh;
      min-height: 620px;
      display: flex;
      align-items: center;
      overflow: hidden;
    }
    .hero-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(to bottom, rgba(20,23,45,0.30) 0%, rgba(20,23,45,0.92) 100%),
        linear-gradient(110deg, rgba(20,23,45,0.85) 0%, rgba(27,82,120,0.35) 60%, transparent 100%);
    }
    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
      padding: 0 40px;
    }
    .home-hero h1 {
      font-family: 'Montserrat', sans-serif;
      font-size: clamp(2.2rem, 5vw, 3.8rem);
      font-weight: 700;
      text-transform: uppercase;
      line-height: 1.1;
      margin-bottom: 28px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      letter-spacing: var(--ls-tight);
    }
    .hero-line {
      display: flex;
      align-items: baseline;
      gap: 14px;
      flex-wrap: wrap;
    }
    .word.fixed   { color: rgba(255,255,255,0.68); font-weight: 300; letter-spacing: var(--ls-label); }
    .word.highlight { color: #fff; font-weight: 800; letter-spacing: var(--ls-tight); }
    .word.highlight.completed {
      background: linear-gradient(transparent 84%, rgba(27,82,120,0.40) 84%);
    }
    /* Ghost reserva el espacio final desde el inicio — sin CLS */
    .word.typewriter {
      position: relative;
      display: inline-block;
    }
    .tw-ghost {
      visibility: hidden;
      user-select: none;
      pointer-events: none;
    }
    .tw-typed {
      position: absolute;
      left: 0;
      top: 0;
      white-space: nowrap;
      color: inherit;
    }
    .word.typewriter.typing .tw-typed::after {
      content: '|';
      color: rgba(255,255,255,0.55);
      animation: blink .5s infinite;
      margin-left: 2px;
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0; }
    }
    .hero-content > p {
      font-size: clamp(0.95rem, 1.6vw, 1.1rem);
      color: rgba(255,255,255,0.68);
      margin-bottom: 36px;
      max-width: 500px;
      font-weight: 300;
      letter-spacing: 0.2px;
    }
    .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

    /* ── INDICADORES ── */
    .hero-indicators {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      z-index: 3;
      background: var(--c-primary);
      border-top: 1px solid rgba(27,82,120,0.5);
    }
    .indicators-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 40px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    }
    .indicator {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 26px 16px;
      border-right: 1px solid rgba(255,255,255,0.07);
      position: relative;
      overflow: hidden;
      transition: background .28s ease;
    }
    .indicator::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 2px;
      background: var(--c-accent);
      transition: width .35s ease;
    }
    .indicator:hover::after { width: 52%; }
    .indicator:last-child { border-right: none; }
    .indicator:hover { background: rgba(255,255,255,0.04); }
    .indicator-icon { color: rgba(255,255,255,0.28); margin-bottom: 10px; }
    .indicator-number {
      font-size: clamp(2rem, 4vw, 2.8rem);
      font-weight: 800;
      color: #fff;
      line-height: 1;
      letter-spacing: var(--ls-tight);
    }
    .indicator-text {
      font-size: var(--fs-xs);
      color: rgba(255,255,255,0.55);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-top: 4px;
      text-align: center;
    }

    /* ── ABOUT (Bechtel-style 2-col) ── */
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 88px;
      align-items: center;
    }
    .about-img-frame {
      position: relative;
      height: 540px;
    }
    .about-img-frame::before {
      content: '';
      position: absolute;
      top: -14px; left: -14px; right: 14px; bottom: 14px;
      border: 2px solid rgba(217,130,43,0.40);
      z-index: 0;
    }
    .about-img-frame img {
      position: relative;
      z-index: 1;
      width: 100%; height: 100%;
      object-fit: cover;
      object-position: center 20%;
    }
    .about-years-badge {
      position: absolute;
      bottom: -18px; right: -18px;
      z-index: 2;
      background: var(--c-primary);
      padding: 20px 24px;
      min-width: 112px;
      text-align: center;
    }
    .badge-num {
      display: block;
      font-family: 'Montserrat', sans-serif;
      font-size: var(--fs-display);
      font-weight: 800;
      letter-spacing: var(--ls-tight);
      line-height: 1;
      color: var(--c-accent);
    }
    .badge-text {
      display: block;
      font-size: var(--fs-2xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: rgba(255,255,255,0.55);
      margin-top: 6px;
      line-height: 1.45;
    }
    .about-content { display: flex; flex-direction: column; }
    .about-content .sh-label { margin-bottom: 14px; }
    .about-heading {
      font-family: 'Montserrat', sans-serif;
      font-size: clamp(1.75rem, 2.8vw, 2.4rem);
      font-weight: 700;
      color: var(--c-primary);
      line-height: 1.18;
      margin: 0 0 20px;
    }
    .about-divider {
      width: 44px; height: 3px;
      background: var(--c-accent);
      margin-bottom: 22px;
    }
    .about-body-text {
      font-size: var(--fs-md);
      color: rgba(20,23,45,0.68);
      line-height: 1.78;
      margin: 0 0 14px;
    }
    .about-kpi-row {
      display: flex;
      border-top: 1px solid rgba(20,23,45,0.09);
      border-bottom: 1px solid rgba(20,23,45,0.09);
      padding: 22px 0;
      margin: 22px 0 32px;
    }
    .about-kpi {
      flex: 1;
      padding-right: 24px;
      border-right: 1px solid rgba(20,23,45,0.09);
    }
    .about-kpi:last-child { border-right: none; padding-right: 0; padding-left: 24px; }
    .about-kpi:first-child { padding-left: 0; }
    .about-kpi-num {
      display: block;
      font-family: 'Montserrat', sans-serif;
      font-size: clamp(1.6rem, 2.4vw, 2rem);
      font-weight: 800;
      color: var(--c-primary);
      letter-spacing: var(--ls-tight);
      line-height: 1;
    }
    .about-kpi-label {
      display: block;
      font-size: var(--fs-2xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: rgba(20,23,45,0.42);
      margin-top: 5px;
    }

    /* ── REGIONAL GRID ── */
    .regional-grid {
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      gap: 80px;
      align-items: center;
    }
    .regional-map-wrap { display: flex; justify-content: center; }
    .peru-map {
      max-width: 260px;
      width: 100%;
      filter: drop-shadow(0 6px 20px rgba(20,23,45,0.10));
    }

    /* ── INFO CAROUSEL ── */
    .info-slide-inner {
      display: flex;
      flex-direction: column;
      height: 480px;
      border-radius: 0 !important;
      border: none !important;
      box-shadow: 0 4px 24px rgba(20,23,45,0.08) !important;
    }
    .info-slide-image {
      width: 100%;
      height: 260px;
      overflow: hidden;
      flex-shrink: 0;
      position: relative;
    }
    .info-slide-image img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .info-slide-content {
      flex: 1;
      padding: 40px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      justify-content: center;
      background: var(--c-primary) !important;
      position: relative;
    }
    .info-slide-content::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 3px; height: 100%;
      background: var(--c-secondary);
    }
    .info-carousel-title {
      font-size: clamp(1.5rem, 2.5vw, 2rem);
      font-weight: 700;
      line-height: 1.2;
      margin: 0;
      color: #fff !important;
    }
    .info-carousel-description {
      font-size: var(--fs-md);
      line-height: 1.75;
      margin: 0;
      color: rgba(255,255,255,0.68) !important;
    }
    .info-carousel-swiper .swiper-button-next,
    .info-carousel-swiper .swiper-button-prev {
      background: rgba(255,255,255,0.10) !important;
      color: #fff !important;
    }
    .info-carousel-swiper .swiper-button-next:hover,
    .info-carousel-swiper .swiper-button-prev:hover {
      background: var(--c-secondary) !important;
    }
    .info-carousel-swiper .swiper-pagination-bullet {
      background: rgba(255,255,255,0.30) !important;
      opacity: 1 !important;
    }
    .info-carousel-swiper .swiper-pagination-bullet-active {
      background: #fff !important;
    }

    /* Desktop — lado a lado */
    @media (min-width: 769px) {
      .info-slide-inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        height: 480px;
      }
      .info-slide-image {
        height: 100%;
      }
      .info-slide-content {
        padding: 40px;
      }
    }

    /* ── CLIENTES SCROLL ── */
    .clients-track-wrap {
      overflow: hidden;
      mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    }
    .clients-track {
      display: flex;
      width: max-content;
      animation: clientsScroll 30s linear infinite;
    }
    .clients-track:hover { animation-play-state: paused; }
    @keyframes clientsScroll {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
    .client-logo-item {
      flex: 0 0 158px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 18px 22px;
      border-right: 1px solid var(--c-border-light);
      filter: grayscale(100%);
      opacity: 0.48;
      transition: filter .24s ease, opacity .24s ease;
    }
    .client-logo-item:hover { filter: grayscale(0%); opacity: 1; }
    .client-logo-item img { max-height: 40px; max-width: 108px; object-fit: contain; }

    /* ── CTA BAND ── */
    .cta-band { background: var(--c-primary); padding: 88px 0; }
    .cta-band .sh-label { color: rgba(255,255,255,0.70); }
    .cta-band .sh-label::before,
    .cta-band .sh-label::after { background: rgba(255,255,255,0.25); }
    .cta-band .sh-title { color: #fff; }
    .cta-band .sh-desc  { color: rgba(255,255,255,0.62); }

    /* ── CTA ACTIONS ── */
    .cta-actions {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 40px;
    }

    /* ── EYEBROW ── */
    .hero-eyebrow {
      font-size: var(--fs-2xs);
      font-weight: 600;
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--c-accent);
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .hero-eyebrow::before {
      content: '';
      display: inline-block;
      width: 28px;
      height: 1.5px;
      background: var(--c-accent);
      flex-shrink: 0;
    }

    /* ── SCROLL HINT ── */
    .scroll-hint {
      position: absolute;
      bottom: 168px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 4;
      color: rgba(255,255,255,0.55);
      animation: scrollBounce 1.8s ease-in-out infinite;
      cursor: pointer;
    }
    .scroll-hint svg { display: block; }
    @keyframes scrollBounce {
      0%, 100% { transform: translateX(-50%) translateY(0);   opacity: 0.55; }
      50%       { transform: translateX(-50%) translateY(8px); opacity: 0.90; }
    }

    /* ── WORD CYCLE ── */
    .hero-cycle {
      position: relative;
      display: inline-block;
      overflow: hidden;
      vertical-align: bottom;
    }
    .cycle-ghost {
      visibility: hidden;
      user-select: none;
      pointer-events: none;
      font-weight: 800;
      letter-spacing: var(--ls-tight);
    }
    .cycle-word {
      position: absolute;
      left: 0;
      top: 0;
      color: #fff;
      font-weight: 800;
      letter-spacing: var(--ls-tight);
      white-space: nowrap;
      opacity: 0;
      transform: translateY(70%);
      animation: cycleWord 6s ease-in-out infinite;
    }
    .cycle-word:nth-child(2) { animation-delay: -0.5s; }
    .cycle-word:nth-child(3) { animation-delay:  1.5s; }
    .cycle-word:nth-child(4) { animation-delay:  3.5s; }
    @keyframes cycleWord {
      0%           { opacity: 0; transform: translateY(70%);  animation-timing-function: ease-out; }
      8.33%        { opacity: 1; transform: translateY(0);    animation-timing-function: ease;     }
      25%          { opacity: 1; transform: translateY(0);    animation-timing-function: ease-in;  }
      33.33%       { opacity: 0; transform: translateY(-55%); animation-timing-function: step-start; }
      33.34%, 100% { opacity: 0; transform: translateY(70%);  }
    }

    /* ── PAUSA VIDEO ── */
    .hero-pause-btn {
      position: absolute;
      right: 40px;
      bottom: 168px;
      z-index: 4;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255,255,255,0.10);
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 50%;
      color: rgba(255,255,255,0.65);
      cursor: pointer;
      transition: background var(--t), color var(--t), border-color var(--t);
    }
    .hero-pause-btn:hover {
      background: rgba(255,255,255,0.22);
      color: #fff;
      border-color: rgba(255,255,255,0.40);
    }
    /* icon-play initial state se maneja por JS en initHeroPause */

    /* Accesibilidad: ocultar video y mostrar imagen estática para usuarios con preferencia de movimiento reducido */
    @media (prefers-reduced-motion: reduce) {
      .hero-video { display: none; }
      .home-hero {
        background-image: url('/assets/imagenes/image_heroprincipal.webp');
        background-size: cover;
        background-position: center;
      }
      .cycle-word           { animation: none; opacity: 0; }
      .cycle-word:nth-child(2) { opacity: 1; transform: translateY(0); }
      .scroll-hint          { animation: none; opacity: 0.55; }
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 768px) {
      /* Hero */
      .home-hero {
        min-height: 100svh;
        align-items: center;
      }
      .hero-eyebrow   { display: none; }
      .scroll-hint    { display: none; }
      .hero-pause-btn { display: none; }
      .hero-content {
        padding: 80px 20px 160px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .home-hero h1 {
        text-align: center;
        font-size: clamp(1.35rem, 6.5vw, 1.9rem);
        width: 100%;
        padding: 0 4px;
        letter-spacing: -0.3px;
      }
      .hero-line {
        flex-wrap: nowrap;
        justify-content: center;
        gap: 8px;
        width: 100%;
        overflow: hidden;
      }
      .word.fixed,
      .word.highlight {
        white-space: nowrap;
        font-size: inherit;
      }
      .hero-content > p {
        text-align: center;
        margin-left: auto;
        margin-right: auto;
        max-width: 100%;
      }
      .hero-actions {
        justify-content: center;
        flex-direction: column;
        width: 100%;
      }
      .hero-actions .btn {
        width: 100%;
        justify-content: center;
      }

      /* About */
      .about-grid { grid-template-columns: 1fr; gap: 36px; }
      .about-img-wrap { height: 280px; }
      .about-img-wrap::before { display: none; }

      /* Regional */
      .regional-grid { grid-template-columns: 1fr; gap: 36px; }

      /* Indicadores */
      .indicators-container { grid-template-columns: repeat(2, 1fr); }

      /* Carrusel */
      .info-slide-inner {
        height: auto;
        min-height: 0;
      }
      .info-slide-image {
        height: 200px;
      }
      .info-slide-content {
        padding: 28px 24px;
      }
      .info-carousel-title {
        font-size: var(--fs-xl);
      }
      .info-carousel-description {
        font-size: var(--fs-base);
      }
      .info-carousel-swiper .swiper-button-next,
      .info-carousel-swiper .swiper-button-prev {
        top: 110px;
      }

      /* CTA */
      .cta-actions {
        flex-direction: column;
        align-items: center;
        width: 100%;
      }
      .cta-actions .btn {
        width: 100%;
        max-width: 320px;
        justify-content: center;
      }
    }

    /* ── SERVICES SHOWCASE ── */
    .services-showcase {
      background: var(--c-primary);
      padding: 80px 0 0;
    }
    .services-showcase .sh-label        { color: rgba(255,255,255,0.55); }
    .services-showcase .sh-label::before,
    .services-showcase .sh-label::after  { background: rgba(255,255,255,0.20); }
    .services-showcase .sh-title         { color: #fff; }
    .services-showcase .sh-desc          { color: rgba(255,255,255,0.58); }
    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
      margin-top: 56px;
      background: rgba(255,255,255,0.07);
    }
    .service-card {
      position: relative;
      overflow: hidden;
      aspect-ratio: 4/3;
      display: block;
      text-decoration: none;
    }
    .service-card img {
      position: absolute;
      inset: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform 0.65s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .service-card:hover img { transform: scale(1.07); }
    .svc-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to top,
        rgba(20,23,45,0.93) 0%,
        rgba(20,23,45,0.42) 45%,
        rgba(20,23,45,0.12) 100%
      );
      transition: background 0.4s ease;
      z-index: 1;
    }
    .service-card:hover .svc-overlay {
      background: linear-gradient(
        to top,
        rgba(20,23,45,0.97) 0%,
        rgba(20,23,45,0.62) 50%,
        rgba(20,23,45,0.22) 100%
      );
    }
    .svc-body {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      z-index: 2;
      padding: 28px 32px;
    }
    .svc-icon {
      color: var(--c-accent);
      margin-bottom: 10px;
      opacity: 0.88;
      transition: opacity 0.3s, transform 0.3s;
    }
    .service-card:hover .svc-icon { opacity: 1; transform: translateY(-2px); }
    .svc-title {
      font-size: var(--fs-lg);
      font-weight: 700;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin: 0 0 6px;
    }
    .svc-desc {
      font-size: var(--fs-sm);
      color: rgba(255,255,255,0.72);
      line-height: 1.55;
      margin: 0;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 0.4s ease, opacity 0.35s ease;
    }
    .service-card:hover .svc-desc { max-height: 64px; opacity: 1; }
    .svc-arrow {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      margin-top: 10px;
      font-size: var(--fs-2xs);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: var(--ls-label);
      color: var(--c-accent);
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 0.35s ease 0.05s, opacity 0.35s ease 0.05s;
    }
    .service-card:hover .svc-arrow { max-height: 30px; opacity: 1; }

    /* ── PROYECTOS DESTACADOS ── */
    .projects-showcase {
      background: var(--c-primary);
      padding: 88px 0 0;
    }
    .projects-showcase .sh-label { color: var(--c-accent); opacity: 1; }
    .projects-showcase .sh-title { color: #fff; }
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 3px;
      margin-top: 52px;
    }
    .project-card {
      position: relative;
      height: 500px;
      overflow: hidden;
      display: block;
      text-decoration: none;
    }
    .project-card img {
