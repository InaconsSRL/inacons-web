---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import MediaCard from '../components/MediaCard.astro';
import Icono from '../components/Icono.astro';
import { serviciosPorMenu } from '../lib/servicios';
import { BROCHURE, CIFRAS, PROYECTOS_POR_CIUDAD } from '../data/empresa';
import imagenHero from '../assets/imagenes/image_heroprincipal.webp';
import imagenNosotros from '../assets/imagenes/image_nosotros.webp';

const servicios = await serviciosPorMenu();

const destacados = (await getCollection('proyectos'))
  .filter((p) => p.data.destacado)
  .sort((a, b) => (a.data.orden ?? 99) - (b.data.orden ?? 99))
  .slice(0, 3);

const LOGOS = import.meta.glob<{ default: ImageMetadata }>('../assets/imagenes/clientes/*', { eager: true });
const logo = (archivo: string) => LOGOS[`../assets/imagenes/clientes/${archivo}`].default;
// Los clientes del brochure, en su orden. Uno sin logo en
// src/assets/imagenes/clientes/ se muestra con su nombre hasta que llegue el archivo.
const CLIENTES: { nombre: string; imagen?: ImageMetadata }[] = [
  { nombre: 'Electroperú',            imagen: logo('cliente_electroperu.png') },
  { nombre: 'Electrocentro',          imagen: logo('cliente_electrocentro.png') },
  { nombre: 'Kallpa',                 imagen: logo('kallpa.png') },
  { nombre: 'Sedapal',                imagen: logo('cliente_sedapal.png') },
  { nombre: 'Grupo Centenario',       imagen: logo('cliente_grupocentenario.png') },
  { nombre: 'ElectroDunas',           imagen: logo('cliente_electrodunas.png') },
  { nombre: 'Los Portales',           imagen: logo('cliente_losportales.png') },
  { nombre: 'Activos Mineros S.A.C.' },
  { nombre: 'Pluz' },
  { nombre: 'Luz del Sur',            imagen: logo('cliente_luzdelsur.png') },
];

const cifrasHero = [CIFRAS.experiencia, CIFRAS.superficie, CIFRAS.inversion, CIFRAS.trabajadores];
const ciudadesMapa = JSON.stringify(PROYECTOS_POR_CIUDAD.map(({ idMapa, peso }) => ({ idMapa, peso })));
---

<BaseLayout
  title="INACONS | Constructora e ingeniería en Perú"
  description="Empresa constructora peruana con más de 15 años en obras civiles, infraestructura, electromecánica, minería y consultoría. Oficinas en Lima y Huancayo."
>
<style slot="head">
    /* ── HERO ── */
    .home-hero {
      position: relative;
      width: 100%;
      height: 100vh;
      min-height: 620px;
      display: flex;
      align-items: center;
      overflow: hidden;
    }
    /*  El top-bar y el header son fixed (112 px a partir de 768) y el hero ocupa
        toda la pantalla por detrás. Sin este espacio, el contenido centrado en
        100vh se montaba bajo la cabecera con ventanas de 720 px de alto: el
        eyebrow quedaba 31 px metido bajo el borde del header. */
    @media (min-width: 768px) {
      .home-hero { padding-top: var(--sp-l4); }
    }
    /*  El póster es un <img> y no el atributo poster del vídeo: así sale con
        srcset (en móvil baja 768 px y no 1920) y es la imagen LCP del home, con
        prioridad alta. El vídeo va encima y es transparente hasta que carga
        (solo en escritorio, ver initHeroVideo). */
    .hero-poster,
    .hero-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(to bottom, color-mix(in srgb, var(--c-primary) 30%, transparent) 0%, color-mix(in srgb, var(--c-primary) 92%, transparent) 100%),
        linear-gradient(110deg, color-mix(in srgb, var(--c-primary) 85%, transparent) 0%, color-mix(in srgb, var(--c-secondary) 35%, transparent) 60%, transparent 100%);
    }
    /*  Todo en una columna: mensaje y, debajo, las cifras en banda. Al costado
        competían con el titular por el ancho y lo obligaban a partirse antes de
        tiempo; en banda el titular puede crecer (--fs-hero) y las cifras quedan
        integradas en el layout y no flotando junto a él. */
    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
      padding: 0 var(--sp-l1);
      display: flex;
      flex-direction: column;
      gap: var(--sp-l1);
    }
    .hero-main { min-width: 0; }
    .hero-stats { width: 100%; }
    /*  La banda del sistema da 24 px arriba y abajo a cada cifra; en el hero,
        que tiene que caber en una pantalla de 720 px, bastan 20. */
    .hero-stat { padding-top: var(--sp-5); padding-bottom: var(--sp-5); }

    .home-hero h1 {
      font-family: var(--font-ui);
      font-size: var(--fs-hero);
      font-weight: var(--fw-semibold);
      text-transform: uppercase;
      line-height: 1.1;
      margin-bottom: var(--sp-6);
      display: flex;
      flex-direction: column;
      gap: var(--sp-2);
      letter-spacing: var(--ls-tight);
    }
    .hero-line {
      display: flex;
      align-items: baseline;
      gap: var(--sp-3);
      flex-wrap: wrap;
    }
    .word.fixed   { color: var(--c-on-dark-2); font-weight: var(--fw-normal); letter-spacing: var(--ls-wide); }
    .word.highlight { color: var(--c-text-white); font-weight: var(--fw-display); letter-spacing: var(--ls-tight); }
    /* Ghost reserva el espacio final desde el inicio — sin CLS */
    .word.typewriter {
      position: relative;
      display: inline-block;
    }
    .tw-ghost {
      visibility: hidden;
      user-select: none;
      pointer-events: none;
    }
    .tw-typed {
      position: absolute;
      left: 0;
      top: 0;
      white-space: nowrap;
      color: inherit;
    }
    /* @keyframes blink vive en design-system.css */
    .word.typewriter.typing .tw-typed::after {
      content: '|';
      color: var(--c-on-dark-3);
      animation: blink .5s infinite;
      margin-left: 2px;
    }
    .hero-desc {
      font-size: var(--fs-lg);
      color: var(--c-on-dark-2);
      margin-bottom: var(--sp-6);
      max-width: 560px;
      font-weight: var(--fw-normal);
      letter-spacing: var(--ls-wide);
    }
    .hero-actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; }

    /* ── ABOUT (Bechtel-style 2-col) ── */
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-l4);
      align-items: center;
    }
    .about-img-frame {
      height: 540px;
    }
    .about-img-frame img {
      width: 100%; height: 100%;
      object-fit: cover;
      object-position: center 20%;
    }
    .about-content { display: flex; flex-direction: column; }
    .about-body-text {
      font-size: var(--fs-md);
      color: var(--c-text-body);
      line-height: 1.78;
      margin: 0 0 var(--sp-3);
    }
    /* ── CLIENTES SCROLL ── */
    .clients-track-wrap {
      overflow: hidden;
      /* #000 no es un color de marca: en una máscara solo cuenta el canal alfa,
         así que cualquier color opaco da el mismo desvanecido en los bordes. */
      mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    }
    /* @keyframes clientsScroll vive en design-system.css */
    .clients-track {
      display: flex;
      width: max-content;
      animation: clientsScroll 30s linear infinite;
    }
    .clients-track:hover { animation-play-state: paused; }
    /*  Los logos van en gris donde el hover puede devolverles el color; en
        táctil no hay hover, así que se muestran a color de entrada. */
    .client-logo-item {
      flex: 0 0 158px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--sp-4) var(--sp-5);
      border-right: 1px solid var(--c-border-light);
      filter: grayscale(100%);
      opacity: 0.85;
      transition: filter var(--t), opacity var(--t);
    }
    .client-logo-item:hover { filter: grayscale(0%); opacity: 1; }

    @media (hover: none) {
      .client-logo-item { filter: none; opacity: 1; }
    }

    /*  Pausa del carrusel — WCAG 2.2.2: un movimiento automático de más de 5 s
        tiene que poder detenerse por teclado y en táctil, no solo con hover. */
    .clients-controls {
      display: flex;
      justify-content: center;
      margin-top: var(--sp-5);
    }

    .client-logo-item img { max-height: 40px; max-width: 108px; object-fit: contain; }
    .client-logo-nombre {
      font-size: var(--fs-sm);
      font-weight: var(--fw-bold);
      color: var(--c-text-heading);
      text-align: center;
      line-height: 1.2;
    }

    /* ── EYEBROW ── */
    .hero-eyebrow {
      font-size: var(--fs-2xs);
      font-weight: var(--fw-semibold);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--c-accent);
      margin-bottom: var(--sp-5);
      display: flex;
      align-items: center;
      gap: var(--sp-2);
    }
    .hero-eyebrow::before {
      content: '';
      display: inline-block;
      width: 28px;
      height: 1.5px;
      background: var(--c-accent);
      flex-shrink: 0;
    }

    /* ── SCROLL HINT ── */
    .scroll-hint {
      position: absolute;
      bottom: var(--sp-l1);
      left: 50%;
      transform: translateX(-50%);
      z-index: 4;
      color: var(--c-on-dark-3);
      animation: scrollBounce 1.8s ease-in-out infinite;
      cursor: pointer;
    }
    @keyframes scrollBounce {
      0%, 100% { transform: translateX(-50%) translateY(0);   opacity: 0.55; }
      50%       { transform: translateX(-50%) translateY(8px); opacity: 0.90; }
    }

    /* ── PAUSA VIDEO ── */
    .hero-pause-btn {
      position: absolute;
      right: var(--sp-l1);
      bottom: var(--sp-l1);
      z-index: 4;
    }

    /* Accesibilidad: todo lo que se mueve solo, quieto. Bloque unico. */
    @media (prefers-reduced-motion: reduce) {
      .scroll-hint   { animation: none; opacity: 0.55; }
      .clients-track { animation: none; }
    }

    /* ── SERVICES SHOWCASE ── */
    /*  El fondo oscuro y los .sh-* sobre oscuro los pone .sec--dark. El ancho
        de las tarjetas lo pone .cards-row del sistema: sus hijos son MediaCard
        y un selector de esta página no los alcanzaría (regla 1). Servicios y
        proyectos comparten ancho de columna y proporción para medir igual. */
    .services-showcase {
      padding: var(--section-py) 0;
    }

    .cards-row { margin-top: var(--sp-l2); }
    .services-grid { background: var(--c-surface-dark-2); }

    /* ── PROYECTOS DESTACADOS ── */
    .projects-showcase {
      padding: var(--section-py) 0;
    }

    /* ── COVERAGE MAP ── */
    .coverage-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-l3);
      align-items: center;
    }
    /* Mapa SVG interactivo por departamentos */
    .map-wrap {
      display: flex;
      justify-content: center;
      align-items: center;
    }
    #peruMapContainer {
      width: 100%;
      max-width: 280px;
    }
    /* El SVG se inyecta vía JS — su tamaño y su sombra van con element.style
       en main.ts, no acá: Astro le pega data-astro-cid a este selector pero
       el SVG inyectado nunca lo lleva, así que una regla acá nunca engancha. */
    .map-stats-title {
      font-size: var(--fs-xs);
      font-weight: var(--fw-semibold);
      text-transform: uppercase;
      letter-spacing: var(--ls-label);
      color: var(--c-text-muted);
      margin-bottom: var(--sp-5);
    }
    .map-stat {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--sp-4);
      padding: var(--sp-3) 0;
      border-bottom: 1px solid var(--c-border-light);
    }
    .map-stat:last-child { border-bottom: none; }
    .map-stat-city {
      font-size: var(--fs-md);
      font-weight: var(--fw-semibold);
      color: var(--c-primary);
    }
    .map-stat-count {
      font-size: var(--fs-md);
      font-weight: var(--fw-display);
      /* Son las cifras de proyectos por ciudad: el dato del bloque.
         --c-accent sobre claro da 2.93:1 y no pasa AA. --c-accent-ink
         conserva el naranja y llega a 5.33:1 sobre --c-bg-muted, que
         es el fondo de esta seccion. */
      color: var(--c-accent-ink);
      letter-spacing: var(--ls-tight);
    }

    @media (max-width: 767.98px) {
      /* Hero */
      .home-hero {
        min-height: 100svh;
        align-items: center;
      }
      /*  El eyebrow se mantiene en móvil: es lo único de la primera pantalla
          que nombra el rubro (el H1 es el eslogan). */
      .scroll-hint    { display: none; }
      .hero-content {
        padding: var(--sp-l3) var(--sp-5);
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .hero-eyebrow { justify-content: center; }
      .home-hero h1 {
        text-align: center;
        width: 100%;
        letter-spacing: var(--ls-tight);
      }
      /*  Nunca recortar el titular: --fs-hero lo ajusta y el wrap es la red de
          seguridad para "CONSTRUIMOS CONFIANZA" en 360px. */
      .hero-line {
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--sp-2);
        width: 100%;
      }
      .word.fixed,
      .word.highlight {
        white-space: nowrap;
        font-size: inherit;
      }
      .hero-desc {
        text-align: center;
        margin-left: auto;
        margin-right: auto;
        max-width: 100%;
      }
      .hero-actions {
        justify-content: center;
        flex-direction: column;
        width: 100%;
      }
      .hero-actions .btn {
        width: 100%;
        justify-content: center;
      }
      /*  Las cifras bajan en 2×2 (lo hace .stat-band). Un poco más chicas que
          en escritorio: dos columnas de 187 px no admiten "+100MM" a 32 px. */
      .hero-stats .stat-num { font-size: var(--fs-2xl); }

      .cards-row { margin-top: var(--sp-7); }
      .about-grid { grid-template-columns: 1fr; gap: var(--sp-l2); }
      .about-img-frame { height: 360px; }
      .coverage-grid { grid-template-columns: 1fr; gap: var(--sp-7); }
      #peruMapContainer { max-width: 220px; }
    }
  </style>

  <!--
    ORDEN DEL HOME — claro y oscuro alternados (referencia Bechtel): cada
    sección se apoya en el contraste de la anterior y Clientes cierra en claro.
  -->
  <section class="home-hero">
    <!-- Sin src: main.ts lo carga solo en escritorio. En móvil basta el póster. -->
    <Image class="hero-poster" src={imagenHero} alt="" quality={70} widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    <video class="hero-video" muted loop playsinline preload="none" data-src="/assets/videos/hero.mp4" aria-hidden="true"></video>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-main">
        <p class="hero-eyebrow">Ingeniería &amp; Construcción</p>
        <h1 aria-label="Construimos confianza, innovamos espacios, trascendemos juntos">
          <span class="hero-line" aria-hidden="true">
            <span class="word fixed">CONSTRUIMOS</span>
            <span class="word highlight typewriter" data-text="CONFIANZA"><span class="tw-ghost">CONFIANZA</span><span class="tw-typed"></span></span>
          </span>
          <span class="hero-line" aria-hidden="true">
            <span class="word highlight typewriter" data-text="INNOVAMOS"><span class="tw-ghost">INNOVAMOS</span><span class="tw-typed"></span></span>
            <span class="word fixed">ESPACIOS</span>
          </span>
          <span class="hero-line" aria-hidden="true">
            <span class="word fixed">TRASCENDEMOS</span>
            <span class="word highlight typewriter" data-text="JUNTOS"><span class="tw-ghost">JUNTOS</span><span class="tw-typed"></span></span>
          </span>
        </h1>
        <p class="hero-desc">Más de 15 años de experiencia en ingeniería y construcción al servicio del Perú.</p>
        <div class="hero-actions">
          <a href="/proyectos/" class="btn btn-primary btn-lg">Ver Proyectos</a>
          <a href={BROCHURE} target="_blank" rel="noopener" class="btn btn-outline-light btn-lg" data-astro-prefetch="false">Descargar Brochure</a>
        </div>
      </div>

      <!-- Cifras del brochure (src/data/empresa.ts). data-counter es el contrato con main.ts. -->
      <div class="hero-stats stat-band stat-band--oscuro">
        {cifrasHero.map((c) => (
          <div class="hero-stat card--stat card--stat-lg card--stat-oscuro">
            <span class="stat-num" data-counter={c.valor} data-prefix={c.prefijo} data-suffix={c.sufijo}>{c.prefijo}{c.valor}{c.sufijo}</span>
            <span class="stat-label">{c.rotulo}</span>
          </div>
        ))}
      </div>
    </div>
    <button type="button" class="btn-icono hero-pause-btn" id="heroPauseBtn" aria-label="Pausar video" hidden>
      <Icono nombre="pausa" tam={14} class="icon-pause" />
      <Icono nombre="reproducir" tam={14} class="icon-play" />
    </button>
    <div class="scroll-hint" aria-hidden="true">
      <Icono nombre="chevron-abajo" tam={28} trazo={1.5} />
    </div>
  </section>

  <section class="sec sec--white">
    <div class="container">
      <div class="sh sh--medium" data-aos="fade-up">
        <p class="sh-label">Quiénes somos</p>
        <h2 class="sh-title">Construimos los proyectos que mueven al Perú</h2>
      </div>

      <div class="about-grid">
        <div class="about-img-frame">
          <Image quality={70} src={imagenNosotros} alt="Equipo INACONS en obra" widths={[480, 640, 960]} sizes="(min-width: 768px) 50vw, 100vw" />
        </div>

        <div class="about-content">
          <p class="about-body-text">Somos una empresa peruana de ingeniería y construcción con más de 15 años ejecutando proyectos en toda la geografía nacional — desde la costa del Pacífico hasta la alta sierra.</p>
          <p class="about-body-text">Trabajamos con empresas líderes del sector público y privado, aplicando las más altas normas de calidad, seguridad y metodología BIM en cada obra.</p>
          <a href="/nosotros/" class="btn btn-primary">Conoce nuestra historia</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec--dark services-showcase">
    <div class="container">
      <div class="sh sh--row" data-aos="fade-up" data-aos-duration="700">
        <div class="sh-text">
          <p class="sh-label">Nuestras Especialidades</p>
          <h2 class="sh-title">Lo que construimos</h2>
          <p class="sh-desc">Seis líneas de servicio integradas para proyectos de cualquier escala, en cualquier región del Perú.</p>
        </div>
        <a href="/servicios/" class="btn btn-outline-light">Ver todos los servicios</a>
      </div>
      <div class="cards-row services-grid">
        {servicios.map((s) => (
          <MediaCard href={`/servicios/${s.id}/`} image={s.data.imagen} alt="" title={s.data.titulo} desc={s.data.resumen} ratioMobile="3/2" />
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--muted">
    <div class="container">
      <div class="sh sh--medium" data-aos="fade-up">
        <p class="sh-label">Presencia nacional</p>
        <h2 class="sh-title">Dónde construimos</h2>
        <p class="sh-desc">Desde la costa hasta la sierra, operamos en las zonas de mayor actividad económica del país.</p>
      </div>

      <div class="coverage-grid" data-aos="fade-up">
        <!--
          #peruMapContainer NUNCA en display:none: initCoverageMap mide con
          getBBox() y sin caja devuelve ceros — los pines desaparecen sin error.
          Ocultar por opacidad (data-aos) es seguro; por display no.
        -->
        <div class="map-wrap">
          <div id="peruMapContainer" data-ciudades={ciudadesMapa} data-etiqueta="Mapa de cobertura de INACONS en el Perú"></div>
        </div>

        <div class="map-stats">
          <p class="map-stats-title">Proyectos por ciudad</p>
          {PROYECTOS_POR_CIUDAD.map((c) => (
            <div class="map-stat">
              <span class="map-stat-city">{c.ciudad}</span>
              <span class="map-stat-count">+{c.proyectos}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {destacados.length > 0 && (
    <section class="sec--dark projects-showcase">
      <div class="container">
        <div class="sh sh--row" data-aos="fade-up" data-aos-duration="700">
          <div class="sh-text">
            <p class="sh-label">Proyectos destacados</p>
            <h2 class="sh-title">Nuestra huella en el Perú</h2>
          </div>
          <a href="/proyectos/" class="btn btn-outline-light">Ver todos los proyectos</a>
        </div>

        <div class="cards-row projects-grid" data-aos="fade-up" data-aos-duration="800">
          {destacados.map((p) => (
            <MediaCard
              href={`/proyectos/${p.id}/`}
              image={p.data.imagen}
              alt=""
              tag={p.data.categoria}
              title={p.data.titulo}
              meta={`${p.data.ubicacion} · ${p.data.año}`}
              ratioMobile="3/2"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="sec sec--white" id="clientes">
    <div class="container">
      <div class="sh sh--center sh--medium" data-aos="fade-up" data-aos-duration="600">
        <p class="sh-label">Nuestros Clientes</p>
        <h2 class="sh-title">Empresas que confían en nuestra experiencia y calidad</h2>
        <p class="sh-desc">Trabajamos con empresas líderes que valoran la calidad, innovación y compromiso en cada proyecto de construcción.</p>
      </div>
      <div class="clients-track-wrap">
        <!-- La lista va dos veces para el desplazamiento infinito; la copia se oculta a lectores de pantalla. -->
        <div class="clients-track">
          {[false, true].map((copia) => CLIENTES.map((c) => (
            <div class="client-logo-item" aria-hidden={copia ? 'true' : undefined}>
              {c.imagen
                ? <Image quality={70} src={c.imagen} alt={copia ? '' : c.nombre} width={216} loading="lazy" />
                : <span class="client-logo-nombre">{c.nombre}</span>}
            </div>
          )))}
        </div>
      </div>

      <div class="clients-controls">
        <button type="button" class="btn-control" id="clientsPauseBtn" aria-pressed="false">
          <Icono nombre="pausa" tam={12} class="icon-pause" />
          <Icono nombre="reproducir" tam={12} class="icon-play" />
          <span class="clients-pause-label">Pausar</span>
        </button>
      </div>
    </div>
  </section>

  <CtaBand
    label="¿Empezamos?"
    title="Cuéntanos qué necesitas construir"
    description="Revisamos el alcance y te respondemos con una propuesta técnica y un plazo."
    primaryHref="/contacto/"
    primaryLabel="Solicitar propuesta"
    secondaryHref="/proyectos/"
    secondaryLabel="Ver proyectos"
  />

</BaseLayout>
