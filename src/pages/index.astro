---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

type Proyecto = CollectionEntry<'proyectos'>;

// Proyectos destacados para el home
const proyectos = await getCollection('proyectos');
const destacados = proyectos
  .filter((p: Proyecto) => p.data.destacado)
  .sort((a: Proyecto, b: Proyecto) => (a.data.orden ?? 99) - (b.data.orden ?? 99))
  .slice(0, 3);
---

<BaseLayout
  title="INACONS | Empresa Constructora en Perú"
  description="Empresa constructora peruana con más de 15 años en obras civiles, infraestructura, electromecánica y consultoría a nivel nacional."
>
  <!-- Preload LCP — solo en home donde esta imagen es el elemento visual principal -->
  <link slot="head" rel="preload" as="image" href="/assets/imagenes/image_heroprincipal.webp" fetchpriority="high" />

  <style slot="head">
    /* ── HERO ── */
    .home-hero {
      position: relative;
      width: 100%;
      height: 100vh;
      min-height: 620px;
      display: flex;
      align-items: center;
      overflow: hidden;
    }
    .hero-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(to bottom, rgba(20,23,45,0.30) 0%, rgba(20,23,45,0.92) 100%),
        linear-gradient(110deg, rgba(20,23,45,0.85) 0%, rgba(27,82,120,0.35) 60%, transparent 100%);
    }
    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
      padding: 0 var(--sp-l1);
    }
    .home-hero h1 {
      font-family: 'Montserrat', sans-serif;
      font-size: var(--fs-hero);
      font-weight: var(--fw-semibold);
      text-transform: uppercase;
      line-height: 1.1;
      margin-bottom: var(--sp-6);
      display: flex;
      flex-direction: column;
      gap: var(--sp-2);
      letter-spacing: var(--ls-tight);
    }
    .hero-line {
      display: flex;
      align-items: baseline;
      gap: var(--sp-3);
      flex-wrap: wrap;
    }
    .word.fixed   { color: var(--c-on-dark-2); font-weight: var(--fw-normal); letter-spacing: var(--ls-wide); }
    .word.highlight { color: #fff; font-weight: var(--fw-display); letter-spacing: var(--ls-tight); }
    /* Ghost reserva el espacio final desde el inicio — sin CLS */
    .word.typewriter {
      position: relative;
      display: inline-block;
    }
    .tw-ghost {
      visibility: hidden;
      user-select: none;
      pointer-events: none;
    }
    .tw-typed {
      position: absolute;
      left: 0;
      top: 0;
      white-space: nowrap;
      color: inherit;
    }
    /* @keyframes blink vive en design-system.css */
    .word.typewriter.typing .tw-typed::after {
      content: '|';
      color: var(--c-on-dark-3);
      animation: blink .5s infinite;
      margin-left: 2px;
    }
    .hero-content > p {
      font-size: clamp(0.95rem, 1.6vw, 1.1rem);
      color: var(--c-on-dark-2);
      margin-bottom: var(--sp-7);
      max-width: 500px;
      font-weight: var(--fw-normal);
      letter-spacing: 0.2px;
    }
    .hero-actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; }

    /* ── INDICADORES ── */
    .hero-indicators {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      z-index: 3;
      background: var(--c-primary);
      border-top: 1px solid rgba(27,82,120,0.5);
    }
    .indicators-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 var(--sp-l1);
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    }
    .indicator {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: var(--sp-6) var(--sp-4);
      border-right: 1px solid var(--c-surface-dark-2);
      position: relative;
      overflow: hidden;
      transition: background .28s ease;
    }
    .indicator::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 2px;
      background: var(--c-accent);
      transition: width .35s ease;
    }
    .indicator:hover::after { width: 52%; }
    .indicator:last-child { border-right: none; }
    .indicator:hover { background: var(--c-surface-dark-1); }
    .indicator-icon { color: rgba(255,255,255,0.28); margin-bottom: var(--sp-2); }
    .indicator-number {
      font-size: clamp(2rem, 4vw, 2.8rem);
      font-weight: var(--fw-display);
      color: #fff;
      line-height: 1;
      letter-spacing: var(--ls-tight);
    }
    .indicator-text {
      font-size: var(--fs-xs);
      color: var(--c-on-dark-3);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-top: var(--sp-1);
      text-align: center;
    }

    /* ── ABOUT (Bechtel-style 2-col) ── */
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-l4);
      align-items: center;
    }
    .about-img-frame {
      position: relative;
      height: 540px;
    }
    .about-img-frame::before {
      content: '';
      position: absolute;
      top: -14px; left: -14px; right: 14px; bottom: 14px;
      border: 2px solid rgba(217,130,43,0.40);
      z-index: 0;
    }
    .about-img-frame img {
      position: relative;
      z-index: 1;
      width: 100%; height: 100%;
      object-fit: cover;
      object-position: center 20%;
    }
    .about-years-badge {
      position: absolute;
      bottom: -18px; right: -18px;
      z-index: 2;
      background: var(--c-primary);
      padding: var(--sp-5) var(--sp-6);
      min-width: 112px;
      text-align: center;
    }
    .badge-num {
      display: block;
      font-family: 'Montserrat', sans-serif;
      font-size: var(--fs-display);
      font-weight: var(--fw-display);
      letter-spacing: var(--ls-tight);
      line-height: 1;
      color: var(--c-accent);
    }
    .badge-text {
      display: block;
      font-size: var(--fs-2xs);
      font-weight: var(--fw-semibold);
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--c-on-dark-3);
      margin-top: var(--sp-1);
      line-height: 1.45;
    }
    .about-content { display: flex; flex-direction: column; }
    .about-content .sh-label { margin-bottom: var(--sp-3); }
    .about-heading {
      font-family: 'Montserrat', sans-serif;
      font-size: clamp(1.75rem, 2.8vw, 2.4rem);
      font-weight: var(--fw-bold);
      color: var(--c-primary);
      line-height: 1.18;
      margin: 0 0 var(--sp-5);
    }
    .about-divider {
      width: 44px; height: 3px;
      background: var(--c-accent);
      margin-bottom: var(--sp-5);
    }
    .about-body-text {
      font-size: var(--fs-md);
      color: rgba(20,23,45,0.68);
      line-height: 1.78;
      margin: 0 0 var(--sp-3);
    }
    .about-kpi-row {
      display: flex;
      border-top: 1px solid rgba(20,23,45,0.09);
      border-bottom: 1px solid rgba(20,23,45,0.09);
      padding: var(--sp-5) 0;
      margin: var(--sp-5) 0 var(--sp-7);
    }
    .about-kpi {
      flex: 1;
      padding-right: var(--sp-6);
      border-right: 1px solid rgba(20,23,45,0.09);
    }
    .about-kpi:last-child { border-right: none; padding-right: 0; padding-left: var(--sp-6); }
    .about-kpi:first-child { padding-left: 0; }
    .about-kpi-num {
      display: block;
      font-family: 'Montserrat', sans-serif;
      font-size: clamp(1.6rem, 2.4vw, 2rem);
      font-weight: var(--fw-display);
      color: var(--c-primary);
      letter-spacing: var(--ls-tight);
      line-height: 1;
    }
    .about-kpi-label {
      display: block;
      font-size: var(--fs-2xs);
      font-weight: var(--fw-semibold);
      text-transform: uppercase;
      letter-spacing: 1px;
      color: rgba(20,23,45,0.42);
      margin-top: var(--sp-1);
    }
    /* ── CLIENTES SCROLL ── */
    .clients-track-wrap {
      overflow: hidden;
      mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    }
    /* @keyframes clientsScroll vive en design-system.css */
    .clients-track {
      display: flex;
      width: max-content;
      animation: clientsScroll 30s linear infinite;
    }
    .clients-track:hover { animation-play-state: paused; }
    /*
      Enel, Sedapal, Luz del Sur, GE Vernova, Kallpa, Indecopi: es lo
      más persuasivo que tiene la home. Estaba en gris al 48% de
      opacidad, y el color solo volvía con :hover — que en táctil no
      existe. En celular la banda entera era una fila de manchas grises.

      El gris uniforme se conserva en escritorio, donde el hover puede
      devolver el color. En dispositivos sin hover se muestran a color
      de entrada, porque ahí no hay forma de pedirlo.
    */
    .client-logo-item {
      flex: 0 0 158px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--sp-4) var(--sp-5);
      border-right: 1px solid var(--c-border-light);
      filter: grayscale(100%);
      opacity: 0.85;
      transition: filter var(--t), opacity var(--t);
    }
    .client-logo-item:hover { filter: grayscale(0%); opacity: 1; }

    @media (hover: none) {
      .client-logo-item { filter: none; opacity: 1; }
    }

    /*
      Control de pausa del carrusel — WCAG 2.2.2 (nivel A).

      Cualquier movimiento automático que dure más de 5 segundos tiene
      que poder detenerse. La pausa al pasar el mouse no cumple: no es
      alcanzable por teclado y no existe en táctil. El patrón es el
      mismo que ya usa bien el botón de pausa del video del hero.
    */
    .clients-controls {
      display: flex;
      justify-content: center;
      margin-top: var(--sp-5);
    }
    .clients-pause-btn {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-2);
      padding: var(--sp-2) var(--sp-4);
      min-height: 32px;
      background: transparent;
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      color: var(--c-text-muted);
      font-family: var(--font-ui);
      font-size: var(--fs-2xs);
      font-weight: var(--fw-semibold);
      text-transform: uppercase;
      letter-spacing: var(--ls-label);
      cursor: pointer;
      transition: border-color var(--t), color var(--t);
    }
    .clients-pause-btn:hover {
      border-color: var(--c-secondary);
      color: var(--c-secondary);
    }
    .clients-track.is-paused { animation-play-state: paused; }

    .client-logo-item img { max-height: 40px; max-width: 108px; object-fit: contain; }

    /* ── CTA BAND ── */
    .cta-band { background: var(--c-primary); padding: var(--sp-l4) 0; }
    .cta-band .sh-label { color: var(--c-on-dark-2); }
    .cta-band .sh-label::before,
    .cta-band .sh-label::after { background: var(--c-border-dark-strong); }
    .cta-band .sh-title { color: #fff; }
    .cta-band .sh-desc  { color: var(--c-on-dark-3); }

    /* ── CTA ACTIONS ── */
    .cta-actions {
      display: flex;
      gap: var(--sp-4);
      flex-wrap: wrap;
      justify-content: center;
      margin-top: var(--sp-l1);
    }

    /* ── EYEBROW ── */
    .hero-eyebrow {
      font-size: var(--fs-2xs);
      font-weight: var(--fw-semibold);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--c-accent);
      margin-bottom: var(--sp-5);
      display: flex;
      align-items: center;
      gap: var(--sp-2);
    }
    .hero-eyebrow::before {
      content: '';
      display: inline-block;
      width: 28px;
      height: 1.5px;
      background: var(--c-accent);
      flex-shrink: 0;
    }

    /* ── SCROLL HINT ── */
    .scroll-hint {
      position: absolute;
      bottom: 168px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 4;
      color: var(--c-on-dark-3);
      animation: scrollBounce 1.8s ease-in-out infinite;
      cursor: pointer;
    }
    .scroll-hint svg { display: block; }
    @keyframes scrollBounce {
      0%, 100% { transform: translateX(-50%) translateY(0);   opacity: 0.55; }
      50%       { transform: translateX(-50%) translateY(8px); opacity: 0.90; }
    }

    /* ── PAUSA VIDEO ── */
    .hero-pause-btn {
      position: absolute;
      right: 40px;
      bottom: 168px;
      z-index: 4;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--c-border-dark);
      border: 1px solid var(--c-border-dark-strong);
      border-radius: 50%;
      color: var(--c-on-dark-3);
      cursor: pointer;
      transition: background var(--t), color var(--t), border-color var(--t);
    }
    .hero-pause-btn:hover {
      background: var(--c-border-dark-strong);
      color: #fff;
      border-color: rgba(255,255,255,0.40);
    }
    /* icon-play initial state se maneja por JS en initHeroPause */

    /* Accesibilidad: todo lo que se mueve solo, quieto. Bloque unico. */
    @media (prefers-reduced-motion: reduce) {
      .hero-video { display: none; }
      .home-hero {
        background-image: url('/assets/imagenes/image_heroprincipal.webp');
        background-size: cover;
        background-position: center;
      }
      .scroll-hint   { animation: none; opacity: 0.55; }
      .clients-track { animation: none; }
    }

    /* ── SERVICES SHOWCASE ── */
    .services-showcase {
      background: var(--c-primary);
      padding: var(--sp-l3) 0 0;
    }
    .services-showcase .sh-label        { color: var(--c-on-dark-3); }
    .services-showcase .sh-label::before,
    .services-showcase .sh-label::after  { background: var(--c-border-dark-strong); }
    .services-showcase .sh-title         { color: #fff; }
    .services-showcase .sh-desc          { color: var(--c-on-dark-3); }
    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
      margin-top: var(--sp-l2);
      background: var(--c-surface-dark-2);
    }
    .service-card {
      position: relative;
      overflow: hidden;
      aspect-ratio: 4/3;
      display: block;
      text-decoration: none;
    }
    .service-card img {
      position: absolute;
      inset: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform var(--t-slow);
    }
    .service-card:hover img { transform: scale(1.07); }
    /*
      El velo en reposo usa los valores que antes tenía el :hover.
      Ahora la tarjeta muestra la descripción sin necesidad de hover,
      así que el texto tiene que ser legible en reposo, no al pasar
      el mouse. El :hover solo refuerza.
    */
    .svc-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to top,
        rgba(20,23,45,0.97) 0%,
        rgba(20,23,45,0.62) 50%,
        rgba(20,23,45,0.22) 100%
      );
      transition: background var(--t);
      z-index: 1;
    }
    .service-card:hover .svc-overlay {
      background: linear-gradient(
        to top,
        rgba(20,23,45,0.98) 0%,
        rgba(20,23,45,0.74) 55%,
        rgba(20,23,45,0.34) 100%
      );
    }
    .svc-body {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      z-index: 2;
      padding: var(--sp-6) var(--sp-7);
    }
    .svc-icon {
      color: var(--c-accent);
      margin-bottom: var(--sp-2);
      opacity: 0.88;
      transition: opacity 0.3s, transform 0.3s;
    }
    .service-card:hover .svc-icon { opacity: 1; transform: translateY(-2px); }
    .svc-title {
      font-size: var(--fs-lg);
      font-weight: var(--fw-semibold);
      color: #fff;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin: 0 0 var(--sp-1);
    }
    /*
      La descripción y el "Ver más" están siempre visibles.

      Antes ambos vivían detrás de :hover (max-height:0 + opacity:0), y
      en móvil directamente display:none. El resultado era que la sección
      que explica a qué se dedica la empresa no explicaba nada: seis
      imágenes con un título encima, sin ningún indicio de que se puede
      tocar. Y :hover no existe en táctil, que es donde está el tráfico.

      El hover sigue aportando — la imagen escala y el ícono sube — pero
      ya no es el que decide si la información se lee o no.
    */
    .svc-desc {
      font-size: var(--fs-sm);
      color: var(--c-on-dark-2);
      line-height: 1.55;
      margin: 0;
    }
    .svc-arrow {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-1);
      margin-top: var(--sp-3);
      font-size: var(--fs-2xs);
      font-weight: var(--fw-semibold);
      text-transform: uppercase;
      letter-spacing: var(--ls-label);
      color: var(--c-accent);
      transition: gap .24s ease;
    }
    .service-card:hover .svc-arrow { gap: var(--sp-2); }

    /* ── PROYECTOS DESTACADOS ── */
    .projects-showcase {
      background: var(--c-primary);
      padding: var(--sp-l4) 0 0;
    }
    .projects-showcase .sh-label { color: var(--c-accent); opacity: 1; }
    .projects-showcase .sh-title { color: #fff; }
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-1);
      margin-top: var(--sp-l2);
    }
    .project-card {
      position: relative;
      height: 500px;
      overflow: hidden;
      display: block;
      text-decoration: none;
    }
    .project-card img {
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform var(--t-slow);
    }
    .project-card:hover img { transform: scale(1.07); }
    .project-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top,
        rgba(20,23,45,0.90) 0%,
        rgba(20,23,45,0.28) 45%,
        rgba(20,23,45,0.05) 100%
      );
      transition: background var(--t);
    }
    .project-card:hover .project-overlay {
      background: linear-gradient(to top,
        rgba(20,23,45,0.96) 0%,
        rgba(20,23,45,0.55) 52%,
        rgba(20,23,45,0.15) 100%
      );
    }
    .project-info {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      padding: var(--sp-7) var(--sp-6);
    }
    .project-tag {
      display: inline-block;
      font-size: var(--fs-2xs);
      font-weight: var(--fw-semibold);
      text-transform: uppercase;
      letter-spacing: var(--ls-label);
      color: var(--c-accent);
      border: 1px solid rgba(217,130,43,0.45);
      padding: var(--sp-1) var(--sp-2);
      margin-bottom: var(--sp-2);
    }
    .project-name {
      font-family: 'Montserrat', sans-serif;
      font-size: clamp(0.95rem, 1.3vw, 1.15rem);
      font-weight: var(--fw-bold);
      color: #fff;
      margin: 0 0 var(--sp-1);
      line-height: 1.25;
    }
    .project-location {
      font-size: var(--fs-2xs);
      color: rgba(255,255,255,0.48);
      margin: 0 0 var(--sp-3);
    }
    .project-cta {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-1);
      font-size: var(--fs-2xs);
      font-weight: var(--fw-semibold);
      text-transform: uppercase;
      letter-spacing: var(--ls-label);
      color: var(--c-accent);
      opacity: 0;
      transform: translateY(8px);
      transition: opacity var(--t), transform var(--t);
    }
    .project-card:hover .project-cta { opacity: 1; transform: translateY(0); }
    .projects-footer { text-align: center; padding: var(--sp-l2) 0; }

    /* ── COVERAGE MAP ── */
    .coverage-stats {
      display: flex;
      justify-content: center;
      gap: var(--sp-l3);
      margin: var(--sp-l1) 0 var(--sp-l2);
      padding: var(--sp-6) 0;
      border-top: 1px solid rgba(20,23,45,0.08);
      border-bottom: 1px solid rgba(20,23,45,0.08);
    }
    .cov-stat { text-align: center; }
    .cov-stat-num {
      display: block;
      font-size: clamp(2rem, 4vw, 2.8rem);
      font-weight: var(--fw-display);
      color: var(--c-primary);
      letter-spacing: var(--ls-tight);
      line-height: 1;
    }
    .cov-stat-label {
      display: block;
      font-size: var(--fs-2xs);
      font-weight: var(--fw-semibold);
      text-transform: uppercase;
      letter-spacing: var(--ls-label);
      color: var(--c-text-muted);
      margin-top: var(--sp-2);
    }
    .coverage-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-l3);
      align-items: center;
    }
    /* Mapa SVG interactivo por departamentos */
    .map-wrap {
      display: flex;
      justify-content: center;
      align-items: center;
    }
    #peruMapContainer {
      width: 100%;
      max-width: 280px;
    }
    /* El SVG se inyecta vía JS — estilos de departamentos aplicados inline en main.js */
    #peruMapContainer svg {
      width: 100%;
      height: auto;
      display: block;
      filter: drop-shadow(0 8px 28px rgba(20,23,45,0.12));
    }
    .map-stats { }
    .map-stats-title {
      font-size: var(--fs-xs);
      font-weight: var(--fw-semibold);
      text-transform: uppercase;
      letter-spacing: var(--ls-label);
      color: rgba(20,23,45,0.40);
      margin-bottom: var(--sp-6);
    }
    .map-stat { margin-bottom: var(--sp-4); }
    .map-stat:last-child { margin-bottom: 0; }
    .map-stat-meta {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: var(--sp-2);
    }
    .map-stat-city {
      font-size: var(--fs-md);
      font-weight: var(--fw-semibold);
      color: var(--c-primary);
    }
    .map-stat-count {
      font-size: var(--fs-md);
      font-weight: var(--fw-display);
      /* --c-accent sobre --c-bg-muted da 2.63:1. Estas son las cifras
         de proyectos por ciudad: el dato mas importante del bloque,
         y era el peor contraste del sitio. --c-accent-ink conserva el
         naranja y llega a 5.33:1. */
      color: var(--c-accent-ink);
      letter-spacing: var(--ls-tight);
    }
    .map-stat-bar {
      height: 4px;
      background: rgba(20,23,45,0.07);
      border-radius: 2px;
      overflow: hidden;
    }
    .map-stat-fill {
      height: 100%;
      width: 0;
      background: linear-gradient(90deg, var(--c-secondary), var(--c-accent));
      border-radius: 2px;
      transition: width 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    /* ── RESPONSIVE ──
       Bloque unico. Antes habia dos @media (max-width:768px) separados,
       uno arriba y otro aca, y ambos declaraban .about-grid con gap
       distinto: ganaba el de abajo y el de arriba no hacia nada. */
    @media (max-width: 768px) {
      /* Hero */
      .home-hero {
        min-height: 100svh;
        align-items: center;
      }
      /*
        El eyebrow se queda. Era lo único en toda la primera pantalla
        que decía a qué se dedica la empresa: el H1 es el eslogan y no
        nombra el rubro. Ocultarlo dejaba al visitante de celular sin
        saber qué vende INACONS hasta pasar el hero entero.
      */
      .scroll-hint    { display: none; }
      .hero-pause-btn { display: none; }
      .hero-content {
        padding: var(--sp-l3) var(--sp-5) 160px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .hero-eyebrow { justify-content: center; }
      .home-hero h1 {
        text-align: center;
        width: 100%;
        letter-spacing: var(--ls-tight);
      }
      /*
        Antes: nowrap + overflow:hidden. Eso no ajusta el titular, lo
        recorta — en un teléfono de 360px "CONSTRUIMOS CONFIANZA" no
        entra y perdía letras por el borde, en silencio.

        Ahora el tamaño lo resuelve --fs-hero de forma fluida, y el
        wrap queda como red de seguridad: en el peor caso la palabra
        baja de línea, que es feo pero legible. Recortar no lo es.
      */
      .hero-line {
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--sp-2);
        width: 100%;
      }
      .word.fixed,
      .word.highlight {
        white-space: nowrap;
        font-size: inherit;
      }
      .hero-content > p {
        text-align: center;
        margin-left: auto;
        margin-right: auto;
        max-width: 100%;
      }
      .hero-actions {
        justify-content: center;
        flex-direction: column;
        width: 100%;
      }
      .hero-actions .btn {
        width: 100%;
        justify-content: center;
      }

      /* Indicadores */
      .indicators-container { grid-template-columns: repeat(2, 1fr); }

      /* CTA */
      .cta-actions {
        flex-direction: column;
        align-items: center;
        width: 100%;
      }
      .cta-actions .btn {
        width: 100%;
        max-width: 320px;
        justify-content: center;
      }

      .services-showcase { padding: var(--sp-l3) 0 0; }
      .services-grid { grid-template-columns: repeat(2, 1fr); margin-top: var(--sp-7); }
      .service-card { aspect-ratio: 3/2; }
      .svc-body { padding: var(--sp-3) var(--sp-4); }
      .svc-title { font-size: var(--fs-sm); }
      /* La descripción se queda. Ocultarla dejaba la tarjeta en una
         imagen con una palabra encima, justo en el dispositivo donde
         está la mayor parte del tráfico. Se acorta a dos líneas para
         que la tarjeta no crezca de más. */
      .svc-desc {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .about-grid { grid-template-columns: 1fr; gap: var(--sp-l2); }
      .about-img-frame { height: 360px; }
      .about-years-badge { bottom: -12px; right: -12px; padding: var(--sp-3) var(--sp-4); }
      .about-kpi-row { gap: 0; }
      .about-kpi { padding: var(--sp-3) var(--sp-4); border-right: none; border-bottom: 1px solid rgba(20,23,45,0.09); }
      .about-kpi:last-child { border-bottom: none; padding-left: var(--sp-4); }
      .projects-grid { grid-template-columns: 1fr; }
      .project-card { height: 380px; }
      .project-cta { opacity: 1; transform: translateY(0); }
      .coverage-stats { gap: var(--sp-6); }
      .coverage-grid { grid-template-columns: 1fr; gap: var(--sp-7); }
      #peruMapContainer { max-width: 220px; }
    }
  </style>

