          <div class="client-logo-item"><img src="/assets/imagenes/clientes/cliente_indecopi.png" alt="Indecopi" loading="lazy" width="108" height="40"></div>
          <div class="client-logo-item"><img src="/assets/imagenes/clientes/cliente_losportales.png" alt="Los Portales" loading="lazy" width="108" height="40"></div>
          <div class="client-logo-item"><img src="/assets/imagenes/clientes/cliente_luzdelsur.png" alt="Luz del Sur" loading="lazy" width="108" height="40"></div>
          <div class="client-logo-item"><img src="/assets/imagenes/clientes/cliente_mediacommerce.png" alt="Media Commerce" loading="lazy" width="108" height="40"></div>
          <div class="client-logo-item"><img src="/assets/imagenes/clientes/cliente_sanmiguel.png" alt="San Miguel" loading="lazy" width="108" height="40"></div>
          <div class="client-logo-item"><img src="/assets/imagenes/clientes/cliente_sedapal.png" alt="Sedapal" loading="lazy" width="108" height="40"></div>
