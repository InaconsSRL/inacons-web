---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaCard from '../components/MediaCard.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

type Proyecto = CollectionEntry<'proyectos'>;

// Proyectos destacados para el home
const proyectos = await getCollection('proyectos');
const destacados = proyectos
  .filter((p: Proyecto) => p.data.destacado)
  .sort((a: Proyecto, b: Proyecto) => (a.data.orden ?? 99) - (b.data.orden ?? 99))
  .slice(0, 3);

// Los seis servicios del home. Mismo texto que tenía el markup.
// Existe src/content/servicios/ con estos mismos títulos: cuando se
// decida que la descripción del home sea la de la colección, esto se
// reemplaza por un getCollection('servicios') y nada más cambia.
const servicios = [
  { slug: 'obras-civiles',   titulo: 'Obras Civiles',   imagen: '/assets/imagenes/image_obra_civiles.webp',   desc: 'Infraestructura urbana, vial e industrial con metodología BIM' },
  { slug: 'infraestructura', titulo: 'Infraestructura', imagen: '/assets/imagenes/image_infraestructura.webp', desc: 'Proyectos de infraestructura pública y privada a nivel nacional' },
  { slug: 'electromecanica', titulo: 'Electromecánica', imagen: '/assets/imagenes/image_electromecanica.webp', desc: 'Instalaciones eléctricas y mecánicas para industria, minería e infraestructura' },
  { slug: 'paisajismo',      titulo: 'Paisajismo',      imagen: '/assets/imagenes/image_paisajismo.webp',      desc: 'Espacios verdes, parques y áreas exteriores que integran naturaleza y función' },
  { slug: 'mineria',         titulo: 'Minería',         imagen: '/assets/imagenes/image_mineria.webp',         desc: 'Ingeniería y construcción para el sector minero con los más altos estándares de seguridad' },
  { slug: 'consultoria',     titulo: 'Consultoría',     imagen: '/assets/imagenes/image_consultor.webp',       desc: 'Asesoría técnica especializada en gestión, supervisión y expedientes técnicos' },
];
---

<BaseLayout
  title="INACONS | Empresa Constructora en Perú"
  description="Empresa constructora peruana con más de 15 años en obras civiles, infraestructura, electromecánica y consultoría a nivel nacional."
>
  <!-- Preload LCP — solo en home donde esta imagen es el elemento visual principal -->
  <link slot="head" rel="preload" as="image" href="/assets/imagenes/image_heroprincipal.webp" fetchpriority="high" />

  <style slot="head">
    /* ── HERO ── */
    .home-hero {
      position: relative;
      width: 100%;
      height: 100vh;
      min-height: 620px;
      display: flex;
      align-items: center;
      overflow: hidden;
    }
    .hero-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(to bottom, rgba(20,23,45,0.30) 0%, rgba(20,23,45,0.92) 100%),
        linear-gradient(110deg, rgba(20,23,45,0.85) 0%, rgba(27,82,120,0.35) 60%, transparent 100%);
    }
    /*  Dos columnas: el mensaje a la izquierda y las cifras al costado.
        Estaban en una banda al pie del hero, que las ponia por debajo
        de los botones y empujaba scroll-hint y boton de pausa 168px
        hacia arriba. Al costado del titular se leen a la vez que el, y
        el hero recupera su borde inferior. */
    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
      padding: 0 var(--sp-l1);
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--sp-l3);
      align-items: center;
    }
    .hero-main { min-width: 0; }

    /* ── CIFRAS DEL HERO ── */
    .hero-stats {
      display: flex;
      flex-direction: column;
      gap: var(--sp-6);
      padding-left: var(--sp-7);
      border-left: 1px solid var(--c-border-dark-strong);
    }
    .hero-stat { white-space: nowrap; text-align: left; }

    .hero-stat .stat-num {
      font-size: var(--fs-display);
      color: var(--c-text-white);
    }
    .hero-stat .stat-label {
      color: var(--c-on-dark-3);
      margin-top: var(--sp-1);
    }

    /*  Entre 768 y 1024 no hay ancho para las dos columnas: el titular
        a 4.3vw ya ocupa casi todo el contenedor y las cifras al costado
        lo empujarian a partirse. En tablet van en fila bajo el mensaje,
        que es donde si hay sitio horizontal. */
    @media (max-width: 1023.98px) {
      .hero-content {
        grid-template-columns: 1fr;
        gap: var(--sp-l2);
      }
      .hero-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--sp-5);
        padding-left: 0;
        padding-top: var(--sp-6);
        border-left: none;
        border-top: 1px solid var(--c-border-dark-strong);
      }
      .hero-stat { text-align: center; }
    }
    .home-hero h1 {
      font-family: 'Montserrat', sans-serif;
      font-size: var(--fs-hero);
      font-weight: var(--fw-semibold);
      text-transform: uppercase;
      line-height: 1.1;
      margin-bottom: var(--sp-6);
      display: flex;
      flex-direction: column;
      gap: var(--sp-2);
      letter-spacing: var(--ls-tight);
    }
    .hero-line {
      display: flex;
      align-items: baseline;
      gap: var(--sp-3);
      flex-wrap: wrap;
    }
    .word.fixed   { color: var(--c-on-dark-2); font-weight: var(--fw-normal); letter-spacing: var(--ls-wide); }
    .word.highlight { color: #fff; font-weight: var(--fw-display); letter-spacing: var(--ls-tight); }
    /* Ghost reserva el espacio final desde el inicio — sin CLS */
    .word.typewriter {
      position: relative;
      display: inline-block;
    }
    .tw-ghost {
      visibility: hidden;
      user-select: none;
      pointer-events: none;
    }
    .tw-typed {
      position: absolute;
      left: 0;
      top: 0;
      white-space: nowrap;
      color: inherit;
    }
    /* @keyframes blink vive en design-system.css */
    .word.typewriter.typing .tw-typed::after {
      content: '|';
      color: var(--c-on-dark-3);
      animation: blink .5s infinite;
      margin-left: 2px;
    }
    .hero-desc {
      font-size: clamp(0.95rem, 1.6vw, 1.1rem);
      color: var(--c-on-dark-2);
      margin-bottom: var(--sp-7);
      max-width: 500px;
      font-weight: var(--fw-normal);
      letter-spacing: 0.2px;
    }
    .hero-actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; }

    /* ── ABOUT (Bechtel-style 2-col) ── */
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-l4);
      align-items: center;
    }
    /* Sin el marco naranja desplazado ni el badge flotante, nada queda
       posicionado en absoluto aca dentro: se van tambien el position
       relative y la escalera de z-index que existian solo para ellos. */
    .about-img-frame {
      height: 540px;
    }
    .about-img-frame img {
      width: 100%; height: 100%;
      object-fit: cover;
      object-position: center 20%;
    }
    .about-content { display: flex; flex-direction: column; }
    .about-body-text {
      font-size: var(--fs-md);
      color: rgba(20,23,45,0.68);
      line-height: 1.78;
      margin: 0 0 var(--sp-3);
    }
    /*  Tres cifras propias de esta seccion: recorrido y alcance. Las
        de escala (anos, km2, inversion, equipo) estan en el hero y no
        se repiten aca. Las tarjetas son .card--stat del sistema; aca
        solo va el layout. */
    .about-kpi-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-5) var(--sp-6);
      border-top: 1px solid var(--c-border-light);
      border-bottom: 1px solid var(--c-border-light);
      padding: var(--sp-6) 0;
      margin: var(--sp-6) 0 var(--sp-7);
    }
    .about-kpi-row .card--stat { text-align: left; }

    /* ── CLIENTES SCROLL ── */
    .clients-track-wrap {
      overflow: hidden;
      mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    }
    /* @keyframes clientsScroll vive en design-system.css */
    .clients-track {
      display: flex;
      width: max-content;
      animation: clientsScroll 30s linear infinite;
    }
    .clients-track:hover { animation-play-state: paused; }
    /*
      Enel, Sedapal, Luz del Sur, GE Vernova, Kallpa, Indecopi: es lo
      más persuasivo que tiene la home. Estaba en gris al 48% de
      opacidad, y el color solo volvía con :hover — que en táctil no
      existe. En celular la banda entera era una fila de manchas grises.

      El gris uniforme se conserva en escritorio, donde el hover puede
      devolver el color. En dispositivos sin hover se muestran a color
      de entrada, porque ahí no hay forma de pedirlo.
    */
    .client-logo-item {
      flex: 0 0 158px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--sp-4) var(--sp-5);
      border-right: 1px solid var(--c-border-light);
      filter: grayscale(100%);
      opacity: 0.85;
      transition: filter var(--t), opacity var(--t);
    }
    .client-logo-item:hover { filter: grayscale(0%); opacity: 1; }

    @media (hover: none) {
      .client-logo-item { filter: none; opacity: 1; }
    }

    /*
      Control de pausa del carrusel — WCAG 2.2.2 (nivel A).

      Cualquier movimiento automático que dure más de 5 segundos tiene
      que poder detenerse. La pausa al pasar el mouse no cumple: no es
      alcanzable por teclado y no existe en táctil. El patrón es el
      mismo que ya usa bien el botón de pausa del video del hero.
    */
    .clients-controls {
      display: flex;
      justify-content: center;
      margin-top: var(--sp-5);
    }
    .clients-pause-btn {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-2);
      padding: var(--sp-2) var(--sp-4);
      min-height: 32px;
      background: transparent;
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      color: var(--c-text-muted);
      font-family: var(--font-ui);
      font-size: var(--fs-2xs);
      font-weight: var(--fw-semibold);
      text-transform: uppercase;
      letter-spacing: var(--ls-label);
      cursor: pointer;
      transition: border-color var(--t), color var(--t);
    }
    .clients-pause-btn:hover {
      border-color: var(--c-secondary);
      color: var(--c-secondary);
    }
    .clients-track.is-paused { animation-play-state: paused; }

    .client-logo-item img { max-height: 40px; max-width: 108px; object-fit: contain; }

    /* ── EYEBROW ── */
    .hero-eyebrow {
      font-size: var(--fs-2xs);
      font-weight: var(--fw-semibold);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--c-accent);
      margin-bottom: var(--sp-5);
      display: flex;
      align-items: center;
      gap: var(--sp-2);
    }
    .hero-eyebrow::before {
      content: '';
      display: inline-block;
      width: 28px;
      height: 1.5px;
      background: var(--c-accent);
      flex-shrink: 0;
    }

    /* ── SCROLL HINT ── */
    /* Los 168px de bottom eran la altura medida de la banda de
       indicadores que ocupaba el pie del hero. Sin banda, van al
       borde. Mismo motivo en .hero-pause-btn. */
    .scroll-hint {
      position: absolute;
      bottom: var(--sp-l1);
      left: 50%;
      transform: translateX(-50%);
      z-index: 4;
      color: var(--c-on-dark-3);
      animation: scrollBounce 1.8s ease-in-out infinite;
      cursor: pointer;
    }
    .scroll-hint svg { display: block; }
    @keyframes scrollBounce {
      0%, 100% { transform: translateX(-50%) translateY(0);   opacity: 0.55; }
      50%       { transform: translateX(-50%) translateY(8px); opacity: 0.90; }
    }

    /* ── PAUSA VIDEO ── */
    .hero-pause-btn {
      position: absolute;
      right: var(--sp-l1);
      bottom: var(--sp-l1);
      z-index: 4;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--c-border-dark);
      border: 1px solid var(--c-border-dark-strong);
      border-radius: 50%;
      color: var(--c-on-dark-3);
      cursor: pointer;
      transition: background var(--t), color var(--t), border-color var(--t);
    }
    .hero-pause-btn:hover {
      background: var(--c-border-dark-strong);
      color: #fff;
      border-color: rgba(255,255,255,0.40);
    }
    /* icon-play initial state se maneja por JS en initHeroPause */

    /* Accesibilidad: todo lo que se mueve solo, quieto. Bloque unico. */
    @media (prefers-reduced-motion: reduce) {
      .hero-video { display: none; }
      .home-hero {
        background-image: url('/assets/imagenes/image_heroprincipal.webp');
        background-size: cover;
        background-position: center;
      }
      .scroll-hint   { animation: none; opacity: 0.55; }
      .clients-track { animation: none; }
    }

    /* ── SERVICES SHOWCASE ── */
    /*  El fondo y la adaptacion de .sh-* sobre oscuro los pone
        .sec--dark del sistema. Aca solo el padding, que es propio:
        sin padding inferior porque la rejilla va a sangre. */
    .services-showcase {
      padding: var(--section-py) 0 0;
    }

    /*  Servicios y proyectos son la misma tarjeta: tienen que medir
        igual. Y medir igual no es solo compartir proporcion — con
        servicios en tres columnas y proyectos en dos, la misma
        proporcion daba tarjetas de distinto tamano, que es lo que se
        veia: las de proyectos eran mas anchas Y mas altas.

        Las dos rejillas usan ahora el mismo ancho de columna (un
        tercio) y la misma proporcion (4/3, la de MediaCard por
        defecto). Proyectos va en flex y no en grid para que, cuando
        haya menos de tres destacados, las tarjetas queden centradas
        en vez de dejar un hueco a la derecha. */
    /*  El ancho y el reparto de las tarjetas los pone .cards-row del
        design system: el selector es "> *" y los hijos son MediaCard,
        que al no tener <style> propio no llevan data-astro-cid. Escrito
        aca, Astro lo scopearia y no engancharia con nada. Lo unico que
        queda en la pagina es lo que si es de la pagina. */
    .cards-row { margin-top: var(--sp-l2); }
    .services-grid { background: var(--c-surface-dark-2); }

    /* ── PROYECTOS DESTACADOS ── */
    .projects-showcase {
      padding: var(--section-py) 0 0;
    }
    .projects-footer { text-align: center; padding: var(--sp-l2) 0; }

    /* ── COVERAGE MAP ── */
    .coverage-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-l3);
      align-items: center;
    }
    /* Mapa SVG interactivo por departamentos */
    .map-wrap {
      display: flex;
      justify-content: center;
      align-items: center;
    }
    #peruMapContainer {
      width: 100%;
      max-width: 280px;
    }
    /* El SVG se inyecta vía JS — estilos de departamentos aplicados inline en main.js */
    #peruMapContainer svg {
      width: 100%;
      height: auto;
      display: block;
      filter: drop-shadow(0 8px 28px rgba(20,23,45,0.12));
    }
    .map-stats-title {
      font-size: var(--fs-xs);
      font-weight: var(--fw-semibold);
      text-transform: uppercase;
      letter-spacing: var(--ls-label);
      color: var(--c-text-muted);
      margin-bottom: var(--sp-5);
    }
    /*  Siete barras de progreso para siete cifras que ya estan escritas
        al lado. La barra no anadia un dato: repetia el mismo en otra
        forma, y se llevaba consigo una funcion de JS, dos radios
        literales y una transicion de 1.2s. */
    .map-stat {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--sp-4);
      padding: var(--sp-3) 0;
      border-bottom: 1px solid var(--c-border-light);
    }
    .map-stat:last-child { border-bottom: none; }
    .map-stat-city {
      font-size: var(--fs-md);
      font-weight: var(--fw-semibold);
      color: var(--c-primary);
    }
    .map-stat-count {
      font-size: var(--fs-md);
      font-weight: var(--fw-display);
      /* Son las cifras de proyectos por ciudad: el dato del bloque.
         --c-accent sobre claro da 2.93:1 y no pasa AA. --c-accent-ink
         conserva el naranja y llega a 5.33:1 sobre --c-bg-muted, que
         es el fondo de esta seccion. */
      color: var(--c-accent-ink);
      letter-spacing: var(--ls-tight);
    }

    @media (max-width: 767.98px) {
      /* Hero */
      .home-hero {
        min-height: 100svh;
        align-items: center;
      }
      /*
        El eyebrow se queda. Era lo único en toda la primera pantalla
        que decía a qué se dedica la empresa: el H1 es el eslogan y no
        nombra el rubro. Ocultarlo dejaba al visitante de celular sin
        saber qué vende INACONS hasta pasar el hero entero.
      */
      .scroll-hint    { display: none; }
      .hero-pause-btn { display: none; }
      .hero-content {
        padding: var(--sp-l3) var(--sp-5);
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .hero-eyebrow { justify-content: center; }
      .home-hero h1 {
        text-align: center;
        width: 100%;
        letter-spacing: var(--ls-tight);
      }
      /*
        Antes: nowrap + overflow:hidden. Eso no ajusta el titular, lo
        recorta — en un teléfono de 360px "CONSTRUIMOS CONFIANZA" no
        entra y perdía letras por el borde, en silencio.

        Ahora el tamaño lo resuelve --fs-hero de forma fluida, y el
        wrap queda como red de seguridad: en el peor caso la palabra
        baja de línea, que es feo pero legible. Recortar no lo es.
      */
      .hero-line {
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--sp-2);
        width: 100%;
      }
      .word.fixed,
      .word.highlight {
        white-space: nowrap;
        font-size: inherit;
      }
      .hero-desc {
        text-align: center;
        margin-left: auto;
        margin-right: auto;
        max-width: 100%;
      }
      .hero-actions {
        justify-content: center;
        flex-direction: column;
        width: 100%;
      }
      .hero-actions .btn {
        width: 100%;
        justify-content: center;
      }
      /*  En una columna no caben cuatro cifras al costado: bajan bajo
          los botones en 2x2, sin el filete lateral, que ahi no separa
          nada. */
      .hero-content {
        grid-template-columns: 1fr;
        gap: var(--sp-l2);
      }
      .hero-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--sp-6) var(--sp-4);
        padding-left: 0;
        border-left: none;
        width: 100%;
      }
      .hero-stat { text-align: center; }
      .hero-stat .stat-num { font-size: var(--fs-2xl); }

      /* CTA */

      .cards-row { margin-top: var(--sp-7); }
      .about-grid { grid-template-columns: 1fr; gap: var(--sp-l2); }
      .about-img-frame { height: 360px; }
      .coverage-grid { grid-template-columns: 1fr; gap: var(--sp-7); }
      #peruMapContainer { max-width: 220px; }
    }
  </style>

  <!--
    ORDEN DEL HOME — claro y oscuro alternados.

    Antes iba hero(video) → oscuro → claro → oscuro → claro → oscuro,
    con dos oscuras pegadas al arrancar y la banda CTA compitiendo con
    Proyectos por ser el cierre. Ahora cada seccion se apoya en el
    contraste de la anterior, y Clientes cierra en claro.
  -->
  <!-- ① HERO -->
  <section class="home-hero">
    <video class="hero-video" autoplay muted loop playsinline poster="/assets/imagenes/image_heroprincipal.webp">
      <source src="/assets/videos/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-content">
     <div class="hero-main">
      <p class="hero-eyebrow">Ingeniería &amp; Construcción</p>
      <h1 id="typewriter-text">
        <span class="hero-line">
          <span class="word fixed">CONSTRUIMOS</span>
          <span class="word highlight typewriter" data-text="CONFIANZA" aria-label="CONFIANZA"><span class="tw-ghost" aria-hidden="true">CONFIANZA</span><span class="tw-typed" aria-hidden="true"></span></span>
        </span>
        <span class="hero-line">
          <span class="word highlight typewriter" data-text="INNOVAMOS" aria-label="INNOVAMOS"><span class="tw-ghost" aria-hidden="true">INNOVAMOS</span><span class="tw-typed" aria-hidden="true"></span></span>
          <span class="word fixed">ESPACIOS</span>
        </span>
        <span class="hero-line">
          <span class="word fixed">TRASCENDEMOS</span>
          <span class="word highlight typewriter" data-text="JUNTOS" aria-label="JUNTOS"><span class="tw-ghost" aria-hidden="true">JUNTOS</span><span class="tw-typed" aria-hidden="true"></span></span>
        </span>
      </h1>
      <p class="hero-desc">Más de 15 años de experiencia en ingeniería y construcción al servicio del Perú.</p>
      <div class="hero-actions">
        <a href="/proyectos" class="btn btn-primary btn-lg">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"/></svg> Ver Proyectos
        </a>
        <a href="/assets/documentos/brochure_inacons.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-outline-light btn-lg">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg> Descargar Brochure
        </a>
      </div>
     </div>

      <!-- data-counter es el contrato con initCounters() de main.js -->
      <div class="hero-stats">
        <div class="hero-stat card--stat">
          <span class="stat-num" data-counter="15" data-suffix="+">15+</span>
          <span class="stat-label">Años de experiencia</span>
        </div>
        <div class="hero-stat card--stat">
          <span class="stat-num" data-counter="150" data-suffix="+">150+</span>
          <span class="stat-label">km² construidos</span>
        </div>
        <div class="hero-stat card--stat">
          <span class="stat-num" data-counter="100" data-suffix="M+">100M+</span>
          <span class="stat-label">Inversión gestionada</span>
        </div>
        <div class="hero-stat card--stat">
          <span class="stat-num" data-counter="100" data-suffix="+">100+</span>
          <span class="stat-label">Profesionales</span>
        </div>
      </div>
    </div>
    <button class="hero-pause-btn" id="heroPauseBtn" aria-label="Pausar video">
      <svg class="icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>
      <svg class="icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
    </button>
    <div class="scroll-hint" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </div>
  </section>

  <!--
    ② QUIENES SOMOS — claro.

    Estuvo fusionada con Cobertura para matar datos repetidos: "96+
    Proyectos ejecutados" salia dos veces palabra por palabra y
    "Departamentos" decia 7 en una y 6 en la otra. Eso ya no vuelve
    —las cifras estan repartidas y no se pisan—, asi que vuelven a ser
    dos secciones: cada una cuenta una cosa.
  -->
  <section class="sec sec--white">
    <div class="container">
      <div class="sh sh--medium" data-aos="fade-up">
        <p class="sh-label">Quiénes somos</p>
        <h2 class="sh-title">Construimos los proyectos que mueven al Perú</h2>
      </div>

      <div class="about-grid">
        <div class="about-img-frame">
          <img src="/assets/imagenes/image_nosotros.webp" alt="Equipo INACONS en obra" loading="lazy" width="640" height="540">
        </div>

        <div class="about-content">
          <p class="about-body-text">Somos una empresa peruana de ingeniería y construcción con más de 15 años ejecutando proyectos en toda la geografía nacional — desde la costa del Pacífico hasta la alta sierra.</p>
          <p class="about-body-text">Trabajamos con empresas líderes del sector público y privado, aplicando las más altas normas de calidad, seguridad y metodología BIM en cada obra.</p>

          <!-- data-counter es el contrato con initCounters() de main.js -->
          <div class="about-kpi-row">
            <div class="card--stat">
              <span class="stat-num" data-counter="96" data-suffix="+">96+</span>
              <span class="stat-label">Proyectos ejecutados</span>
            </div>
            <div class="card--stat">
              <span class="stat-num" data-counter="40" data-suffix="+">40+</span>
              <span class="stat-label">Clientes satisfechos</span>
            </div>
            <div class="card--stat">
              <span class="stat-num" data-counter="6">6</span>
              <span class="stat-label">Departamentos</span>
            </div>
          </div>

          <a href="/nosotros" class="btn btn-primary">
            Conoce nuestra historia <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ③ LO QUE CONSTRUIMOS — oscuro -->
  <section class="sec--dark services-showcase">
    <div class="container" data-aos="fade-up" data-aos-duration="700">
      <div class="sh sh--center sh--medium">
        <p class="sh-label">Nuestras Especialidades</p>
        <h2 class="sh-title">Lo que construimos</h2>
        <p class="sh-desc">Seis líneas de servicio integradas para proyectos de cualquier escala, en cualquier región del Perú.</p>
      </div>
    </div>
    <div class="cards-row services-grid">
      {servicios.map((s) => (
        <MediaCard
          href={`/servicios/${s.slug}`}
          image={s.imagen}
          alt={`${s.titulo} INACONS`}
          title={s.titulo}
          desc={s.desc}
          ratioMobile="3/2"
          width={640}
          height={480}
        />
      ))}
    </div>
  </section>

  <!--
    ④ DONDE CONSTRUIMOS — claro.

    Ocupa el hueco que deja la banda CTA. El mapa deja de ser un
    bloque subordinado dentro de Quienes somos y tiene su propia
    cabecera, que es lo que siempre fue: un argumento de cobertura.
  -->
  <section class="sec sec--muted">
    <div class="container">
      <div class="sh sh--medium" data-aos="fade-up">
        <p class="sh-label">Presencia nacional</p>
        <h2 class="sh-title">Dónde construimos</h2>
        <p class="sh-desc">Desde la costa hasta la sierra, operamos en las zonas de mayor actividad económica del país.</p>
      </div>

      <div class="coverage-grid" data-aos="fade-up">
        <!--
          El contenedor del mapa NO puede quedar en display:none en
          ningun breakpoint: initCoverageMap mide con getBBox() y sobre
          un elemento sin caja devuelve ceros, con lo que los siete
          pines desaparecen y el mapa se sigue dibujando, sin error.
          Ocultar por opacidad (data-aos) es seguro; por display no.
        -->
        <div class="map-wrap">
          <div id="peruMapContainer" aria-label="Mapa de cobertura INACONS en el Perú"></div>
        </div>

        <div class="map-stats">
          <p class="map-stats-title">Proyectos por ciudad</p>
          <div class="map-stat">
            <span class="map-stat-city">Huancayo</span>
            <span class="map-stat-count">50+</span>
          </div>
          <div class="map-stat">
            <span class="map-stat-city">Lima</span>
            <span class="map-stat-count">25+</span>
          </div>
          <div class="map-stat">
            <span class="map-stat-city">Pasco</span>
            <span class="map-stat-count">6+</span>
          </div>
          <div class="map-stat">
            <span class="map-stat-city">Huancavelica</span>
            <span class="map-stat-count">5+</span>
          </div>
          <div class="map-stat">
            <span class="map-stat-city">Ica</span>
            <span class="map-stat-count">5+</span>
          </div>
          <div class="map-stat">
            <span class="map-stat-city">Piura</span>
            <span class="map-stat-count">3+</span>
          </div>
          <div class="map-stat">
            <span class="map-stat-city">Trujillo</span>
            <span class="map-stat-count">2+</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ⑤ NUESTROS PROYECTOS — oscuro — dinámico desde src/content/proyectos/ -->
  {destacados.length > 0 && (
    <section class="sec--dark projects-showcase">
      <div class="container">
        <div class="sh sh--medium" data-aos="fade-up" data-aos-duration="700">
          <p class="sh-label">Proyectos destacados</p>
          <h2 class="sh-title">Nuestra huella en el Perú</h2>
        </div>
      </div>

      <div
        class="cards-row projects-grid"
        data-aos="fade-up" data-aos-duration="800" data-aos-delay="100"
      >
        {destacados.map((proyecto) => (
          <MediaCard
            href={`/proyectos/${proyecto.id}`}
            image={proyecto.data.imagen}
            alt={proyecto.data.titulo}
            tag={proyecto.data.categoria}
            title={proyecto.data.titulo}
            meta={`${proyecto.data.ubicacion} · ${proyecto.data.año}`}
            ratioMobile="3/2"
            width={640}
            height={480}
          />
        ))}
      </div>

      <div class="container">
        <div class="projects-footer" data-aos="fade-up" data-aos-duration="600">
          <a href="/proyectos" class="btn btn-outline-light">
            Ver todos los proyectos
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ⑥ NUESTROS CLIENTES — claro, cierre -->
