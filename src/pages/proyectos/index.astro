---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import MediaCard from '../../components/MediaCard.astro';

type Proyecto = CollectionEntry<'proyectos'>;

const proyectos = await getCollection('proyectos');
proyectos.sort((a: Proyecto, b: Proyecto) =>
  (a.data.orden ?? 99) - (b.data.orden ?? 99)
);
---

<BaseLayout title="Proyectos | INACONS" description="Proyectos ejecutados por INACONS a nivel nacional">

  <PageHero
    image="/assets/imagenes/hero_project.webp"
    title="En toda superficie<br>y condición"
    subtitle="Más de 150 proyectos ejecutados a lo largo de todo el Perú"
    current="Proyectos"
  />

  <section class="sec sec--muted">
    <div class="container">

      <div class="sh sh--center sh--medium" data-aos="fade-up">
        <p class="sh-label">Portafolio</p>
        <h2 class="sh-title">Experiencia construida en cada obra</h2>
        <p class="sh-desc">
          Desarrollamos proyectos en los terrenos más desafiantes del Perú, desde la costa hasta la sierra, adaptando nuestras soluciones a cada geografía y condición climática.
        </p>
      </div>

      <div class="cards-row">
        {proyectos.map((proyecto: Proyecto) => (
          <MediaCard
            href={`/proyectos/${proyecto.id}/`}
            image={proyecto.data.imagen}
            alt={proyecto.data.titulo}
            tag={proyecto.data.categoria}
            title={proyecto.data.titulo}
            meta={`${proyecto.data.ubicacion} · ${proyecto.data.año}`}
            ratio="4/5"
            width={640} height={800}
          />
        ))}
      </div>

    </div>
  </section>

  <CtaBand
    label="Tu próxima obra"
    title="¿Tienes un proyecto en marcha?"
    description="Contamos con el equipo y la metodología para llevarlo al mismo estándar."
    primaryHref="/contacto/"
    primaryLabel="Solicitar propuesta"
    secondaryHref="/servicios/"
    secondaryLabel="Ver servicios"
  />

</BaseLayout>

