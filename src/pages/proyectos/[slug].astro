---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Galeria from '../../components/Galeria.astro';
import Icono from '../../components/Icono.astro';
import MediaCard from '../../components/MediaCard.astro';

type Proyecto = CollectionEntry<'proyectos'>;

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((proyecto: Proyecto) => ({
    params: { slug: proyecto.id },
    props: { proyecto, todosProyectos: proyectos },
  }));
}

interface Props {
  proyecto: Proyecto;
  todosProyectos: Proyecto[];
}

const { proyecto, todosProyectos } = Astro.props;
const { Content } = await render(proyecto);
const { titulo, ubicacion, categoria, año, imagen, galeria = [], resumen, ficha, destacados } = proyecto.data;

const relacionados = todosProyectos
  .filter((p) => p.id !== proyecto.id && p.data.categoria === categoria)
  .slice(0, 3);
// Con dos o más hay para una sección propia; con uno basta el panel del lateral.
const seccionRelacionados = relacionados.length >= 2;

// Ubicación, categoría y año salen siempre; el resto, solo si el .md lo trae.
const filasFicha: [string, string][] = [
  ['Ubicación', ubicacion],
  ['Categoría', categoria],
  ['Año', String(año)],
  ...(ficha?.cliente ? [['Cliente', ficha.cliente]] : []),
  ...(ficha?.plazo ? [['Plazo', ficha.plazo]] : []),
  ...(ficha?.alcance ? [['Alcance', ficha.alcance]] : []),
  ...(ficha?.estado ? [['Estado', ficha.estado]] : []),
] as [string, string][];
---

<BaseLayout
  title={`${titulo} | INACONS`}
  description={`${categoria} en ${ubicacion} (${año}): proyecto ejecutado por INACONS, empresa peruana de ingeniería y construcción.`}
  ogImage={imagen}
>

  <PageHero
    image={imagen}
    title={titulo}
    subtitle={resumen ?? `${ubicacion} — ${año}`}
    parent={{ label: 'Proyectos', href: '/proyectos/' }}
    current={titulo}
    size="md"
  />

  <!-- CONTENIDO -->
  <section class="sec sec--white">
    <div class="container">
      <div class="proyecto-layout">

        <!-- Columna principal -->
        <div data-aos="fade-up">

          <span class="proyecto-badge">{categoria}</span>

          <div class="prosa prosa--ficha">
            <Content />
          </div>

          <Galeria fotos={galeria} titulo={titulo} />

          <a href="/contacto/" class="btn btn-primary">
            Solicitar cotización
            <Icono nombre="flecha-derecha" tam={15} />
          </a>
        </div>

        <!-- Ficha técnica -->
        <aside class="proyecto-aside">
          <div class="panel panel--sm panel--rail" data-aos="fade-left">
            <p class="panel-label">Ficha Técnica</p>
            <ul class="data-list">
              {filasFicha.map(([clave, valor]) => (
                <li><span class="data-key">{clave}</span><span class="data-value">{valor}</span></li>
              ))}
            </ul>
          </div>

          {relacionados.length > 0 && !seccionRelacionados && (
            <div class="panel panel--sm panel--rail" data-aos="fade-left" data-aos-delay="100">
              <p class="panel-label">Proyectos relacionados</p>
              <nav aria-label="Proyectos relacionados">
                {relacionados.map((p) => (
                  <a href={`/proyectos/${p.id}/`} class="related-link">
                    <div class="related-thumb">
                      <Image quality={70} src={p.data.imagen} alt="" width={104} />
                    </div>
                    <div class="related-info">
                      <span class="related-name">{p.data.titulo}</span>
                      <span class="related-meta">{p.data.ubicacion} — {p.data.año}</span>
                    </div>
                  </a>
                ))}
              </nav>
            </div>
          )}
        </aside>

      </div>
    </div>
  </section>

  {destacados && destacados.length > 0 && (
    <section class="sec sec--muted">
      <div class="container">
        <div class="sh sh--medium" data-aos="fade-up">
          <p class="sh-label">Lo más destacado</p>
          <h2 class="sh-title">Qué hizo especial a esta obra</h2>
        </div>
        <div class="feature-grid">
          {destacados.map((d, i) => (
            <div class="feature-item feature-item--card" data-aos="fade-up" data-aos-delay={i * 80}>
              <div class="feature-icon"><Icono nombre={d.icono ?? 'check-circulo'} tam={24} /></div>
              <h3 class="feature-title">{d.titulo}</h3>
              <p class="feature-desc">{d.descripcion}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Clara: la banda de cierre es oscura y dos oscuras seguidas borrarían la
      alternancia. La sección de destacados, si sale, es gris; esta va en blanco. */}
  {seccionRelacionados && (
    <section class={`sec ${destacados && destacados.length > 0 ? 'sec--white' : 'sec--muted'}`}>
      <div class="container">
        <div class="sh sh--row" data-aos="fade-up">
          <div class="sh-text">
            <p class="sh-label">Obra ejecutada</p>
            <h2 class="sh-title">Más proyectos de {categoria}</h2>
          </div>
          <a href="/proyectos/" class="btn btn-outline">Ver todos los proyectos</a>
        </div>
        <div class="cards-row" data-aos="fade-up">
          {relacionados.map((p) => (
            <MediaCard
              href={`/proyectos/${p.id}/`}
              image={p.data.imagen}
              alt=""
              tag={p.data.categoria}
              title={p.data.titulo}
              meta={`${p.data.ubicacion} · ${p.data.año}`}
              ratio="4/5"
              ratioMobile="3/2"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand
    label="¿Proyecto similar?"
    title="¿Tienes un proyecto que requiere nuestra experiencia?"
    description="Contamos con el equipo y la metodología para llevar tu proyecto al más alto nivel de calidad."
    primaryHref="/contacto/"
    primaryLabel="Contáctenos"
    secondaryHref="/proyectos/"
    secondaryLabel="Ver todos los proyectos"
    image={imagen}
  />

</BaseLayout>

<style>
  .proyecto-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--sp-l3);
    align-items: start;
  }

  .proyecto-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    padding: var(--sp-1) var(--sp-3);
    background: color-mix(in srgb, var(--c-secondary) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--c-secondary) 20%, transparent);
    border-radius: var(--radius);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-ui);
    text-transform: uppercase;
    color: var(--c-secondary);
    margin-bottom: var(--sp-6);
  }

  /* Aside */
  .proyecto-aside {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  /*  El aside separa con gap, así que el margen de .panel + .panel
      sobra: sumaría 20px a los 4 del gap. */
  .proyecto-aside .panel + .panel { margin-top: 0; }


  .related-link {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-2) 0;
    text-decoration: none;
    border-bottom: 1px solid var(--c-border-light);
    transition: padding-left var(--t);
  }

  .related-link:last-child { border-bottom: none; }
  .related-link:hover { padding-left: var(--sp-1); }

  .related-thumb {
    width: 52px;
    height: 40px;
    border-radius: var(--radius);
    overflow: hidden;
    flex-shrink: 0;
  }

  .related-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-name {
    display: block;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--c-text-heading);
    line-height: 1.3;
    transition: color var(--t);
  }

  .related-link:hover .related-name { color: var(--c-secondary); }

  .related-meta {
    display: block;
    font-size: var(--fs-2xs);
    color: var(--c-text-muted);
    margin-top: 2px;
  }

  @media (max-width: 1023.98px) {
    .proyecto-layout { grid-template-columns: 1fr; gap: var(--sp-l2); }
    .proyecto-aside  { position: static; }
  }
</style>
