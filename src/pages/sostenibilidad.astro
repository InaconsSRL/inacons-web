---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import Icono from '../components/Icono.astro';
import { Image } from 'astro:assets';
import imagenHero from '../assets/imagenes/sostenibilidad.webp';
import imagenSocial from '../assets/imagenes/aldeas_infantiles.jpg';
import imagenSeguridad from '../assets/imagenes/seguridad.png';
---

<BaseLayout title="Sostenibilidad, seguridad y ambiente en obra | INACONS" description="Responsabilidad social, seguridad y gestión ambiental en cada proyecto de INACONS, con ISO 45001 e ISO 14001 aplicadas en obra.">

  <style slot="head">
    .split-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-l3);
      align-items: center;
    }
    .split-img { position: relative; height: 480px; overflow: hidden; border-radius: var(--radius); }
    .split-img img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--t-slow); }
    .split-img:hover img { transform: scale(1.03); }
    .split-right .split-img { order: 2; }
    .split-right .split-text { order: 1; }
    .ods-grid { margin-top: var(--sp-l2); }
    .safety-chips { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-6); }
    @media (max-width: 767.98px) {
      .split-grid { grid-template-columns: 1fr; gap: var(--sp-7); }
      .split-img { height: 260px; }
      .split-right .split-img, .split-right .split-text { order: 0; }
    }
    @media (min-width: 768px) and (max-width: 1023.98px) {
      .split-grid { gap: var(--sp-l2); }
      .split-img { height: 360px; }
    }
  </style>

  <!-- HERO -->
  <PageHero
    image={imagenHero}
    title="Sostenibilidad, seguridad<br>y responsabilidad social"
    subtitle="Construyendo un futuro mejor en cada proyecto"
    current="Sostenibilidad"
    size="md"
  />

  <!-- ① COMPROMISO SOCIAL -->
  <section class="sec sec--white">
    <div class="container">
      <div class="split-grid split-right">
        <div class="split-text" data-aos="fade-right" data-aos-duration="800">
          <div class="sh sh--left sh--narrow">
            <p class="sh-label">Responsabilidad social</p>
            <h2 class="sh-title">Nuestro compromiso social</h2>
            <p class="sh-desc">En INACONS asumimos un compromiso con el bienestar social y el desarrollo sostenible. A través de nuestra donación a Aldeas Infantiles apoyamos a niños y familias en situación de vulnerabilidad.</p>
            <p class="sh-desc">Nuestro compromiso va más allá de la construcción: trabajamos con ética y responsabilidad para generar un impacto positivo y duradero, enfocados en el cumplimiento de los Objetivos de Desarrollo Sostenible (ODS).</p>
          </div>
          <a href="/contacto/" class="btn btn-primary">
            Contáctanos <Icono nombre="flecha-derecha" tam={15} />
          </a>
        </div>
        <div class="split-img" data-aos="fade-left" data-aos-duration="800">
          <Image quality={70} src={imagenSocial} alt="Compromiso Social INACONS" widths={[480, 720, 960]} sizes="(min-width: 768px) 50vw, 100vw" />
        </div>
      </div>
    </div>
  </section>

  <!-- ② SEGURIDAD -->
  <section class="sec sec--muted">
    <div class="container">
      <div class="split-grid">
        <div class="split-img" data-aos="fade-right" data-aos-duration="800">
          <Image quality={70} src={imagenSeguridad} alt="Seguridad y Prevención INACONS" widths={[400, 600]} sizes="(min-width: 768px) 50vw, 100vw" />
        </div>
        <div class="split-text" data-aos="fade-left" data-aos-duration="800">
          <div class="sh sh--left sh--narrow">
            <p class="sh-label">Cultura de seguridad</p>
            <h2 class="sh-title">Seguridad y prevención</h2>
            <p class="sh-desc">En INACONS trabajamos con una política de cero accidentes y un sistema de seguridad y salud en el trabajo certificado en ISO 45001. Desarrollamos iniciativas de reconocimiento, orden en obra y participación de todas las áreas en la prevención.</p>
          </div>
          <div class="safety-chips">
            <div class="chip"><Icono nombre="escudo-check" /> Cero Accidentes</div>
            <div class="chip"><Icono nombre="equipo" /> Cultura Preventiva</div>
            <div class="chip"><Icono nombre="premio" /> Reconocimientos</div>
            <div class="chip"><Icono nombre="portapapeles-check" /> Orden en Obra</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ③ ODS -->
  <section class="sec sec--white">
    <div class="container">
      <div class="sh sh--center sh--medium" data-aos="fade-up">
        <p class="sh-label">Agenda 2030</p>
        <h2 class="sh-title">Objetivos de Desarrollo Sostenible</h2>
        <p class="sh-desc">Los cuatro Objetivos de Desarrollo Sostenible de las Naciones Unidas a los que contribuye nuestro trabajo.</p>
      </div>
      <div class="feature-grid ods-grid">
        <div class="feature-item feature-item--card feature-item--centrado" data-aos="fade-up" data-aos-delay="100">
          <div class="feature-icon"><Icono nombre="edificio-oficinas" tam={26} /></div>
          <p class="feature-title">ODS 9 · Industria, innovación e infraestructura</p>
          <p class="feature-desc">Construimos infraestructura resiliente que impulsa el desarrollo económico.</p>
        </div>
        <div class="feature-item feature-item--card feature-item--centrado" data-aos="fade-up" data-aos-delay="180">
          <div class="feature-icon"><Icono nombre="hoja" tam={26} /></div>
          <p class="feature-title">ODS 13 · Acción por el clima</p>
          <p class="feature-desc">Gestionamos el impacto ambiental de cada obra con un sistema certificado en ISO 14001.</p>
        </div>
        <div class="feature-item feature-item--card feature-item--centrado" data-aos="fade-up" data-aos-delay="260">
          <div class="feature-icon"><Icono nombre="equipo" tam={26} />
          </div>
          <p class="feature-title">ODS 8 · Trabajo decente y crecimiento económico</p>
          <p class="feature-desc">Empleo formal y seguro en obra, con seguridad y salud en el trabajo certificadas en ISO 45001.</p>
        </div>
        <div class="feature-item feature-item--card feature-item--centrado" data-aos="fade-up" data-aos-delay="340">
          <div class="feature-icon"><Icono nombre="manos-corazon" tam={26} /></div>
          <p class="feature-title">ODS 10 · Reducción de las desigualdades</p>
          <p class="feature-desc">Apoyamos a niños y familias en situación de vulnerabilidad a través de Aldeas Infantiles.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    label="Obra responsable"
    title="¿Tu proyecto exige estándares de seguridad y ambiente?"
    description="Ejecutamos con ISO 45001 y 14001 en obra, no solo en el papel."
    primaryHref="/contacto/"
    primaryLabel="Contáctanos"
    secondaryHref="/servicios/"
    secondaryLabel="Ver servicios"
  />

</BaseLayout>