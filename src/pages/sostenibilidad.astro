---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import Icono from '../components/Icono.astro';
import { Image } from 'astro:assets';
import imagenHero from '../assets/imagenes/sostenibilidad.webp';
import imagenSocial from '../assets/imagenes/aldeas_infantiles.jpg';
import imagenSeguridad from '../assets/imagenes/seguridad.png';
---

<BaseLayout title="Sostenibilidad | INACONS" description="Responsabilidad social, seguridad y desarrollo sostenible en cada proyecto de INACONS">

  <style slot="head">
    .split-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-l3);
      align-items: center;
    }
    .split-img { position: relative; height: 480px; overflow: hidden; border-radius: var(--radius); }
    .split-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
    .split-img:hover img { transform: scale(1.03); }
    .split-right .split-img { order: 2; }
    .split-right .split-text { order: 1; }
    .ods-grid { margin-top: var(--sp-l2); }
    .safety-chips { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-6); }
    @media (max-width: 767.98px) {
      .split-grid { grid-template-columns: 1fr; gap: var(--sp-7); }
      .split-img { height: 260px; }
      .split-right .split-img, .split-right .split-text { order: 0; }
    }
    @media (min-width: 768px) and (max-width: 1023.98px) {
      .split-grid { gap: var(--sp-l2); }
      .split-img { height: 360px; }
    }
  </style>

  <!-- HERO -->
  <PageHero
    image={imagenHero}
    title="Construyendo<br>un futuro mejor"
    subtitle="Responsabilidad social, seguridad y desarrollo sostenible en cada proyecto"
    current="Sostenibilidad"
    size="md"
  />

  <!-- ① COMPROMISO SOCIAL -->
  <section class="sec sec--white">
    <div class="container">
      <div class="split-grid split-right">
        <div class="split-text" data-aos="fade-right" data-aos-duration="800">
          <div class="sh sh--left sh--narrow">
            <p class="sh-label">Responsabilidad Social</p>
            <h2 class="sh-title">Nuestro Compromiso Social</h2>
            <p class="sh-desc">En INACONS apoyamos activamente a las comunidades. A través de nuestra colaboración con Aldeas Infantiles, contribuimos al bienestar de niños y familias en situación de vulnerabilidad.</p>
            <p class="sh-desc">Nuestra labor va más allá de la construcción: trabajamos con ética y responsabilidad, alineados con los Objetivos de Desarrollo Sostenible (ODS).</p>
          </div>
          <a href="/contacto/" class="btn btn-primary">
            Contáctenos <Icono nombre="flecha-derecha" tam={15} />
          </a>
        </div>
        <div class="split-img" data-aos="fade-left" data-aos-duration="800">
          <Image quality={70} src={imagenSocial} alt="Compromiso Social INACONS" widths={[480, 720, 960]} sizes="(min-width: 768px) 50vw, 100vw" />
        </div>
      </div>
    </div>
  </section>

  <!-- ② SEGURIDAD -->
  <section class="sec sec--muted">
    <div class="container">
      <div class="split-grid">
        <div class="split-img" data-aos="fade-right" data-aos-duration="800">
          <Image quality={70} src={imagenSeguridad} alt="Seguridad y Prevención INACONS" widths={[400, 600]} sizes="(min-width: 768px) 50vw, 100vw" />
        </div>
        <div class="split-text" data-aos="fade-left" data-aos-duration="800">
          <div class="sh sh--left sh--narrow">
            <p class="sh-label">Cultura de Seguridad</p>
            <h2 class="sh-title">Seguridad y Prevención</h2>
            <p class="sh-desc">En INACONS aplicamos una política de cero accidentes, asegurando la seguridad y bienestar de cada colaborador. Desarrollamos iniciativas de reconocimiento, orden en obra y participación de todas las áreas en la prevención.</p>
          </div>
          <div class="safety-chips">
            <div class="chip"><Icono nombre="escudo-check" /> Cero Accidentes</div>
            <div class="chip"><Icono nombre="equipo" /> Cultura Preventiva</div>
            <div class="chip"><Icono nombre="premio" /> Reconocimientos</div>
            <div class="chip"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg> Orden en Obra</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ③ ODS -->
  <section class="sec sec--white">
    <div class="container">
      <div class="sh sh--center sh--medium" data-aos="fade-up">
        <p class="sh-label">Agenda 2030</p>
        <h2 class="sh-title">Objetivos de Desarrollo Sostenible</h2>
        <p class="sh-desc">Nuestras operaciones están alineadas con los ODS de las Naciones Unidas, integrando sostenibilidad en cada etapa de nuestros proyectos.</p>
      </div>
      <div class="feature-grid ods-grid">
        <div class="feature-item feature-item--card feature-item--centrado" data-aos="fade-up" data-aos-delay="100">
          <div class="feature-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg></div>
          <p class="feature-title">Industria e Infraestructura</p>
          <p class="feature-desc">Construimos infraestructura resiliente que impulsa el desarrollo económico.</p>
        </div>
        <div class="feature-item feature-item--card feature-item--centrado" data-aos="fade-up" data-aos-delay="180">
          <div class="feature-icon"><Icono nombre="hoja" tam={26} /></div>
          <p class="feature-title">Acción por el Clima</p>
          <p class="feature-desc">Reducimos el impacto ambiental incorporando prácticas sostenibles en obra.</p>
        </div>
        <div class="feature-item feature-item--card feature-item--centrado" data-aos="fade-up" data-aos-delay="260">
          <div class="feature-icon"><Icono nombre="equipo" tam={26} />
          </div>
          <p class="feature-title">Trabajo Decente</p>
          <p class="feature-desc">Generamos empleo digno y seguro para comunidades locales en cada proyecto.</p>
        </div>
        <div class="feature-item feature-item--card feature-item--centrado" data-aos="fade-up" data-aos-delay="340">
          <div class="feature-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M12 5 9.04 7.96a2.17 2.17 0 0 0 0 3.08v0c.82.82 2.13.85 3 .07l2.07-1.9a2.82 2.82 0 0 1 3.79 0l2.96 2.66"/><path d="m18 15-2-2"/><path d="m15 18-2-2"/></svg></div>
          <p class="feature-title">Reducción de Desigualdades</p>
          <p class="feature-desc">Apoyamos comunidades vulnerables a través de programas de responsabilidad social.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    label="Obra responsable"
    title="¿Tu proyecto exige estándares de seguridad y ambiente?"
    description="Ejecutamos con ISO 45001 y 14001 en obra, no solo en el papel."
    primaryHref="/contacto/"
    primaryLabel="Contáctenos"
    secondaryHref="/servicios/"
    secondaryLabel="Ver servicios"
  />

</BaseLayout>