      </div>
    </div>
  </div>

  <script>
    // Mismo patrón que src/pages/panel/index.astro: hidden (no clase),
    // bloquear scroll del fondo y devolver el foco a quien abrió.
    let ultimoFoco: HTMLElement | null = null;

    function abrir(id: string) {
      const el = document.getElementById(id);
      if (!el) return;
      ultimoFoco = document.activeElement as HTMLElement;
      el.hidden = false;
      document.body.style.overflow = 'hidden';
      el.querySelector<HTMLElement>('button, a')?.focus();
    }

    function cerrar(id: string) {
      const el = document.getElementById(id);
      if (!el) return;
      el.hidden = true;
      document.body.style.overflow = '';
      ultimoFoco?.focus();
    }

    document.querySelectorAll<HTMLElement>('[data-abrir]').forEach((b) =>
      b.addEventListener('click', () => abrir(b.getAttribute('data-abrir')!))
    );
    document.querySelectorAll<HTMLElement>('[data-cerrar]').forEach((b) =>
      b.addEventListener('click', () => cerrar(b.getAttribute('data-cerrar')!))
    );
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document.querySelectorAll<HTMLElement>('.dialogo:not([hidden])').forEach((d) => cerrar(d.id));
    });

    // ── Copiar enlace ──
    const inputLink = document.getElementById('mn-link-input') as HTMLInputElement | null;
    const btnCopiar = document.getElementById('btn-copiar-link');

    btnCopiar?.addEventListener('click', async () => {
      if (!inputLink) return;
      const textoOriginal = btnCopiar.textContent;
      try {
        await navigator.clipboard.writeText(inputLink.value);
        btnCopiar.textContent = 'Copiado';
      } catch {
        // Sin permiso de portapapeles (o sin HTTPS): seleccionar el texto
        // deja a la persona copiarlo a mano con Ctrl/Cmd+C.
        inputLink.select();
        btnCopiar.textContent = 'Selecciona y copia';
      }
      setTimeout(() => { btnCopiar.textContent = textoOriginal; }, 2000);
    });

    // ── Compartir nativo ──
    // El botón nace `hidden`: solo se muestra si el navegador soporta la
    // Web Share API (móviles sobre todo). Ahí abre la hoja de compartir
    // propia del sistema — Telegram, SMS, Instagram, lo que la persona
    // tenga instalado — sin que este sitio tenga que conocer cada app.
    const btnNativo = document.getElementById('btn-compartir-nativo') as HTMLButtonElement | null;
    if (btnNativo && typeof navigator.share === 'function' && inputLink) {
      btnNativo.hidden = false;
      btnNativo.addEventListener('click', () => {
        navigator.share({ title: 'INACONS en el sector minero', url: inputLink.value }).catch(() => {});
      });
    }
  </script>

