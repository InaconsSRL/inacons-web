---
import BaseLayout from '../layouts/BaseLayout.astro';
import { generarQR } from '../lib/qr.ts';

// Destinos de los CTA. Editar acá cuando se confirmen las URLs finales —
// "Brochure" ya apunta al mismo destino que usa el resto del sitio (ver
// src/pages/expomina.astro). "Contacto" no navega: abre el diálogo con las
// personas de contacto (más abajo en este mismo archivo).
const URL_BROCHURE   = '/assets/documentos/brochure_inacons.pdf';
const URL_DOCUMENTOS = '/documentos/';

// URL pública de esta página, para el QR y el enlace para compartir.
// Sale de `site` (astro.config.mjs), nunca escrita a mano.
const URL_PAGINA = new URL('/mineria/', Astro.site).href;

// El QR sale de src/lib/qr.ts — único lugar del repo que instancia una
// librería de QR (ver la regla dura de CLAUDE.md). Se genera en build, no
// en el navegador: la URL de esta página no cambia entre visitas.
//
// Esto NO pasa por urlDeCodigo()/svgDeCodigo(): esas funciones codifican en
// MAYÚSCULAS a propósito, pero eso solo funciona para códigos que resuelve
// `/r/` (insensible a mayúsculas por el [NC] de .htaccess). Esta es una ruta
// real de Astro — /MINERIA/ no existe como archivo — así que va tal cual,
// en minúsculas.
const qr = await generarQR(URL_PAGINA, { perfil: 'pantalla' });
// Perfil pantalla porque este QR se muestra en el propio diálogo o se
// escanea desde otra pantalla, no se imprime.
const qrSvg = qr.svg.replace(
  '<svg ',
  '<svg style="width:100%;height:auto;display:block" '
);

// Mensaje para WhatsApp y correo. El texto va delante del enlace: en
// WhatsApp, un mensaje que empieza con la URL desnuda se ve igual de bien,
// pero en el asunto/cuerpo del correo un enlace solo, sin contexto, parece
// spam.
const TEXTO_COMPARTIR = `INACONS en el sector minero — ${URL_PAGINA}`;
const URL_WHATSAPP = `https://wa.me/?text=${encodeURIComponent(TEXTO_COMPARTIR)}`;
const URL_CORREO = `mailto:?subject=${encodeURIComponent('INACONS en el sector minero')}&body=${encodeURIComponent(TEXTO_COMPARTIR)}`;

// Foto de fondo — la del stand de Expomina.
const IMG_FONDO = '/assets/imagenes/mineria_stand_expomina.webp';

// Personas de contacto del diálogo. Editar acá para agregar, quitar o
// corregir un dato — el markup de abajo solo itera esta lista.
const CONTACTOS = [
  {
    nombre: 'Henry Godiño Calisaya',
    cargo: 'Gerencia Comercial y Proyectos',
    email: 'hgodino@inacons.com.pe',
    telefono: '(+51) 931 145 199',
    telefonoHref: '+51931145199',
    whatsapp: '51931145199',
  },
  {
    nombre: 'Freddy Godino Calisaya',
    cargo: 'Gerencia de Operaciones',
    email: 'fgodino@inacons.com.pe',
    telefono: '(+51) 954 175 589',
    telefonoHref: '+51954175589',
    whatsapp: '51954175589',
  },
  {
    nombre: 'Emili Gómez Echavigurín',
    cargo: 'Jefe de Negocios de Ingeniería',
    email: 'egomeze@inacons.com.pe',
    telefono: '(+51) 969 707 173',
    telefonoHref: '+51969707173',
    whatsapp: '51969707173',
  },
];
---

<BaseLayout
  title="INACONS en el sector minero | INACONS"
  description="Reafirmamos nuestra presencia y experiencia en la industria minera peruana: movimiento de tierras, campamentos, obras electromecánicas e ingeniería digital."
  minimalChrome={true}
>

  <style slot="head">
    /*  Antes .mn-page envolvía TODO (hero + franja de soluciones) en un
        único bloque de min-height:100vh, así que ninguna de las dos
        secciones llegaba a ocupar la pantalla completa por sí sola.
        Ahora el hero es su propia pantalla completa y "Nuestras
        soluciones" es una sección normal debajo, a la que se llega
        scrolleando — ver docs/ESPECIFICACION.md, ya no hace falta que
        todo entre en un solo viewport. */
    .mn-hero-screen {
      position: relative;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      background: var(--c-primary);
      overflow: hidden;
    }

    .mn-bg {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
    }

    /* Velo diagonal: oscuro a la izquierda (donde va el texto) y más
       claro a la derecha (donde respira la foto). Nunca baja de 0.55
       para que el blanco del texto siga en AA sobre cualquier zona. */
    .mn-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(115deg,
        rgba(3, 8, 20, 0.93) 0%,
        rgba(3, 8, 20, 0.86) 40%,
        rgba(3, 8, 20, 0.58) 70%,
        rgba(3, 8, 20, 0.75) 100%);
    }

    .mn-brand {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      /* Área de protección del logo = altura del isotipo (34px). */
      padding: 34px var(--sp-l1);
    }

    .mn-logo { height: 34px; width: auto; display: block; }

    .mn-back {
      font-size: var(--fs-xs);
      font-weight: var(--fw-medium);
      color: var(--c-on-dark-2);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: color var(--t), border-color var(--t);
    }
    .mn-back:hover { color: var(--c-text-white); border-color: currentColor; }

    .mn-brand-right { display: flex; align-items: center; gap: var(--sp-4); }

    .mn-share-btn {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-2);
      background: transparent;
      border: 1px solid var(--c-border-dark-strong);
      border-radius: var(--radius);
      padding: var(--sp-2) var(--sp-3);
      font-family: var(--font-ui);
      font-size: var(--fs-xs);
      font-weight: var(--fw-medium);
      color: var(--c-on-dark-1);
      cursor: pointer;
      transition: background var(--t), border-color var(--t);
    }
    .mn-share-btn:hover { background: var(--c-border-dark); border-color: var(--c-border-dark-strong); }
    .mn-share-btn span { display: none; }
    @media (min-width: 480px) {
      .mn-share-btn span { display: inline; }
    }

    .mn-hero {
      position: relative;
      z-index: 2;
      flex: 1 1 auto;
      display: flex;
      align-items: center;
      gap: var(--sp-l3);
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 var(--sp-l1);
    }

    .mn-copy { flex: 0 1 560px; min-width: 0; }

    .mn-eyebrow {
      display: flex;
      align-items: center;
      gap: var(--sp-2);
      font-size: var(--fs-2xs);
      font-weight: var(--fw-semibold);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--c-accent);
      margin-bottom: var(--sp-4);
    }
    .mn-eyebrow::before {
      content: '';
      width: 28px;
      height: 1.5px;
      background: var(--c-accent);
      flex-shrink: 0;
    }

    .mn-title {
      font-size: var(--fs-display);
      font-weight: var(--fw-display);
      color: var(--c-text-white);
      line-height: 1.15;
      letter-spacing: var(--ls-tight);
      margin-bottom: var(--sp-4);
    }

    .mn-sub {
      font-size: var(--fs-md);
      color: var(--c-on-dark-2);
      line-height: 1.6;
      max-width: 44ch;
      margin-bottom: var(--sp-6);
    }

    /*  Los 4 botones apilados en columna a la derecha (como en la
        referencia impresa de Expomina) suman, junto con las cifras, más
        alto del que entra en 768px sin scroll — medido: 837px de
        contenido en un viewport de 768. Quedan en fila bajo el texto,
        que es donde sí hay ancho de sobra, y las cifras solas ocupan la
        columna derecha. */
    .mn-ctas {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-3);
    }

    /* Cifras: mismo contrato data-counter que .hero-stats en index.astro.
       .stat-num/.stat-label por defecto son de texto oscuro (design-system.css
       los define para fondo claro); acá se sobreescribe el color, igual que
       hace .hero-stat en el home, y se les da caja propia con filete de
       acento — la ficha de la referencia de Expomina. */
    .mn-badges {
      flex: 1 1 0;
      display: flex;
      flex-direction: column;
      gap: var(--sp-3);
    }
    .mn-badge {
      text-align: left;
      background: var(--c-surface-dark-2);
      border-left: 3px solid var(--c-accent);
      border-radius: var(--radius);
      padding: var(--sp-3) var(--sp-5);
    }
    /* --fs-display: mismo tamaño que usa .hero-stat .stat-num en el home
       para esta misma clase de cifra destacada — ver index.astro. */
    .mn-badge .stat-label { margin-top: var(--sp-1); }

    .mn-solutions {
      background: var(--c-bg-white);
      padding: var(--sp-6) var(--sp-l1);
    }

    .mn-solutions-inner { max-width: 1200px; margin: 0 auto; }

    .mn-solutions-label {
      font-size: var(--fs-2xs);
      font-weight: var(--fw-semibold);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--c-secondary);
      margin-bottom: var(--sp-4);
    }

    /* .feature-* ya vienen de design-system.css listos para fondo claro.
       Acá se afina el color del ícono a --c-accent-ink (--c-accent puro
       falla AA sobre blanco, 2.93:1) y se sube el tamaño de texto: en
       esta franja, a ancho completo, el tamaño por defecto del
       componente se veía chico. */
    .mn-solutions .feature-icon {
      width: 60px;
      height: 60px;
      color: var(--c-accent-ink);
    }
    .mn-solutions .feature-title { font-size: var(--fs-xl); }
    .mn-solutions .feature-desc { font-size: var(--fs-base); line-height: 1.6; }

    /* Dos columnas también en desktop (el sistema por defecto pone 4 en
       una fila a este ancho — ver design-system.css). Acá se pidió
       explícitamente dos filas de dos; el alto extra que eso agrega ya
       no tiene que entrar en una sola pantalla, así que la página
       scrollea a partir de acá y es intencional. */
    @media (min-width: 1024px) {
      .mn-solutions .feature-grid { grid-template-columns: repeat(2, 1fr); }
    }

    /*  Diálogo de compartir. El SVG del QR viaja ya con su propio
        `style` inline (ver frontmatter): es HTML crudo insertado con
        `set:html`, Astro no lo procesa como parte de la plantilla, así
        que nunca recibe el atributo de scope — un selector de página
        contra él no engancharía con nada (la Regla 1 de CLAUDE.md). */
    .mn-compartir-qr {
      width: 180px;
      margin: 0 auto var(--sp-5);
      padding: var(--sp-4);
      background: #fff;
      border: 1px solid var(--c-border-light);
      border-radius: var(--radius);
    }
    .mn-compartir-link { display: flex; gap: var(--sp-2); }
    .mn-compartir-link .form-input { flex: 1 1 auto; min-width: 0; }
    .mn-compartir-redes { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-4); }

    /* Diálogo de contacto: .dialogo/.dialogo-caja vienen del sistema
       (design-system.css) — acá solo se define la lista de personas. */
    .mn-contacto-item + .mn-contacto-item {
      margin-top: var(--sp-5);
      padding-top: var(--sp-5);
      border-top: 1px solid var(--c-border-light);
    }
    .mn-contacto-nombre {
      font-size: var(--fs-base);
      font-weight: var(--fw-semibold);
      color: var(--c-text-heading);
    }
    .mn-contacto-cargo {
      font-size: var(--fs-xs);
      color: var(--c-text-muted);
      margin-top: var(--sp-1);
      margin-bottom: var(--sp-3);
    }
    .mn-contacto-links { display: flex; flex-direction: column; gap: var(--sp-2); }
    .mn-contacto-links a {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-2);
      font-size: var(--fs-sm);
      color: var(--c-secondary);
      text-decoration: none;
    }
    .mn-contacto-links a:hover { text-decoration: underline; }
    .mn-contacto-links svg { flex-shrink: 0; color: var(--c-text-muted); }

    @media (max-width: 1023.98px) {
      /*  El hero pasa a columna acá abajo, y eso pide más alto del que
          min-height:100vh da por sí solo. Con min-height (no height) el
          bloque puede crecer más de una pantalla sin recortar nada, pero
          se deja el reset explícito igual: ya costó una tarde encontrar
          este mismo síntoma una vez (768×1024, contenido invisible) y es
          más barato dejarlo escrito que confiar en la memoria. */
      .mn-hero-screen { height: auto; overflow: visible; }
      .mn-hero {
        flex-direction: column;
        align-items: flex-start;
        padding-top: var(--sp-6);
        padding-bottom: var(--sp-6);
        gap: var(--sp-6);
      }
      .mn-badges { width: 100%; flex-direction: row; flex-wrap: wrap; }
      .mn-badge { flex: 1 1 200px; }
    }

    @media (max-width: 767.98px) {
      .mn-brand { padding: var(--sp-5) var(--sp-4); }
      .mn-hero { padding: 0 var(--sp-4); }
      .mn-title { font-size: clamp(1.6rem, 7vw, 2.25rem); }
      .mn-sub { max-width: none; }
      .mn-ctas .btn { flex: 1 1 calc(50% - var(--sp-3) / 2); }
      .mn-solutions { padding: var(--sp-5) var(--sp-4) var(--sp-6); }
    }

    @media (max-width: 479.98px) {
      .mn-ctas .btn { flex: 1 1 100%; }
    }
  </style>

  <div class="mn-hero-screen">
    <div class="mn-bg" style={`background-image: url('${IMG_FONDO}')`}></div>
    <div class="mn-overlay"></div>

    <div class="mn-brand">
      <img
        src="/assets/imagenes/logos/logo_inacons_white.svg"
        alt="INACONS"
        class="mn-logo"
        width="150"
        height="34"
      />
      <div class="mn-brand-right">
        <a href="/" class="mn-back">inacons.com.pe</a>
        <button type="button" class="mn-share-btn" data-abrir="dlg-compartir" aria-haspopup="dialog">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="10.51" y2="6.49"/><line x1="8.59" x2="15.42" y1="13.49" y2="17.51"/></svg>
          <span>Compartir</span>
        </button>
      </div>
    </div>

    <div class="mn-hero">
      <div class="mn-copy">
        <p class="mn-eyebrow" data-aos="fade-up">INACONS en el sector minero</p>
        <h1 class="mn-title" data-aos="fade-up" data-aos-delay="80">
          INACONS presente en EXPOMINA 2026
        </h1>
        <p class="mn-sub" data-aos="fade-up" data-aos-delay="160">
          Confianza construida, Operación Asegurada
        </p>

        <div class="mn-ctas" data-aos="fade-up" data-aos-delay="240">
          <a class="btn btn-primary btn-lg" href={URL_BROCHURE} target="_blank" rel="noopener">
            Brochure
          </a>
          <button type="button" class="btn btn-primary btn-lg" data-abrir="dlg-contacto" aria-haspopup="dialog">
            Contacto
          </button>
          <a class="btn btn-primary btn-lg" href={URL_DOCUMENTOS}>
            Documentos
          </a>
        </div>
      </div>

      <div class="mn-badges" data-aos="fade-left" data-aos-delay="200">
        <div class="mn-badge card--stat card--stat-lg card--stat-oscuro">
          <span class="stat-num" data-counter="15" data-suffix="+">15+</span>
          <span class="stat-label">Años de trayectoria</span>
        </div>
        <div class="mn-badge card--stat card--stat-lg card--stat-oscuro">
          <span class="stat-num" data-counter="4" data-suffix="+">4+</span>
          <span class="stat-label">ISOs certificadas</span>
        </div>
        <div class="mn-badge card--stat card--stat-lg card--stat-oscuro">
          <span class="stat-num" data-counter="200" data-suffix="+">200+</span>
          <span class="stat-label">Profesionales</span>
        </div>
      </div>
    </div>
  </div>

  <div class="mn-solutions">
    <div class="mn-solutions-inner">
      <p class="mn-solutions-label">Nuestras soluciones</p>
      <div class="feature-grid">
          <div class="feature-item">
            <span class="feature-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 3 4 8 5-5 5 15H2L8 3Z"/></svg>
            </span>
            <h2 class="feature-title">Movimiento de Tierras</h2>
            <p class="feature-desc">Corte, relleno y nivelación de terrenos a gran escala</p>
          </div>
          <div class="feature-item">
            <span class="feature-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V10l8-6 8 6v11"/><path d="M9 21v-6h6v6"/></svg>
            </span>
            <h2 class="feature-title">Campamentos Mineros</h2>
            <p class="feature-desc">Construcción de vías, redes sanitarias, eléctricas y edificaciones</p>
          </div>
          <div class="feature-item">
            <span class="feature-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </span>
            <h2 class="feature-title">Obras Electromecánicas</h2>
            <p class="feature-desc">Bombeo, subestaciones e instrumentación, mantenimiento industrial</p>
          </div>
          <div class="feature-item">
            <span class="feature-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </span>
            <h2 class="feature-title">Ingeniería Digital</h2>
            <p class="feature-desc">BIM, drones y LIDAR para reducir tiempos y errores en obra</p>
          </div>
      </div>
    </div>
  </div>

  <!-- Diálogo de contacto — abre desde el botón "Contacto" de arriba -->
  <div class="dialogo" id="dlg-contacto" role="dialog" aria-modal="true" aria-labelledby="dlg-contacto-titulo" hidden>
    <div class="dialogo-caja">
      <button type="button" class="dialogo-cerrar" data-cerrar="dlg-contacto" aria-label="Cerrar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>

      <h3 class="dialogo-titulo" id="dlg-contacto-titulo">Contacto comercial</h3>
      <p class="dialogo-desc">Escribe o llama directamente al área que corresponda.</p>

      {CONTACTOS.map((c) => (
        <div class="mn-contacto-item">
          <p class="mn-contacto-nombre">{c.nombre}</p>
          <p class="mn-contacto-cargo">{c.cargo}</p>
          <div class="mn-contacto-links">
            <a href={`mailto:${c.email}`}>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              {c.email}
            </a>
            <a href={`tel:${c.telefonoHref}`}>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.64 2.84h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.09a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              {c.telefono}
            </a>
            <a href={`https://wa.me/${c.whatsapp}`} target="_blank" rel="noopener">
