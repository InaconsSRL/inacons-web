---
import BaseLayout from '../layouts/BaseLayout.astro';

// Destinos de los CTA. Editar acá cuando se confirmen las URLs finales —
// "Brochure" ya apunta al mismo destino que usa el resto del sitio (ver
// src/pages/expomina.astro). "Contacto" no navega: abre el diálogo con las
// personas de contacto (más abajo en este mismo archivo).
const URL_BROCHURE  = '/assets/documentos/brochure_inacons.pdf';
const URL_SITIO_WEB = '/';
const URL_DOCUMENTOS = '/documentos/';

// Foto de fondo — la del stand de Expomina.
const IMG_FONDO = '/assets/imagenes/mineria_stand_expomina.webp';

// Personas de contacto del diálogo. Editar acá para agregar, quitar o
// corregir un dato — el markup de abajo solo itera esta lista.
const CONTACTOS = [
  {
    nombre: 'Henry Godiño Calisaya',
    cargo: 'Gerencia Comercial y Proyectos',
    email: 'hgodino@inacons.com.pe',
    telefono: '(+51) 931 145 199',
    telefonoHref: '+51931145199',
  },
  {
    nombre: 'Freddy Godino Calisaya',
    cargo: 'Gerencia de Operaciones',
    email: 'fgodino@inacons.com.pe',
    telefono: '(+51) 954 175 589',
    telefonoHref: '+51954175589',
  },
  {
    nombre: 'Emili Gómez Echavigurín',
    cargo: 'Jefe de Negocios de Ingeniería',
    email: 'egomeze@inacons.com.pe',
    telefono: '(+51) 969 707 173',
    telefonoHref: '+51969707173',
  },
];
---

<BaseLayout
  title="INACONS en el sector minero | INACONS"
  description="Reafirmamos nuestra presencia y experiencia en la industria minera peruana: movimiento de tierras, campamentos, obras electromecánicas e ingeniería digital."
  minimalChrome={true}
>

  <style slot="head">
    .mn-page {
      position: relative;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      background: var(--c-primary);
      overflow: hidden;
    }

    .mn-bg {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
    }

    /* Velo diagonal: oscuro a la izquierda (donde va el texto) y más
       claro a la derecha (donde respira la foto). Nunca baja de 0.55
       para que el blanco del texto siga en AA sobre cualquier zona. */
    .mn-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(115deg,
        rgba(3, 8, 20, 0.93) 0%,
        rgba(3, 8, 20, 0.86) 40%,
        rgba(3, 8, 20, 0.58) 70%,
        rgba(3, 8, 20, 0.75) 100%);
    }

    .mn-brand {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      /* Área de protección del logo = altura del isotipo (34px). */
      padding: 34px var(--sp-l1);
    }

    .mn-logo { height: 34px; width: auto; display: block; }

    .mn-back {
      font-size: var(--fs-xs);
      font-weight: var(--fw-medium);
      color: var(--c-on-dark-2);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: color var(--t), border-color var(--t);
    }
    .mn-back:hover { color: var(--c-text-white); border-color: currentColor; }

    .mn-hero {
      position: relative;
      z-index: 2;
      flex: 1 1 auto;
      display: flex;
      align-items: center;
      gap: var(--sp-l3);
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 var(--sp-l1);
    }

    .mn-copy { flex: 1 1 auto; min-width: 0; max-width: 560px; }

    .mn-eyebrow {
      display: flex;
      align-items: center;
      gap: var(--sp-2);
      font-size: var(--fs-2xs);
      font-weight: var(--fw-semibold);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--c-accent);
      margin-bottom: var(--sp-4);
    }
    .mn-eyebrow::before {
      content: '';
      width: 28px;
      height: 1.5px;
      background: var(--c-accent);
      flex-shrink: 0;
    }

    .mn-title {
      font-size: var(--fs-display);
      font-weight: var(--fw-display);
      color: var(--c-text-white);
      line-height: 1.15;
      letter-spacing: var(--ls-tight);
      margin-bottom: var(--sp-4);
    }

    .mn-sub {
      font-size: var(--fs-md);
      color: var(--c-on-dark-2);
      line-height: 1.6;
      max-width: 44ch;
      margin-bottom: var(--sp-6);
    }

    /*  Los 4 botones apilados en columna a la derecha (como en la
        referencia impresa de Expomina) suman, junto con las cifras, más
        alto del que entra en 768px sin scroll — medido: 837px de
        contenido en un viewport de 768. Quedan en fila bajo el texto,
        que es donde sí hay ancho de sobra, y las cifras solas ocupan la
        columna derecha. */
    .mn-ctas {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-3);
    }

    /* Cifras: mismo contrato data-counter que .hero-stats en index.astro.
       .stat-num/.stat-label por defecto son de texto oscuro (design-system.css
       los define para fondo claro); acá se sobreescribe el color, igual que
       hace .hero-stat en el home, y se les da caja propia con filete de
       acento — la ficha de la referencia de Expomina. */
    .mn-badges {
      flex: 0 0 auto;
      width: 200px;
      display: flex;
      flex-direction: column;
      gap: var(--sp-3);
    }
    .mn-badge {
      text-align: left;
      background: var(--c-surface-dark-2);
      border-left: 3px solid var(--c-accent);
      border-radius: var(--radius);
      padding: var(--sp-3) var(--sp-4);
    }
    .mn-badge .stat-num { color: var(--c-text-white); font-size: var(--fs-xl); }
    .mn-badge .stat-label { color: var(--c-on-dark-3); margin-top: var(--sp-1); }

    .mn-solutions {
      position: relative;
      z-index: 2;
      background: var(--c-bg-white);
      padding: var(--sp-6) var(--sp-l1);
    }

    .mn-solutions-inner { max-width: 1200px; margin: 0 auto; }

    .mn-solutions-label {
      font-size: var(--fs-2xs);
      font-weight: var(--fw-semibold);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--c-secondary);
      margin-bottom: var(--sp-4);
    }

    /* .feature-* ya vienen de design-system.css listos para fondo claro.
       Acá solo se afina el color del ícono a --c-accent-ink: --c-accent
       puro falla AA sobre blanco (2.93:1), la razón por la que el sistema
       tiene ese segundo tono. */
    .mn-solutions .feature-icon { color: var(--c-accent-ink); }

    /* Diálogo de contacto: .dialogo/.dialogo-caja vienen del sistema
       (design-system.css) — acá solo se define la lista de personas. */
    .mn-contacto-item + .mn-contacto-item {
      margin-top: var(--sp-5);
      padding-top: var(--sp-5);
      border-top: 1px solid var(--c-border-light);
    }
    .mn-contacto-nombre {
      font-size: var(--fs-base);
      font-weight: var(--fw-semibold);
      color: var(--c-text-heading);
    }
    .mn-contacto-cargo {
      font-size: var(--fs-xs);
      color: var(--c-text-muted);
      margin-top: var(--sp-1);
      margin-bottom: var(--sp-3);
    }
    .mn-contacto-links { display: flex; flex-direction: column; gap: var(--sp-2); }
    .mn-contacto-links a {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-2);
      font-size: var(--fs-sm);
      color: var(--c-secondary);
      text-decoration: none;
    }
    .mn-contacto-links a:hover { text-decoration: underline; }
    .mn-contacto-links svg { flex-shrink: 0; color: var(--c-text-muted); }

    @media (max-width: 1023.98px) {
      /*  El hero pasa a columna acá abajo, y eso pide más alto del que
          entra en una pantalla. Sin este cambio, .mn-page se queda en
          height:100vh + overflow:hidden y recorta todo lo que no entra
          en lugar de dejarlo scrollear — se vio vacío en 768×1024 hasta
          que se detectó probando, no leyendo. */
      .mn-page { height: auto; overflow: visible; }
      .mn-hero {
        flex-direction: column;
        align-items: flex-start;
        padding-top: var(--sp-6);
        padding-bottom: var(--sp-6);
        gap: var(--sp-6);
      }
      .mn-badges { width: 100%; flex-direction: row; flex-wrap: wrap; }
      .mn-badge { flex: 1 1 200px; }
    }

    @media (max-width: 767.98px) {
      .mn-brand { padding: var(--sp-5) var(--sp-4); }
      .mn-hero { padding: 0 var(--sp-4); }
      .mn-title { font-size: clamp(1.6rem, 7vw, 2.25rem); }
      .mn-sub { max-width: none; }
      .mn-ctas .btn { flex: 1 1 calc(50% - var(--sp-3) / 2); }
      .mn-solutions { padding: var(--sp-5) var(--sp-4) var(--sp-6); }
    }

    @media (max-width: 479.98px) {
      .mn-ctas .btn { flex: 1 1 100%; }
    }
  </style>

  <div class="mn-page">
    <div class="mn-bg" style={`background-image: url('${IMG_FONDO}')`}></div>
    <div class="mn-overlay"></div>

    <div class="mn-brand">
      <img
        src="/assets/imagenes/logos/logo_inacons_white.svg"
        alt="INACONS"
        class="mn-logo"
        width="150"
        height="34"
      />
      <a href="/" class="mn-back">home.inacons.com.pe</a>
    </div>

    <div class="mn-hero">
      <div class="mn-copy">
        <p class="mn-eyebrow" data-aos="fade-up">INACONS en el sector minero</p>
        <h1 class="mn-title" data-aos="fade-up" data-aos-delay="80">
          INACONS presente en EXPOMINA 2026
        </h1>
        <p class="mn-sub" data-aos="fade-up" data-aos-delay="160">
          Reafirmamos nuestra presencia y experiencia en la industria minera peruana.
        </p>

        <div class="mn-ctas" data-aos="fade-up" data-aos-delay="240">
          <a class="btn btn-accent btn-lg" href={URL_BROCHURE} target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            Brochure
          </a>
          <button type="button" class="btn btn-primary btn-lg" data-abrir="dlg-contacto" aria-haspopup="dialog">
            Contacto
          </button>
          <a class="btn btn-outline-light btn-lg" href={URL_SITIO_WEB}>
            Sitio web
          </a>
          <a class="btn btn-outline-light btn-lg" href={URL_DOCUMENTOS}>
            Documentos
          </a>
        </div>
      </div>

      <div class="mn-badges" data-aos="fade-left" data-aos-delay="200">
        <div class="mn-badge card--stat">
          <span class="stat-num" data-counter="15" data-suffix="+">15+</span>
          <span class="stat-label">Años de trayectoria</span>
        </div>
        <div class="mn-badge card--stat">
          <span class="stat-num" data-counter="4" data-suffix="+">4+</span>
          <span class="stat-label">ISOs certificadas</span>
        </div>
        <div class="mn-badge card--stat">
          <span class="stat-num" data-counter="200" data-suffix="+">200+</span>
          <span class="stat-label">Profesionales</span>
        </div>
      </div>
    </div>

    <div class="mn-solutions">
      <div class="mn-solutions-inner">
        <p class="mn-solutions-label">Nuestras soluciones</p>
        <div class="feature-grid">
          <div class="feature-item">
            <span class="feature-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 3 4 8 5-5 5 15H2L8 3Z"/></svg>
            </span>
            <h2 class="feature-title">Movimiento de Tierras</h2>
            <p class="feature-desc">Corte, relleno y nivelación de terrenos a gran escala</p>
          </div>
          <div class="feature-item">
            <span class="feature-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V10l8-6 8 6v11"/><path d="M9 21v-6h6v6"/></svg>
            </span>
            <h2 class="feature-title">Campamentos Mineros</h2>
            <p class="feature-desc">Construcción de vías, redes sanitarias, eléctricas y edificaciones</p>
          </div>
          <div class="feature-item">
            <span class="feature-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </span>
            <h2 class="feature-title">Obras Electromecánicas</h2>
            <p class="feature-desc">Bombeo, subestaciones e instrumentación, mantenimiento industrial</p>
          </div>
          <div class="feature-item">
            <span class="feature-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </span>
            <h2 class="feature-title">Ingeniería Digital</h2>
            <p class="feature-desc">BIM, drones y LIDAR para reducir tiempos y errores en obra</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Diálogo de contacto — abre desde el botón "Contacto" de arriba -->
  <div class="dialogo" id="dlg-contacto" role="dialog" aria-modal="true" aria-labelledby="dlg-contacto-titulo" hidden>
    <div class="dialogo-caja">
      <button type="button" class="dialogo-cerrar" data-cerrar="dlg-contacto" aria-label="Cerrar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>

      <h3 class="dialogo-titulo" id="dlg-contacto-titulo">Contacto comercial</h3>
      <p class="dialogo-desc">Escribe o llama directamente al área que corresponda.</p>

      {CONTACTOS.map((c) => (
        <div class="mn-contacto-item">
          <p class="mn-contacto-nombre">{c.nombre}</p>
          <p class="mn-contacto-cargo">{c.cargo}</p>
          <div class="mn-contacto-links">
            <a href={`mailto:${c.email}`}>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              {c.email}
            </a>
            <a href={`tel:${c.telefonoHref}`}>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.64 2.84h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.09a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              {c.telefono}
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <script>
    // Mismo patrón que src/pages/panel/index.astro: hidden (no clase),
    // bloquear scroll del fondo y devolver el foco a quien abrió.
    let ultimoFoco: HTMLElement | null = null;

    function abrir(id: string) {
      const el = document.getElementById(id);
      if (!el) return;
      ultimoFoco = document.activeElement as HTMLElement;
      el.hidden = false;
      document.body.style.overflow = 'hidden';
      el.querySelector<HTMLElement>('button, a')?.focus();
    }

    function cerrar(id: string) {
      const el = document.getElementById(id);
      if (!el) return;
      el.hidden = true;
      document.body.style.overflow = '';
      ultimoFoco?.focus();
    }

    document.querySelectorAll<HTMLElement>('[data-abrir]').forEach((b) =>
      b.addEventListener('click', () => abrir(b.getAttribute('data-abrir')!))
    );
    document.querySelectorAll<HTMLElement>('[data-cerrar]').forEach((b) =>
      b.addEventListener('click', () => cerrar(b.getAttribute('data-cerrar')!))
    );
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document.querySelectorAll<HTMLElement>('.dialogo:not([hidden])').forEach((d) => cerrar(d.id));
    });
  </script>

</BaseLayout>
