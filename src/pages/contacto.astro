                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </div>
              <div>
                <p class="c-info-label">Correo Ventas</p>
                <p class="c-info-value"><a href="mailto:ventas@inacons.com.pe">ventas@inacons.com.pe</a></p>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="c-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </div>
              <div>
                <p class="c-info-label">Correo Gerencia</p>
                <p class="c-info-value"><a href="mailto:gerencia.proyectos@inacons.com.pe">gerencia.proyectos@inacons.com.pe</a></p>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="c-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.64 2.84h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.09a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <p class="c-info-label">Teléfono</p>
                <p class="c-info-value"><a href="tel:+5164654736">+51 064 654 736</a></p>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="c-icon">
