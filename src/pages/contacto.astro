            </a>
          </div>
        </div>

        <!-- Columna derecha: formulario -->
        <div data-aos="fade-left" data-aos-duration="800">
          <div class="contact-form-wrap">
            <div class="sh sh--left" style="margin-bottom:28px;">
              <p class="sh-label">Formulario de Contacto</p>
              <h2 class="sh-title" style="font-size:1.3rem;">Cuéntanos sobre tu proyecto</h2>
              <p class="sh-desc">Completa el formulario y nos pondremos en contacto a la brevedad.</p>
            </div>

            <!-- Mensaje de éxito (oculto hasta que envíe) -->
            <div class="form-success" id="formSuccess">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
              <h3>¡Listo!</h3>
              <p>Se abrió tu cliente de correo con el mensaje preparado. Complétalo y envíalo a <strong>ventas@inacons.com.pe</strong>.<br>Si no ves la ventana, revisa bloqueadores o escríbenos directamente a ese correo.</p>
            </div>

            <form id="contactForm" novalidate>
              <div class="form-row">
                <div class="form-group">
                  <label for="fullName">Nombre Completo *</label>
                  <input type="text" id="fullName" name="fullName" class="form-input" placeholder="Tu nombre" required />
                </div>
                <div class="form-group">
                  <label for="email">Correo Electrónico *</label>
                  <input type="email" id="email" name="email" class="form-input" placeholder="tu@correo.com" required />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="phone">Teléfono *</label>
                  <input type="tel" id="phone" name="phone" class="form-input" placeholder="+51 000 000 000" required />
                </div>
                <div class="form-group">
                  <label for="service">Servicio de Interés *</label>
                  <select id="service" name="service" class="form-select" required>
                    <option value="">Selecciona un servicio</option>
                    <option value="obras-civiles">Obras Civiles</option>
                    <option value="infraestructura">Infraestructura</option>
                    <option value="electromecanica">Electromecánica</option>
                    <option value="paisajismo">Paisajismo</option>
                    <option value="mineria">Minería</option>
                    <option value="consultoria">Consultoría</option>
                    <option value="otro">Otro</option>
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label for="message">Mensaje *</label>
                <textarea id="message" name="message" class="form-textarea" placeholder="Describe tu proyecto o consulta..." required></textarea>
              </div>
              <input type="text" name="company_url" tabindex="-1" autocomplete="off"
       aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0;">
              <button type="submit" class="form-submit" id="formSubmit">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                Enviar Mensaje
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ② UBICACIÓN -->
  <section class="sec sec--muted">
    <div class="container">
      <div class="sh sh--left sh--narrow" data-aos="fade-up">
        <p class="sh-label">Ubicación</p>
        <h2 class="sh-title">Encuéntranos en nuestras oficinas</h2>
      </div>
      <div class="location-grid">
        <div data-aos="fade-right">
          <div class="location-items">
            <div class="location-item">
              <div class="loc-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <p class="loc-name">Oficina Principal — Lima</p>
                <p class="loc-addr">Av. Las Casuarinas 256<br>Pucusana, Lima — Perú</p>
              </div>
            </div>
            <div class="location-item">
              <div class="loc-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <p class="loc-name">Oficina Regional — Huancayo</p>
                <p class="loc-addr">Calle Casuarinas 112<br>El Tambo, Huancayo — Perú</p>
              </div>
            </div>
          </div>
        </div>
        <div class="map-wrap" data-aos="fade-left">
          <!-- Embed apuntando a Pucusana, Lima (INACONS oficina principal) -->
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3900.5!2d-76.7344!3d-12.4762!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTLCsDI4JzM0LjMiUyA3NsKwNDQnMDMuOCJX!5e0!3m2!1ses!2spe!4v1700000000000!5m2!1ses!2spe"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación INACONS — Pucusana, Lima">
          </iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- ③ CANAL -->
  <section class="channel-band">
