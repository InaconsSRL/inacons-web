---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icono from '../components/Icono.astro';
import PestanaNueva from '../components/PestanaNueva.astro';
import { serviciosPorMenu } from '../lib/servicios';
import { PESTANA_NUEVA } from '../lib/enlaces';
import { CONTACTO, PRIVACIDAD_PUBLICADA, enlaceWhatsapp, zonaDeSede } from '../data/empresa';
import { PUBLIC_CONTACT_ENDPOINT, PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import imagenHero from '../assets/imagenes/image_heroprincipal.webp';

const servicios = await serviciosPorMenu();
const { correoVentas, correoGerencia, telefono, whatsapp, redes, sedes } = CONTACTO;
const whatsappHref = enlaceWhatsapp('Contacto');

// Para qué escribe la persona. El primero es el de siempre y el único que pide
// servicio. Las denuncias no van aquí: tienen su propio formulario, el Canal
// Ético, que atiende el oficial de cumplimiento y admite anonimato. La lista
// está copiada en MOTIVOS de workers/contacto/src/contacto.ts y
// test/contrato.test.ts falla si se separan.
const MOTIVOS = ['Cotizar un proyecto', 'Consulta general', 'Reclamo o sugerencia', 'Proveedores'];
const [MOTIVO_COTIZAR] = MOTIVOS;
// Sin endpoint el formulario abre el correo del visitante: no hay nada que
// proteger y no se carga el script de Cloudflare.
const conTurnstile = Boolean(PUBLIC_CONTACT_ENDPOINT && PUBLIC_TURNSTILE_SITE_KEY);
---

<BaseLayout title="Contacto: cotiza tu proyecto de construcción | INACONS" description="Escríbenos para cotizar obras civiles, infraestructura o electromecánica. Oficinas en Pucusana (Lima) y El Tambo (Huancayo), teléfono y WhatsApp.">

  <style slot="head">
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: var(--sp-l3);
      align-items: start;
    }
    .contact-grid > * { min-width: 0; }
    .contact-info-items { margin-top: var(--sp-7); }
    .contact-info-item {
      display: flex;
      gap: var(--sp-4);
      align-items: flex-start;
      padding: var(--sp-5) 0;
      border-bottom: 1px solid var(--c-border-light);
    }
    .contact-info-item:first-child { border-top: 1px solid var(--c-border-light); }
    .c-icon {
      width: 44px; height: 44px;
      background: var(--c-bg-muted);
      border-radius: var(--radius);
      display: flex; align-items: center; justify-content: center;
      color: var(--c-secondary);
      flex-shrink: 0;
    }
    .c-info-label {
      font-size: var(--fs-xs); font-weight: var(--fw-semibold);
      letter-spacing: var(--ls-label); text-transform: uppercase;
      color: var(--c-text-muted); margin-bottom: var(--sp-1);
    }
    /* Los correos son una sola palabra larga: sin esto, en 360px ensanchan la
       columna del grid y la página entera gana scroll horizontal. */
    .c-info-value { font-size: var(--fs-md); font-weight: var(--fw-semibold); color: var(--c-text-heading); line-height: 1.5; overflow-wrap: anywhere; }
    .c-info-value a { color: var(--c-text-heading); text-decoration: none; transition: color var(--t); }
    .c-info-value a:hover { color: var(--c-secondary); }

    .contact-social { display: flex; gap: var(--sp-2); margin-top: var(--sp-6); }
    .contact-social a {
      width: 40px; height: 40px;
      border: 1.5px solid var(--c-border);
      border-radius: var(--radius);
      display: flex; align-items: center; justify-content: center;
      color: var(--c-text-muted); text-decoration: none;
      transition: border-color var(--t), color var(--t), background var(--t);
    }
    .contact-social a:hover {
      border-color: var(--c-secondary);
      color: var(--c-secondary);
      background: color-mix(in srgb, var(--c-secondary) 5%, transparent);
    }
    .form-sh { margin-bottom: var(--sp-7); }
    .form-sh .sh-title { font-size: var(--fs-xl); }
    .form-estado:not(:empty) { margin-bottom: var(--sp-6); }

    .location-grid {
      display: grid;
      grid-template-columns: 1fr 1.8fr;
      gap: var(--sp-l2); align-items: start;
    }
    .location-items { margin-top: var(--sp-2); }
    .location-item {
      display: flex; gap: var(--sp-4); align-items: flex-start;
      padding: var(--sp-5) 0; border-bottom: 1px solid var(--c-border-light);
    }
    .location-item:first-child { border-top: 1px solid var(--c-border-light); }
    .loc-icon {
      width: 40px; height: 40px;
      background: var(--c-bg-white);
      border: 1px solid var(--c-border-light);
      border-radius: var(--radius);
      display: flex; align-items: center; justify-content: center;
      color: var(--c-secondary); flex-shrink: 0;
    }
    .loc-name { font-size: var(--fs-sm); font-weight: var(--fw-bold); color: var(--c-text-heading); margin-bottom: var(--sp-1); }
    .loc-addr { font-size: var(--fs-sm); color: var(--c-text-muted); line-height: 1.6; }
    .map-wrap { overflow: hidden; border-radius: var(--radius); border: 1px solid var(--c-border-light); height: 380px; }
    .map-wrap iframe { width: 100%; height: 100%; border: 0; display: block; }

    /*  Aviso del Canal Ético debajo del formulario: quien busca dónde
        denunciar suele llegar a Contacto. Se le muestra el camino, pero
        fuera del formulario, porque una denuncia no va a ventas. */
    .contacto-canal { margin-top: var(--sp-5); }
    @media (max-width: 767.98px) {
      .contact-grid { grid-template-columns: 1fr; gap: var(--sp-l1); }
      .location-grid { grid-template-columns: 1fr; gap: var(--sp-7); }
      .map-wrap { height: 280px; }
    }
  </style>

  <PageHero
    image={imagenHero}
    title="Contacto y<br>cotizaciones"
    subtitle="Cotiza un proyecto, haz una consulta o cuéntanos un reclamo o sugerencia"
    current="Contacto"
  />

  <section class="sec sec--white">
    <div class="container">
      <div class="contact-grid">

        <div data-aos="fade-right" data-aos-duration="800">
          <div class="sh sh--left sh--narrow">
            <p class="sh-label">Información de contacto</p>
            <h2 class="sh-title">Conecta con nosotros</h2>
            <p class="sh-desc">Estamos disponibles para atender tus consultas y proyectos.</p>
          </div>
          <div class="contact-info-items">
            <div class="contact-info-item">
              <div class="c-icon"><Icono nombre="correo" tam={20} /></div>
              <div>
                <p class="c-info-label">Correo de ventas</p>
                <p class="c-info-value"><a href={`mailto:${correoVentas}`}>{correoVentas}</a></p>
              </div>
            </div>
            <div class="contact-info-item">
              <div class="c-icon"><Icono nombre="correo" tam={20} /></div>
              <div>
                <p class="c-info-label">Correo de gerencia</p>
                <p class="c-info-value"><a href={`mailto:${correoGerencia}`}>{correoGerencia}</a></p>
              </div>
            </div>
            <div class="contact-info-item">
              <div class="c-icon"><Icono nombre="telefono" tam={20} /></div>
              <div>
                <p class="c-info-label">Teléfono</p>
                <p class="c-info-value"><a href={telefono.href}>{telefono.texto}</a></p>
              </div>
            </div>
            <div class="contact-info-item">
              <div class="c-icon"><Icono nombre="whatsapp" tam={20} /></div>
              <div>
                <p class="c-info-label">WhatsApp</p>
                <p class="c-info-value"><a href={whatsappHref} target="_blank" rel="noopener">{whatsapp.texto}<PestanaNueva /></a></p>
              </div>
            </div>
          </div>

          <div class="contact-social">
            <a href={whatsappHref} target="_blank" rel="noopener" aria-label={`WhatsApp ${PESTANA_NUEVA}`}><Icono nombre="whatsapp" tam={20} /></a>
            <a href={redes.facebook} target="_blank" rel="noopener" aria-label={`Facebook ${PESTANA_NUEVA}`}><Icono nombre="facebook" tam={20} /></a>
            <a href={redes.linkedin} target="_blank" rel="noopener" aria-label={`LinkedIn ${PESTANA_NUEVA}`}><Icono nombre="linkedin" tam={20} /></a>
          </div>
        </div>

        <div data-aos="fade-left" data-aos-duration="800">
          <div class="panel panel--accent panel--raised">
            <div class="sh sh--left form-sh">
              <p class="sh-label">Formulario de contacto</p>
              <h2 class="sh-title">Escríbenos</h2>
              <p class="sh-desc">Completa el formulario y te responderemos a la brevedad.</p>
            </div>

            <!-- El script pinta aquí el resultado del envío. role="status" lo anuncia sin mover el foco. -->
            <div class="form-estado" id="formEstado" role="status" aria-live="polite"></div>

            <noscript>
              <div class="notice notice--warn">
                Para enviar el formulario hace falta tener JavaScript activado. También puedes escribirnos a <a href={`mailto:${correoVentas}`}>{correoVentas}</a>.
              </div>
            </noscript>

            <!--
              method="post" aunque el script siempre intercepta el envío: si el
              script no carga, un GET pondría nombre, correo y mensaje en la URL,
              el historial y los logs del hosting. Por lo mismo el botón sale
              apagado y lo enciende conectarFormulario().
            -->
            <form id="contactForm" method="post" novalidate data-correo={correoVentas}>
              <div class="form-row">
                <div class="form-group">
                  <label for="fullName">Nombre completo *</label>
                  <input type="text" id="fullName" name="nombre" class="form-input" autocomplete="name" maxlength="120" required />
                </div>
                <div class="form-group">
                  <label for="email">Correo electrónico *</label>
                  <input type="email" id="email" name="correo" class="form-input" autocomplete="email" maxlength="160" required />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="phone">Teléfono *</label>
                  <input type="tel" id="phone" name="telefono" class="form-input" autocomplete="tel" maxlength="30" required />
                </div>
                <div class="form-group">
                  <label for="company">Empresa</label>
                  <input type="text" id="company" name="empresa" class="form-input" autocomplete="organization" maxlength="160" />
                </div>
              </div>
              <div class="form-group">
                <label for="motivo">¿En qué te ayudamos? *</label>
                <select id="motivo" name="motivo" class="form-select" required>
                  <option value="">Selecciona un motivo</option>
                  {MOTIVOS.map((m) => <option value={m}>{m}</option>)}
                </select>
              </div>
              <!--
                Solo al cotizar: el servicio dice a quién derivar. En los demás
                motivos el grupo se oculta y el select queda disabled, que lo
                saca de la validación y del envío. Sale oculto: sin JavaScript
                el formulario no se envía de todos modos (ver <noscript>).
              -->
              <div class="form-group" id="grupoServicio" data-motivo={MOTIVO_COTIZAR} hidden>
                <label for="service">Servicio de interés *</label>
                <select id="service" name="servicio" class="form-select" required disabled>
                  <option value="">Selecciona un servicio</option>
                  {servicios.map((s) => <option value={s.data.titulo}>{s.data.titulo}</option>)}
                  <option value="Otro">Otro</option>
                </select>
              </div>
              <div class="form-group">
                <label for="message">Mensaje *</label>
                <textarea id="message" name="mensaje" class="form-textarea" maxlength="3000" required></textarea>
              </div>
              <!-- Campo trampa: invisible para personas, los bots lo rellenan. -->
              <input type="text" name="company_url" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
              {conTurnstile && (
                <div class="form-group">
                  <div class="cf-turnstile" data-sitekey={PUBLIC_TURNSTILE_SITE_KEY} data-action="contacto" data-language="es" data-theme="light" data-size="flexible"></div>
                </div>
              )}
              <p class="form-hint">Usaremos tus datos solo para responder esta consulta{PRIVACIDAD_PUBLICADA && <> (<a href="/privacidad/">política de privacidad</a>)</>}. Los campos con * son obligatorios.</p>
              <button type="submit" class="btn btn-primary btn-block" id="formSubmit" disabled>
                <Icono nombre="enviar" tam={14} />
                Enviar mensaje
              </button>
            </form>
          </div>
          <div class="notice notice--info contacto-canal">
            ¿Quieres reportar una conducta contraria a la ética o a la ley? Usa el <a href="/canal-etico/">Canal Ético</a>:
            es confidencial, admite reportes anónimos y lo atiende el área de cumplimiento, no ventas.
          </div>
        </div>

      </div>
    </div>
  </section>
  {conTurnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

  <section class="sec sec--muted">
    <div class="container">
      <div class="sh sh--left sh--narrow" data-aos="fade-up">
        <p class="sh-label">Ubicación</p>
        <h2 class="sh-title">Encuéntranos en nuestras oficinas</h2>
      </div>
      <div class="location-grid">
        <div data-aos="fade-right">
          <div class="location-items">
            {sedes.map((sede) => (
              <div class="location-item">
                <div class="loc-icon"><Icono nombre="ubicacion" tam={20} /></div>
                <div>
                  <p class="loc-name">{sede.nombre}</p>
                  <p class="loc-addr">{sede.direccion}<br />{zonaDeSede(sede)}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="map-wrap" data-aos="fade-left">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3900.5!2d-76.7344!3d-12.4762!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTLCsDI4JzM0LjMiUyA3NsKwNDQnMDMuOCJX!5e0!3m2!1ses!2spe!4v1700000000000!5m2!1ses!2spe"
            allowfullscreen
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title="Ubicación INACONS — Pucusana, Lima">
          </iframe>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { PUBLIC_CONTACT_ENDPOINT as ENDPOINT } from 'astro:env/client';
    import { aviso as avisar, conectarFormulario, type TipoAviso } from '../scripts/formulario';

    /*
      Envío del formulario.

      Con PUBLIC_CONTACT_ENDPOINT definida en el build, se envía por POST como
      JSON y solo se declara éxito si el servidor responde 2xx. Es el punto de
      enchufe del sistema nuevo: el contrato está en docs/contenido.md.

      Sin endpoint, se abre el programa de correo del visitante con el mensaje
      armado. Eso no confirma nada —no se puede saber si se envió—, así que no
      se dice "¡Listo!", el formulario no se oculta y se ofrece copiar el texto.
    */
    const LIMITE_MAILTO = 1800;

    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    const boton = document.getElementById('formSubmit') as HTMLButtonElement | null;
    const estado = document.getElementById('formEstado');

    const aviso = (tipo: TipoAviso, html: string) => avisar(estado, tipo, html);

    function textoDelMensaje(d: Record<string, string>) {
      return [
        'Mensaje desde el formulario web de INACONS',
        '',
        `Nombre: ${d.nombre}`,
        `Correo: ${d.correo}`,
        `Teléfono: ${d.telefono}`,
        `Empresa: ${d.empresa || '—'}`,
        `Motivo: ${d.motivo}`,
        ...(d.servicio ? [`Servicio de interés: ${d.servicio}`] : []),
        '',
        d.mensaje,
      ].join('\n');
    }

    function abrirCorreo(correo: string, datos: Record<string, string>) {
      const cuerpo = textoDelMensaje(datos);
      const asunto = ['Consulta web', datos.motivo, datos.servicio, datos.nombre].filter(Boolean).join(' — ');
      const enlace = `mailto:${correo}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;

      const cabe = enlace.length <= LIMITE_MAILTO;
      if (cabe) window.location.href = enlace;

      aviso('info',
        (cabe
          ? `<strong>Abrimos tu programa de correo con el mensaje listo.</strong> Revísalo y envíalo desde ahí. Si no se abrió nada, `
          : `<strong>Tu mensaje es demasiado largo para abrirlo en el correo.</strong> `) +
        `copia el mensaje y envíalo a <a href="mailto:${correo}">${correo}</a>.` +
        `<br><button type="button" class="btn btn-outline btn-sm" id="copiarMensaje">Copiar mensaje</button>`);

      document.getElementById('copiarMensaje')?.addEventListener('click', async (e) => {
        const b = e.currentTarget as HTMLButtonElement;
        try {
          await navigator.clipboard.writeText(cuerpo);
          b.textContent = 'Mensaje copiado';
        } catch {
          b.textContent = `No se pudo copiar: escribe a ${correo}`;
        }
      });
    }

    // El servicio solo aplica al cotizar. disabled lo saca de checkValidity()
    // y de FormData: el Worker recibe servicio solo cuando corresponde.
    const motivo = document.getElementById('motivo') as HTMLSelectElement | null;
    const grupoServicio = document.getElementById('grupoServicio');
    const servicio = document.getElementById('service') as HTMLSelectElement | null;
    const sincronizarServicio = () => {
      const cotiza = motivo?.value === grupoServicio?.dataset.motivo;
      if (grupoServicio) grupoServicio.hidden = !cotiza;
      if (servicio) servicio.disabled = !cotiza;
    };
    motivo?.addEventListener('change', sincronizarServicio);
    sincronizarServicio();

    // El orden del envío (validar, trampa, Turnstile, fetch, avisos) es común
    // con el Canal Ético y vive en scripts/formulario.ts.
    const correo = form?.dataset.correo ?? '';
    if (form) {
      conectarFormulario({
        form,
        boton,
        estado,
        url: ENDPOINT || null,
        sinEndpoint: (datos) => abrirCorreo(correo, datos),
        exito: () => '<strong>Mensaje enviado.</strong> Te responderemos a la brevedad.',
        // form.reset() vuelve el motivo a "Selecciona": el servicio se esconde otra vez.
        alLimpiar: sincronizarServicio,
        error: (codigo) => codigo === '429'
          ? `<strong>Ya recibimos varios mensajes tuyos en la última hora.</strong> Tus datos siguen en el formulario: ` +
            `vuelve a intentarlo más tarde o escríbenos a <a href="mailto:${correo}">${correo}</a>.`
          : `<strong>No pudimos enviar tu mensaje.</strong> Tus datos siguen en el formulario: ` +
            `inténtalo de nuevo o escríbenos a <a href="mailto:${correo}">${correo}</a>.`,
      });
    }
  </script>

</BaseLayout>
