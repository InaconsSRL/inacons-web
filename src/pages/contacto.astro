---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contacto | INACONS" description="Contáctate con INACONS para iniciar tu proyecto de construcción e ingeniería">

  <style slot="head">
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: var(--sp-l3);
      align-items: start;
    }
    .contact-info-items { margin-top: var(--sp-7); }
    .contact-info-item {
      display: flex;
      gap: var(--sp-4);
      align-items: flex-start;
      padding: var(--sp-5) 0;
      border-bottom: 1px solid var(--c-border-light);
    }
    .contact-info-item:first-child { border-top: 1px solid var(--c-border-light); }
    .c-icon {
      width: 44px; height: 44px;
      background: var(--c-bg-muted);
      border-radius: 2px;
      display: flex; align-items: center; justify-content: center;
      color: var(--c-secondary);
      flex-shrink: 0;
    }
    .c-info-label {
      font-size: var(--fs-2xs); font-weight: var(--fw-semibold);
      letter-spacing: var(--ls-label); text-transform: uppercase;
      color: var(--c-text-muted); margin-bottom: var(--sp-1);
    }
    .c-info-value { font-size: var(--fs-md); font-weight: var(--fw-semibold); color: var(--c-text-heading); line-height: 1.5; }
    .c-info-value a { color: var(--c-text-heading); text-decoration: none; transition: color .2s; }
    .c-info-value a:hover { color: var(--c-secondary); }
    .contact-social { display: flex; gap: var(--sp-2); margin-top: var(--sp-6); }
    .contact-social a {
      width: 40px; height: 40px;
      border: 1.5px solid var(--c-border);
      border-radius: 2px;
      display: flex; align-items: center; justify-content: center;
      color: var(--c-text-muted); text-decoration: none;
      transition: border-color .22s, color .22s, background .22s;
    }
    .contact-social a:hover {
      border-color: var(--c-secondary);
      color: var(--c-secondary);
      background: rgba(27,82,120,0.05);
    }
    .contact-form-wrap {
      background: var(--c-bg-white);
      border: 1px solid var(--c-border-light);
      border-top: 3px solid var(--c-secondary);
      padding: var(--sp-l1);
    }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); }
    .form-group { margin-bottom: var(--sp-4); }
    .form-group label {
      display: block; font-size: var(--fs-2xs); font-weight: var(--fw-semibold);
      letter-spacing: var(--ls-label); text-transform: uppercase;
      color: var(--c-text-muted); margin-bottom: var(--sp-2);
    }
    .form-input, .form-textarea, .form-select {
      width: 100%;
      border: 1.5px solid var(--c-border);
      border-radius: 2px;
      padding: var(--sp-3) var(--sp-3);
      font-family: 'Montserrat', sans-serif;
      font-size: var(--fs-base);
      color: var(--c-text-heading);
      background: var(--c-bg-muted);
      outline: none;
      transition: border-color .22s, box-shadow .22s, background .22s;
      -webkit-appearance: none;
    }
    .form-input:focus, .form-textarea:focus, .form-select:focus {
      border-color: var(--c-secondary);
      background: #fff;
      box-shadow: 0 0 0 3px rgba(27,82,120,0.09);
    }
    .form-input::placeholder, .form-textarea::placeholder { color: #b0b6c8; }
    .form-textarea { resize: vertical; min-height: 130px; }
    .form-submit {
      width: 100%; padding: var(--sp-3);
      background: var(--c-secondary); color: #fff;
      border: none; border-radius: 2px;
      font-family: 'Montserrat', sans-serif;
      font-size: var(--fs-sm); font-weight: var(--fw-semibold);
      letter-spacing: 1px; text-transform: uppercase;
      cursor: pointer;
      transition: background .22s, transform .22s;
      display: flex; align-items: center; justify-content: center; gap: var(--sp-2);
    }
    .form-submit:hover { background: var(--c-primary); transform: translateY(-1px); }
    .form-submit:disabled { opacity: 0.65; cursor: not-allowed; transform: none; }
    .form-success {
      display: none;
      text-align: center;
      padding: var(--sp-l1) var(--sp-5);
    }
    .form-success svg { color: #27ae60; margin-bottom: var(--sp-4); }
    .form-success h3 { font-size: var(--fs-lg); color: var(--c-primary); margin-bottom: var(--sp-2); }
    .form-success p { font-size: var(--fs-base); color: var(--c-text-muted); }
    .location-grid {
      display: grid;
      grid-template-columns: 1fr 1.8fr;
      gap: var(--sp-l2); align-items: start;
    }
    .location-items { margin-top: var(--sp-2); }
    .location-item {
      display: flex; gap: var(--sp-4); align-items: flex-start;
      padding: var(--sp-5) 0; border-bottom: 1px solid var(--c-border-light);
    }
    .location-item:first-child { border-top: 1px solid var(--c-border-light); }
    .loc-icon {
      width: 40px; height: 40px;
      background: var(--c-bg-white);
      border: 1px solid var(--c-border-light);
      border-radius: 2px;
      display: flex; align-items: center; justify-content: center;
      color: var(--c-secondary); flex-shrink: 0;
    }
    .loc-name { font-size: var(--fs-sm); font-weight: var(--fw-bold); color: var(--c-text-heading); margin-bottom: var(--sp-1); }
    .loc-addr { font-size: var(--fs-sm); color: var(--c-text-muted); line-height: 1.6; }
    .map-wrap { overflow: hidden; border-radius: 2px; border: 1px solid var(--c-border-light); height: 380px; }
    .map-wrap iframe { width: 100%; height: 100%; border: 0; display: block; }
    .channel-band { background: var(--c-primary); padding: var(--section-py) 0; }
    .channel-band .sh-label { color: rgba(255,255,255,0.70);}
    .channel-band .sh-label::before { background: rgba(255,255,255,0.25); }
    .channel-band .sh-title { color: #fff; }
    .channel-band .sh-desc  { color: rgba(255,255,255,0.62); }
    .channel-features { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-6); margin: var(--sp-l2) 0; }
    .channel-feat {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: 2px; padding: var(--sp-6) var(--sp-6);
      transition: background .22s, border-color .22s;
    }
    .channel-feat:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.20); }
    .channel-feat-icon {
      width: 44px; height: 44px;
      background: rgba(27,82,120,0.40);
      border-radius: 2px;
      display: flex; align-items: center; justify-content: center;
      color: #fff; margin-bottom: var(--sp-4);
    }
    .channel-feat-title { font-size: var(--fs-md); font-weight: var(--fw-bold); color: #fff; margin-bottom: var(--sp-1); }
    .channel-feat-desc { font-size: var(--fs-sm); color: rgba(255,255,255,0.55); line-height: 1.65; }
    .channel-cta { text-align: center; }
    @media (max-width: 768px) {
      .contact-grid { grid-template-columns: 1fr; gap: var(--sp-l1); }
      .location-grid { grid-template-columns: 1fr; gap: var(--sp-7); }
      .map-wrap { height: 280px; }
      .form-row { grid-template-columns: 1fr; }
      .channel-features { grid-template-columns: 1fr; }
      .contact-form-wrap { padding: var(--sp-6) var(--sp-5); }
      .form-submit {
    margin-bottom: var(--sp-4);
  }
    }
  </style>

  <!-- HERO -->
  <section class="page-hero page-hero--sm">
    <div class="page-hero-bg" style="background-image: url('/assets/imagenes/image_heroprincipal.webp')"></div>
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content" data-aos="fade-up" data-aos-duration="800">
      <nav class="breadcrumb">
        <a href="/">Inicio</a>
        <span class="breadcrumb-sep">›</span>
        <span class="breadcrumb-current">Contacto</span>
      </nav>
      <h1 class="page-hero-title">¿Listo para tu<br>próximo proyecto?</h1>
      <p class="page-hero-subtitle">Estamos aquí para ayudarte a materializar cada idea</p>
    </div>
  </section>

  <!-- ① FORMULARIO + INFO -->
  <section class="sec sec--white">
    <div class="container">
      <div class="contact-grid">

        <!-- Columna izquierda: info -->
        <div data-aos="fade-right" data-aos-duration="800">
          <div class="sh sh--left sh--narrow">
            <p class="sh-label">Información de Contacto</p>
            <h2 class="sh-title">Conecta con nosotros</h2>
            <p class="sh-desc">Estamos disponibles para atender tus consultas y proyectos.</p>
