  <script>
    const form = document.getElementById('contactForm') as HTMLFormElement;
    const submitBtn = document.getElementById('formSubmit') as HTMLButtonElement;
    const successMsg = document.getElementById('formSuccess') as HTMLDivElement;

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (String(new FormData(form).get('company_url') || '').trim() !== '') return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const fd = new FormData(form);
      const name = String(fd.get('fullName') || '').trim();
      const email = String(fd.get('email') || '').trim();
      const phone = String(fd.get('phone') || '').trim();
      const service = String(fd.get('service') || '').trim();
      const message = String(fd.get('message') || '').trim();

      const bodyLines = [
        'Mensaje desde el formulario web inacons.com.pe',
        '',
        `Nombre: ${name}`,
        `Correo: ${email}`,
        `Teléfono: ${phone}`,
        `Servicio de interés: ${service}`,
        '',
        'Mensaje:',
        message,
      ];
      const subject = `Consulta web — ${service || 'sin servicio'} — ${name}`;
      const mailto = `mailto:ventas@inacons.com.pe?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines.join('\n'))}`;

      const mailLen = mailto.length;
      if (mailLen > 1800) {
        alert('El mensaje es muy largo para abrirlo en el correo. Acórtalo o escríbenos directamente a ventas@inacons.com.pe');
        return;
      }

      const link = document.createElement('a');
      link.href = mailto;
      link.rel = 'noopener noreferrer';
      link.style.display = 'none';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      form.style.display = 'none';
      successMsg.style.display = 'block';
    });
  </script>

  <style is:global>
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>

