---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import MediaCard from '../../components/MediaCard.astro';

import { serviciosPorOrden } from '../../lib/servicios';
import imagenHero from '../../assets/imagenes/image_infraestructura.webp';
import imagenControl from '../../assets/imagenes/tecnologia_control.jpg';
import imagenBim from '../../assets/imagenes/tecnologia_bim.jpg';

const servicios = await serviciosPorOrden();
---

<BaseLayout title="Servicios de ingeniería y construcción | INACONS" description="Obras civiles, infraestructura, electromecánica, minería, paisajismo y consultoría para los sectores público y privado, desde Lima y Huancayo.">

  <!-- HERO -->
  <PageHero
    image={imagenHero}
    title="Servicios de ingeniería<br>y construcción"
    subtitle="Agregamos valor en cada etapa, desde la planificación hasta la entrega"
    current="Servicios"
  />

  <!-- GRID DE SERVICIOS -->
  <section class="sec sec--muted">
    <div class="container">

      <div class="sh sh--center sh--medium" data-aos="fade-up">
        <p class="sh-label">Lo que hacemos</p>
        <h2 class="sh-title">Nuestros servicios</h2>
        <p class="sh-desc">
          Ofrecemos servicios especializados que cubren todas las etapas de construcción, desde la planificación hasta la ejecución final.
        </p>
      </div>

      <div class="cards-row">
        {servicios.map((s) => (
          <MediaCard
            href={`/servicios/${s.id}/`}
            image={s.data.imagen}
            alt=""
            title={s.data.titulo}
            desc={s.data.descripcion}
            cta="Ver más"
            ratio="1/1"
            ratioMobile="4/3"
          />
        ))}
      </div>

    </div>
  </section>

  <!-- PROCESO -->
  <section class="sec sec--white">
    <div class="container">
      <div class="sh sh--center sh--medium" data-aos="fade-up">
        <p class="sh-label">Nuestro proceso</p>
        <h2 class="sh-title">Metodología de trabajo</h2>
        <p class="sh-desc">Cada proyecto sigue cuatro etapas, con control de calidad y de plazos en cada una.</p>
      </div>
      <div class="process-grid">
        <div class="feature-item feature-item--card" data-aos="fade-up" data-aos-delay="80">
          <div class="feature-num" aria-hidden="true">01</div>
          <h3 class="feature-title">Descubrimiento</h3>
          <p class="feature-desc">Analizamos a fondo las necesidades del proyecto, realizamos estudios de factibilidad y evaluamos todos los aspectos técnicos y normativos.</p>
        </div>
        <div class="feature-item feature-item--card" data-aos="fade-up" data-aos-delay="160">
          <div class="feature-num" aria-hidden="true">02</div>
          <h3 class="feature-title">Planificación y diseño</h3>
          <p class="feature-desc">Desarrollamos planos detallados, cronogramas de trabajo y especificaciones técnicas, y compatibilizamos las especialidades antes de ejecutar.</p>
        </div>
        <div class="feature-item feature-item--card" data-aos="fade-up" data-aos-delay="240">
          <div class="feature-num" aria-hidden="true">03</div>
          <h3 class="feature-title">Ejecución</h3>
          <p class="feature-desc">Implementamos el proyecto con equipos especializados, supervisión constante y control de calidad en cada etapa, bajo nuestro sistema de gestión certificado.</p>
        </div>
        <div class="feature-item feature-item--card" data-aos="fade-up" data-aos-delay="320">
          <div class="feature-num" aria-hidden="true">04</div>
          <h3 class="feature-title">Entrega y seguimiento</h3>
          <p class="feature-desc">Realizamos pruebas finales, entregamos la obra en funcionamiento y te acompañamos después de la entrega.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TECNOLOGÍA -->
  <section class="sec sec--muted">
    <div class="container">
      <div class="sh sh--center sh--medium" data-aos="fade-up">
        <p class="sh-label">Tecnología</p>
        <h2 class="sh-title">Innovación aplicada a cada proyecto</h2>
        <p class="sh-desc">Herramientas digitales para reducir errores en obra y darte información confiable de tu proyecto.</p>
      </div>
      <div class="tech-grid">
        <div class="tech-card" data-aos="fade-up" data-aos-delay="80">
          <div class="tech-img">
            <Image quality={70} src={imagenControl} alt="Supervisión Inteligente INACONS" widths={[480, 720]} sizes="(min-width: 1024px) 50vw, 100vw" />
          </div>
          <div class="tech-content">
            <p class="tech-label">Supervisión inteligente</p>
            <h3 class="tech-title">Tecnología aplicada a la supervisión y el control</h3>
            <p class="tech-desc">Implementamos soluciones de automatización y digitalización para optimizar procesos y generar información oportuna y confiable.</p>
            <p class="tech-desc">Supervisión inteligente automatizada · Control de asistencia inteligente · Digitalización de documentos de gestión · Supervisión con drones · Visita técnica con equipos LIDAR</p>
          </div>
        </div>
        <div class="tech-card" data-aos="fade-up" data-aos-delay="200">
          <div class="tech-img">
            <Image quality={70} src={imagenBim} alt="Tecnología BIM INACONS" widths={[480, 720]} sizes="(min-width: 1024px) 50vw, 100vw" />
          </div>
          <div class="tech-content">
            <p class="tech-label">Modelado digital</p>
            <h3 class="tech-title">Tecnología BIM</h3>
            <p class="tech-desc">Modelamos arquitectura, cálculo y especialidades en un modelo único coordinado, alineados al estándar ISO 19650 y al Plan BIM Perú. Compatibilizamos el diseño antes de construir, y entregamos a nuestros clientes información confiable para operar y mantener sus activos.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    label="¿Qué necesitas ejecutar?"
    title="Armamos la propuesta del servicio que buscas"
    description="Cuéntanos el alcance y nuestro equipo técnico prepara una cotización."
    primaryHref="/contacto/"
    primaryLabel="Solicitar cotización"
    secondaryHref="/proyectos/"
    secondaryLabel="Ver proyectos"
  />

</BaseLayout>

<style>
  /* Proceso */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-1);
    margin-top: var(--sp-l2);
  }

  /*  Sobre una sección blanca las tarjetas se despegan mejor en plomo.
      Es una decisión de contexto de esta página, no otra tarjeta. */
  .process-grid .feature-item--card { background: var(--c-bg-muted); }


  /* Tecnología */
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-1);
    margin-top: var(--sp-l2);
  }

  .tech-card {
    background: var(--c-bg-white);
    border: 1px solid var(--c-border-light);
    overflow: hidden;
  }

  .tech-img {
    height: 260px;
    overflow: hidden;
  }

  .tech-img img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform var(--t-slow);
  }

  .tech-card:hover .tech-img img { transform: scale(1.04); }

  .tech-content { padding: var(--sp-7) var(--sp-7) var(--sp-7); }

  .tech-label {
    font-size: var(--fs-xs); font-weight: var(--fw-semibold); letter-spacing: var(--ls-label);
    text-transform: uppercase; color: var(--c-secondary); margin-bottom: var(--sp-2);
  }

  .tech-title {
    font-size: var(--fs-lg); font-weight: var(--fw-bold);
    color: var(--c-text-heading); margin-bottom: var(--sp-3);
  }

  .tech-desc {
    font-size: var(--fs-base); color: var(--c-text-muted); line-height: 1.8;
  }

  @media (max-width: 1023.98px) {
    .process-grid { grid-template-columns: repeat(2, 1fr); }
    .tech-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 639.98px) {
    .process-grid { grid-template-columns: 1fr; }
  }
</style>