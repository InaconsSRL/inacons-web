---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Galeria from '../../components/Galeria.astro';
import Icono from '../../components/Icono.astro';
import MediaCard from '../../components/MediaCard.astro';
import { serviciosPorOrden, type Servicio } from '../../lib/servicios';
import { BROCHURE } from '../../data/empresa';

export async function getStaticPaths() {
  const servicios = await serviciosPorOrden();
  return servicios.map((servicio) => ({
    params: { slug: servicio.id },
    props: { servicio, otros: servicios.filter((s) => s.id !== servicio.id) },
  }));
}

interface Props {
  servicio: Servicio;
  otros: Servicio[];
}

const { servicio, otros } = Astro.props;
const { Content } = await render(servicio);
const { titulo, descripcion, imagen, especialidades, categoria, destacados, faqs, galeria } = servicio.data;

// Los proyectos de la misma categoría, para que la ficha enseñe obra y no solo
// texto. Sin `categoria` en el .md, o sin proyectos de ella, la sección no sale.
const proyectos = categoria
  ? (await getCollection('proyectos'))
      .filter((p) => p.data.categoria === categoria)
      .sort((a, b) => (a.data.orden ?? 99) - (b.data.orden ?? 99))
      .slice(0, 3)
  : [];

// La descripción del servicio es corta (68 a 109 caracteres) y un meta
// description útil ronda los 120 a 155: se le suma la frase de respaldo más
// larga que quepa. Si ya no cabe ninguna, va sola.
const RESPALDOS = ['INACONS, constructora peruana con más de 15 años de experiencia.', 'INACONS: más de 15 años en obra.'];
const metaDescripcion = RESPALDOS.map((r) => `${descripcion}. ${r}`).find((d) => d.length <= 155) ?? descripcion;

// Las secciones opcionales aparecen o no según el .md; las claras alternan
// gris y blanco para no quedar pegadas aunque falten algunas. La principal
// es blanca, así que la primera que salga es gris.
let ultimaClara: 'sec--white' | 'sec--muted' = 'sec--white';
const clara = () => (ultimaClara = ultimaClara === 'sec--white' ? 'sec--muted' : 'sec--white');

const jsonLdFaq = faqs && faqs.length > 0 && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
  })),
};
---

<BaseLayout title={`${titulo} en Perú | INACONS`} description={metaDescripcion} ogImage={imagen}>

  <PageHero
    image={imagen}
    title={titulo}
    subtitle={descripcion}
    parent={{ label: 'Servicios', href: '/servicios/' }}
    current={titulo}
    size="md"
  />

  <!-- CONTENIDO -->
  <section class="sec sec--white">
    <div class="container">
      <div class="service-layout">

        <!-- Columna principal -->
        <div data-aos="fade-up">
          <div class="prosa prosa--ficha">
            <Content />

            {especialidades && especialidades.length > 0 && (
              <>
                <h2>Nos especializamos en:</h2>
                <ul>
                  {especialidades.map((e: string) => <li>{e}</li>)}
                </ul>
              </>
            )}
          </div>

          <a href="/contacto/" class="btn btn-primary">
            Solicitar cotización
            <Icono nombre="flecha-derecha" tam={15} />
          </a>
        </div>

        <!-- Aside -->
        <aside class="service-aside">
          <!-- Descarga del brochure -->
          <div class="panel panel--sm panel--rail">
            <p class="panel-label">Descargas</p>
            <div class="download-list">
              <a href={BROCHURE} target="_blank" rel="noopener" class="download-item" data-astro-prefetch="false">
                <Icono nombre="documento" tam={18} />
                Brochure General
              </a>
            </div>
          </div>

          <!-- Otros servicios -->
          <div class="panel panel--sm panel--rail">
            <p class="panel-label">Otros servicios</p>
            <nav class="other-services" aria-label="Otros servicios">
              {otros.map((s) => (
                <a href={`/servicios/${s.id}/`} class="other-service-link">
                  {s.data.titulo}
                  <Icono nombre="chevron-derecha" tam={14} />
                </a>
              ))}
            </nav>
          </div>
        </aside>

      </div>
    </div>
  </section>

  {destacados && destacados.length > 0 && (
    <section class={`sec ${clara()}`}>
      <div class="container">
        <div class="sh sh--medium" data-aos="fade-up">
          <p class="sh-label">Por qué INACONS</p>
          <h2 class="sh-title">Lo que nos distingue</h2>
        </div>
        <div class="feature-grid">
          {destacados.map((d, i) => (
            <div class="feature-item feature-item--card" data-aos="fade-up" data-aos-delay={i * 80}>
              <div class="feature-icon"><Icono nombre={d.icono ?? 'check-circulo'} tam={24} /></div>
              <h3 class="feature-title">{d.titulo}</h3>
              <p class="feature-desc">{d.descripcion}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {galeria && galeria.length > 0 && (
    <section class={`sec ${clara()}`}>
      <div class="container">
        <Galeria fotos={galeria} titulo={titulo} />
      </div>
    </section>
  )}

  {/* Clara y no oscura: la banda de cierre es oscura y dos oscuras seguidas
      borrarían la alternancia. Las tarjetas traen su propio velo oscuro. */}
  {proyectos.length > 0 && (
    <section class={`sec ${clara()}`}>
      <div class="container">
        <div class="sh sh--row" data-aos="fade-up">
          <div class="sh-text">
            <p class="sh-label">Obra ejecutada</p>
            <h2 class="sh-title">Proyectos de {titulo}</h2>
          </div>
          <a href="/proyectos/" class="btn btn-outline">Ver todos los proyectos</a>
        </div>
        <div class="cards-row" data-aos="fade-up">
          {proyectos.map((p) => (
            <MediaCard
              href={`/proyectos/${p.id}/`}
              image={p.data.imagen}
              alt=""
              tag={p.data.categoria}
              title={p.data.titulo}
              meta={`${p.data.ubicacion} · ${p.data.año}`}
              ratio="4/5"
              ratioMobile="3/2"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {faqs && faqs.length > 0 && (
    <section class={`sec ${clara()}`}>
      <div class="container">
        <div class="sh sh--medium" data-aos="fade-up">
          <p class="sh-label">Preguntas frecuentes</p>
          <h2 class="sh-title">Lo que suelen preguntarnos</h2>
        </div>
        <div class="faq">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>
                {f.pregunta}
                <Icono nombre="chevron-abajo" tam={18} />
              </summary>
              <div class="faq-respuesta">{f.respuesta}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}
  {jsonLdFaq && <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />}

  <CtaBand
    label="¿Listo para iniciar?"
    title={`¿Tienes un proyecto de ${titulo}?`}
    description="Nuestro equipo técnico está disponible para asesorarte y presentarte una propuesta sin compromiso."
    primaryHref="/contacto/"
    primaryLabel="Contáctenos"
    secondaryHref="/proyectos/"
    secondaryLabel="Ver proyectos"
    image={imagen}
  />

</BaseLayout>

<style>
  .service-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--sp-l3);
    align-items: start;
  }

  .service-aside {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  /*  El aside separa con gap, así que el margen de .panel + .panel
      sobra: sumaría 20px a los 4 del gap, y en la rejilla de tablet
      empujaría la segunda tarjeta dentro de su celda. */
  .service-aside .panel + .panel { margin-top: 0; }

  .download-list { display: flex; flex-direction: column; gap: var(--sp-2); }

  .download-item {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    background: var(--c-bg-muted);
    border: 1.5px solid var(--c-border-light);
    border-radius: var(--radius);
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--c-text-heading);
    transition: border-color var(--t), background var(--t), color var(--t);
  }

  .download-item:hover {
    border-color: var(--c-secondary);
    background: color-mix(in srgb, var(--c-secondary) 5%, transparent);
    color: var(--c-secondary);
  }

  .other-services { display: flex; flex-direction: column; }

  .other-service-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-3) var(--sp-1);
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    color: var(--c-text-body);
    text-decoration: none;
    border-bottom: 1px solid var(--c-border-light);
    transition: color var(--t), padding-left var(--t);
  }

  .other-service-link:last-child { border-bottom: none; }

  .other-service-link:hover {
    color: var(--c-secondary);
    padding-left: var(--sp-1);
  }

  @media (max-width: 1023.98px) {
    .service-layout {
      grid-template-columns: 1fr;
      gap: var(--sp-l2);
    }
    .service-aside {
      position: static;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 767.98px) {
    .service-aside { grid-template-columns: 1fr; }
  }
</style>
