---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  /** Valor de meta robots (p. ej. `noindex, follow` en 404) */
  robots?: string;
  /** Sin top bar, header, menú móvil, footer ni volver arriba (p. ej. 404) */
  minimalChrome?: boolean;
}

const {
  title,
  description,
  ogImage = '/assets/imagenes/image_heroprincipal.webp',
  canonical,
  robots = 'index, follow',
  minimalChrome = false,
} = Astro.props;

const pageTitle       = title ?? 'INACONS — Empresa Constructora en Perú';
const metaDescription = description ?? 'INACONS S.R.L. — Empresa peruana de ingeniería y construcción con más de 15 años de experiencia en obras civiles, infraestructura, electromecánica y más.';
const canonicalURL    = canonical ?? Astro.url.href;
const ogImageURL      = `https://inacons.com.pe${ogImage}`;
const pathname        = Astro.url.pathname;
---

<html lang="es" class:list={{ 'layout-minimal': minimalChrome }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robots} />

    <!-- Título sin sufijo duplicado: cada página pasa el título completo -->
    <title>{pageTitle}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#14172d" />

    <!-- Open Graph -->
    <meta property="og:type"         content="website" />
    <meta property="og:site_name"    content="INACONS" />
    <meta property="og:title"        content={pageTitle} />
    <meta property="og:description"  content={metaDescription} />
    <meta property="og:image"        content={ogImageURL} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url"          content={canonicalURL} />
    <meta property="og:locale"       content="es_PE" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image"       content={ogImageURL} />

    <!--
      FONTS — preconnect primero, luego carga no bloqueante.
      onload cambia rel a stylesheet una vez descargada.
      <noscript> como fallback para JS desactivado.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap&subset=latin"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap&subset=latin"
      />
    </noscript>

    <!-- Design System INACONS -->
    <link rel="stylesheet" href="/assets/css/design-system.css" />

    <!-- Animaciones de scroll -->
    <link rel="stylesheet" href="/assets/css/scroll-animations.css" />

    <!-- JSON-LD: LocalBusiness — aparece en Knowledge Panel y rich results -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "INACONS S.R.L.",
      "url": "https://inacons.com.pe",
      "logo": "https://inacons.com.pe/assets/imagenes/logos/logo_inacons.svg",
      "image": "https://inacons.com.pe/assets/imagenes/image_heroprincipal.webp",
      "description": "Empresa peruana de ingeniería y construcción con más de 15 años de experiencia en obras civiles, infraestructura, electromecánica, minería y consultoría.",
      "foundingDate": "2009",
      "telephone": "+51-064-654-736",
      "email": "ventas@inacons.com.pe",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Av. Las Casuarinas 256",
        "addressLocality": "Pucusana",
        "addressRegion": "Lima",
        "postalCode": "15830",
        "addressCountry": "PE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -12.4762,
        "longitude": -76.7344
      },
      "areaServed": {
        "@type": "Country",
        "name": "Perú"
      },
      "sameAs": [
        "https://www.facebook.com/www.inacons.com.pe",
        "https://pe.linkedin.com/company/inacons"
      ],
      "hasCredential": [
        { "@type": "EducationalOccupationalCredential", "name": "ISO 9001" },
        { "@type": "EducationalOccupationalCredential", "name": "ISO 14001" },
        { "@type": "EducationalOccupationalCredential", "name": "ISO 45001" },
        { "@type": "EducationalOccupationalCredential", "name": "ISO 37001" }
      ]
    })} />

    <slot name="head" />
  </head>

  <body>

