---
import '../styles/design-system.css';
import '../styles/scroll-animations.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import { PUBLIC_ANALYTICS_TOKEN } from 'astro:env/client';
import Icono from '../components/Icono.astro';
import { serviciosPorMenu } from '../lib/servicios';
import { BROCHURE, CONTACTO } from '../data/empresa';
import imagenPorDefecto from '../assets/imagenes/image_heroprincipal.webp';

interface Props {
  title?: string;
  description?: string;
  /** Imagen para compartir. Se recorta a 1200×630, el tamaño que piden las redes. */
  ogImage?: ImageMetadata;
  canonical?: string;
  /** Valor de meta robots (p. ej. `noindex, follow` en 404) */
  robots?: string;
  /** Sin top bar, header, menú móvil, footer ni volver arriba (p. ej. 404) */
  minimalChrome?: boolean;
}

const {
  title,
  description,
  ogImage = imagenPorDefecto,
  canonical,
  robots = 'index, follow',
  minimalChrome = false,
} = Astro.props;

const pageTitle       = title ?? 'INACONS — Empresa Constructora en Perú';
const metaDescription = description ?? 'INACONS S.R.L. — Empresa peruana de ingeniería y construcción con más de 15 años de experiencia en obras civiles, infraestructura, electromecánica y más.';
const canonicalURL    = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const og              = await getImage({ src: ogImage, quality: 70, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogImageURL      = new URL(og.src, Astro.site).href;

const ruta      = Astro.url.pathname.replace(/\/$/, '') || '/';
const actual    = (href: string) => (ruta === href.replace(/\/$/, '') ? 'page' : undefined);
const seccion   = (href: string) => (ruta.startsWith(href.replace(/\/$/, '')) ? 'page' : undefined);
const servicios = await serviciosPorMenu();
const { correoVentas, telefono, whatsapp, redes, intranet, proveedores } = CONTACTO;
---

<html lang="es" class:list={{ 'layout-minimal': minimalChrome }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robots} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#14172d" />

    <meta property="og:type"         content="website" />
    <meta property="og:site_name"    content="INACONS" />
    <meta property="og:title"        content={pageTitle} />
    <meta property="og:description"  content={metaDescription} />
    <meta property="og:image"        content={ogImageURL} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url"          content={canonicalURL} />
    <meta property="og:locale"       content="es_PE" />
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image"       content={ogImageURL} />

    <Font cssVariable="--font-montserrat" preload={[{ weight: 400 }, { weight: 700 }]} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "GeneralContractor",
      "name": "INACONS S.R.L.",
      "url": Astro.site?.href,
      "logo": new URL('/assets/imagenes/logos/logo_inacons.svg', Astro.site).href,
      "image": ogImageURL,
      "description": "Empresa peruana de ingeniería y construcción con más de 15 años de experiencia en obras civiles, infraestructura, electromecánica, minería y consultoría.",
      "foundingDate": "2009",
      "telephone": "+51 64 654736",
      "email": correoVentas,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Av. Las Casuarinas 256",
        "addressLocality": "Pucusana",
        "addressRegion": "Lima",
        "postalCode": "15830",
        "addressCountry": "PE"
      },
      "geo": { "@type": "GeoCoordinates", "latitude": -12.4762, "longitude": -76.7344 },
      "areaServed": { "@type": "Country", "name": "Perú" },
      "sameAs": [redes.facebook, redes.linkedin],
      "hasCredential": ['ISO 9001', 'ISO 14001', 'ISO 45001', 'ISO 37001'].map((name) => ({
        "@type": "EducationalOccupationalCredential", name,
      })),
    })} />

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    {!minimalChrome && (
      <>
        <div class="top-bar">
          <div class="container">
            <div class="top-bar-left">
              <a class="top-bar-contact" href={`mailto:${correoVentas}`}>
                <Icono nombre="correo" tam={14} />
                <span>{correoVentas}</span>
              </a>
              <a class="top-bar-contact" href={telefono.href}>
                <Icono nombre="telefono" tam={14} />
                <span>{telefono.texto}</span>
              </a>
            </div>
            <div class="top-bar-right">
              <div class="top-bar-social">
                <a href={whatsapp.href} target="_blank" rel="noopener" aria-label="WhatsApp"><Icono nombre="whatsapp" /></a>
                <a href={redes.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icono nombre="facebook" /></a>
              </div>
              <span class="tb-sep" aria-hidden="true">|</span>
              <div class="top-bar-links">
                <a href={intranet} class="top-bar-pill" target="_blank" rel="noopener">Intranet</a>
                <a href={proveedores} class="top-bar-pill" target="_blank" rel="noopener">Proveedores</a>
                <a href="/contacto/" class="top-bar-pill top-bar-pill--accent">Contáctenos</a>
              </div>
            </div>
          </div>
        </div>

        <header class="header with-topbar" id="header">
          <div class="container">
            <a href="/" class="logo">
              <img src="/assets/imagenes/logos/logo_inacons_white.svg" alt="INACONS" class="logo-white" width="160" height="40" />
              <img src="/assets/imagenes/logos/logo_inacons.svg" alt="INACONS" class="logo-color" width="160" height="40" />
            </a>
            <nav class="nav" aria-label="Principal">
              <ul>
                <li><a href="/nosotros/" aria-current={seccion('/nosotros/')}>Nosotros</a></li>
                <li class="dropdown">
                  <a href="/servicios/" aria-current={seccion('/servicios/')}>
                    Servicios
                    <Icono nombre="chevron-abajo" tam={10} trazo={2.5} class="nav-chevron" />
                  </a>
                  <ul class="dropdown-menu">
                    {servicios.map((s) => (
                      <li>
                        <a href={`/servicios/${s.id}/`} aria-current={actual(`/servicios/${s.id}/`)}>
                          <Icono nombre={s.data.icono} trazo={1.75} />
                          {s.data.titulo}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
                <li><a href="/proyectos/" aria-current={seccion('/proyectos/')}>Proyectos</a></li>
                <li><a href="/sostenibilidad/" aria-current={actual('/sostenibilidad/')}>Sostenibilidad</a></li>
                <li><a href="/documentos/" aria-current={actual('/documentos/')}>Documentos</a></li>
              </ul>
            </nav>
            <button class="menu-toggle" id="menuToggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobileMenu">
              <Icono nombre="menu" tam={24} />
            </button>
          </div>
        </header>

        <div class="mobile-menu" id="mobileMenu" role="dialog" aria-modal="true" aria-label="Menú de navegación">
          <div class="mobile-menu-overlay" aria-hidden="true"></div>
          <div class="mobile-menu-content">
            <div class="mobile-menu-header">
              <button type="button" class="mobile-menu-close" id="mobileMenuClose" aria-label="Cerrar menú">
                <Icono nombre="cerrar" tam={18} trazo={2.5} />
              </button>
            </div>

            <nav class="mobile-nav" aria-label="Menú móvil">
              <ul>
                <li>
                  <a href="/nosotros/">
                    <Icono nombre="maletin" />
                    Nosotros
                  </a>
                </li>
                <li class="mobile-dropdown">
                  <button type="button" class="mobile-dropdown-toggle" aria-expanded="false" aria-controls="mobile-servicios-submenu" id="mobile-servicios-btn">
                    <Icono nombre="cuadricula" />
                    Servicios
                    <Icono nombre="chevron-abajo" tam={14} trazo={2.5} class="mobile-dropdown-icon" />
                  </button>
                  <ul class="mobile-submenu" id="mobile-servicios-submenu" role="group" aria-labelledby="mobile-servicios-btn">
                    {servicios.map((s) => <li><a href={`/servicios/${s.id}/`}>{s.data.titulo}</a></li>)}
                  </ul>
                </li>
                <li>
                  <a href="/proyectos/">
                    <Icono nombre="carpeta-abierta" />
                    Proyectos
                  </a>
                </li>
                <li>
                  <a href="/sostenibilidad/">
                    <Icono nombre="escudo" />
                    Sostenibilidad
                  </a>
                </li>
                <li>
                  <a href="/documentos/">
                    <Icono nombre="documento" />
                    Documentos
                  </a>
                </li>
                <li>
                  <a href="/canal-etico/">
                    <Icono nombre="ubicacion" />
                    Canal Ético
                  </a>
                </li>
              </ul>
            </nav>

            <div class="mobile-menu-bottom">
              <div class="mobile-menu-actions">
                <a href="/contacto/" class="mobile-btn-primary">Contáctenos</a>
                <a href={BROCHURE} target="_blank" rel="noopener" class="mobile-btn-outline">Descargar Brochure</a>
              </div>
              <div class="mobile-menu-footer">
                <div class="mobile-menu-socials">
                  <a href={whatsapp.href} target="_blank" rel="noopener" aria-label="WhatsApp"><Icono nombre="whatsapp" tam={18} /></a>
                  <a href={redes.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icono nombre="facebook" tam={18} /></a>
                  <a href={redes.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icono nombre="linkedin" tam={18} /></a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </>
    )}

    <main id="contenido" class:list={['main', { 'with-topbar': !minimalChrome }]}>
      <slot />
    </main>

    {!minimalChrome && (
      <>
        <footer class="footer">
          <div class="container">
            <div class="footer-content">
              <div class="footer-section footer-brand">
                <div class="footer-logo">
                  <img src="/assets/imagenes/logos/logo_inacons_white.svg" alt="INACONS" width="160" height="40" />
                </div>
                <p class="footer-slogan">
                  CONSTRUIMOS CONFIANZA<br />
                  INNOVAMOS ESPACIOS<br />
                  TRASCENDEMOS JUNTOS
                </p>
                <div class="footer-social">
                  <a href={whatsapp.href} target="_blank" rel="noopener" aria-label="WhatsApp"><Icono nombre="whatsapp" /></a>
                  <a href={redes.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icono nombre="facebook" /></a>
                  <a href={redes.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icono nombre="linkedin" /></a>
                </div>
              </div>

              <div class="footer-section">
                <h3>Navegación</h3>
                <ul>
                  <li><a href="/nosotros/">Nosotros</a></li>
                  <li><a href="/servicios/">Servicios</a></li>
                  <li><a href="/proyectos/">Proyectos</a></li>
                  <li><a href="/sostenibilidad/">Sostenibilidad</a></li>
                  <li><a href="/documentos/">Documentos</a></li>
                  <li><a href="/recursos/">Recursos</a></li>
                </ul>
              </div>

              <div class="footer-section">
                <h3>Servicios</h3>
                <ul>
                  {servicios.map((s) => <li><a href={`/servicios/${s.id}/`}>{s.data.titulo}</a></li>)}
                </ul>
              </div>

              <div class="footer-section">
                <h3>Contacto</h3>
                <ul>
                  <li><a href={`mailto:${correoVentas}`}><Icono nombre="correo" tam={14} /> {correoVentas}</a></li>
                  <li><a href={telefono.href}><Icono nombre="telefono" tam={14} /> {telefono.texto}</a></li>
                </ul>
                <!--
                  Canal Ético va en el pie como botón y no como un enlace más en
                  una lista: tres menciones en texto plano por página no se veían.
                -->
                <a href="/canal-etico/" class="btn btn-accent btn-sm footer-ethics">
                  <Icono nombre="escudo" tam={15} />
                  Canal Ético
                </a>
              </div>
            </div>
          </div>

          <div class="footer-bottom">
            <div class="container">
              <p>&copy; {new Date().getFullYear()} INACONS S.R.L. — Todos los derechos reservados.</p>
              <div class="footer-bottom-links">
                <a href="/documentos/">Certificaciones y políticas</a>
              </div>
            </div>
          </div>
        </footer>

        <button class="back-to-top" id="backToTop" aria-label="Volver arriba">
          <Icono nombre="chevron-arriba" tam={18} trazo={2.5} />
        </button>
      </>
    )}

    <script>
      import '../scripts/main';
    </script>

    {PUBLIC_ANALYTICS_TOKEN && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: PUBLIC_ANALYTICS_TOKEN })}
      ></script>
    )}
  </body>
</html>
