ErrorDocument 404 /404.html
Options -Indexes

# Apache no conoce .webmanifest: lo servía sin Content-Type, y con nosniff el
# navegador podía descartar el manifest.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── QR ya impresos ───────────────────────────────────────────────────
    #  Hay material en circulación (flyers A4, stand de Expomina) con QR que
    #  apuntan a /r/CODIGO y a /empresa/?c=CODIGO. El redirector dinámico se
    #  retiró; estas reglas fijas mantienen vivo ese papel sin base de datos.
    #
    #  302 y no 301: el sistema nuevo podrá tomar /r/ sin pelear contra
    #  redirecciones permanentes guardadas en la caché de cada navegador.
    #
    #  [NC] NO ES OPCIONAL. Los QR se codificaron en MAYÚSCULAS (modo
    #  alfanumérico), así que el escaneo llega como /R/CANAL_ETICO. Sin [NC]
    #  el patrón no engancha y el papel da 404, aunque tecleado en minúsculas
    #  funcione. Guion bajo y guion medio valen igual: así se imprimieron.
    RewriteRule ^r/canal[_-]etico/?$ /canal-etico/ [R=302,NC,L]
    RewriteRule ^r/tickets[_-]ti/?$ https://materen-ti.vercel.app/soporte [R=302,NC,L]
    RewriteRule ^r/expomina[_-]form/?$ /mineria/ [R=302,NC,L]
    RewriteRule ^r(/.*)?$ / [R=302,NC,L]

    #  Forma larga que generaba el sistema anterior a /r/. Los dos flyers de
    #  /recursos/ la llevan impresa: /empresa/?c=canal_etico y ?c=tickets_ti.
    RewriteCond %{QUERY_STRING} (?:^|&)c=canal[_-]etico(?:&|$) [NC]
    RewriteRule ^empresa/?$ /canal-etico/? [R=302,NC,L]
    RewriteCond %{QUERY_STRING} (?:^|&)c=tickets[_-]ti(?:&|$) [NC]
    RewriteRule ^empresa/?$ https://materen-ti.vercel.app/soporte? [R=302,NC,L]
    RewriteRule ^empresa(/.*)?$ /? [R=302,NC,L]

    #  QR del stand de Expomina 2026, codificado directo a /expomina/.
    RewriteRule ^expomina/?$ /mineria/ [R=301,NC,L]

    #  Sitio anterior (HTML plano). Sus archivos pueden seguir en el servidor
    #  —el deploy solo borra lo que él mismo subió— y Google y enlaces externos
    #  los conocen: 301 a la página equivalente. Cualquier otro .html de la raíz
    #  va al inicio. index.html y 404.html son del sitio actual y se excluyen;
    #  [NS] evita que la subpetición interna de DirectoryIndex entre en bucle.
    RewriteRule ^(canal-etico|nosotros|servicios|proyectos|contacto|documentos|sostenibilidad|mineria|recursos)\.html$ /$1/ [R=301,NC,NS,L]
    RewriteRule ^certificacion\.html$ /documentos/ [R=301,NC,NS,L]
    RewriteRule ^(obras-civiles|infraestructura|electromecanica|paisajismo|consultoria)\.html$ /servicios/$1/ [R=301,NC,NS,L]
    RewriteRule ^(brochure_inacons|certificado_ince_489)\.pdf$ /assets/documentos/$1.pdf [R=301,NC,NS,L]
    #  Los archivos con que Google o Yandex verifican la propiedad del sitio
    #  (google1a2b….html) se suben a la raíz: no se redirigen.
    RewriteCond %{REQUEST_URI} !^/(index|404)\.html$ [NC]
    RewriteCond %{REQUEST_URI} !^/(google[0-9a-f]+|yandex_[0-9a-f]+)\.html$ [NC]
    RewriteRule ^[^/]+\.html$ / [R=301,NC,NS,L]

    #  Activos con hash de Astro: marca para la regla de caché de abajo.
    RewriteRule ^_astro/ - [E=ASSET_INMUTABLE:1]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/manifest+json image/svg+xml
</IfModule>

# ── Caché ───────────────────────────────────────────────────────────────────
#  Una sola fuente: mod_headers. mod_expires emite su propio Cache-Control y
#  deja cada respuesta con dos valores en conflicto.
#
#  El hosting añade después un segundo Cache-Control por tipo de archivo
#  (HTML 1 h, CSS 1 día, SVG 7 días, fuentes 30 días). Lo pone un proxy delante
#  de Apache, no Apache: ni ExpiresActive Off ni Header unset lo quitan (probado
#  en producción, oct-2026), y el plan contratado no permite cambiarlo. No
#  rompe nada: `no-cache` sigue obligando a revalidar el
#  HTML. Lo que se pierde es que los activos con hash pueden revalidarse antes
#  del año que piden, porque el max-age duplicado deja la decisión al navegador.

<IfModule mod_headers.c>

    #  Activos con hash en el nombre (CSS, JS e imágenes que procesa Astro):
    #  cambiar el contenido cambia la URL, así que se cachean para siempre.
    Header always set Cache-Control "public, max-age=31536000, immutable" env=ASSET_INMUTABLE

    #  Archivos de public/ con nombre fijo (logos, mapa, favicon, PDF, vídeo):
    #  un mes. Reemplazar uno con el mismo nombre se ve, como mucho, a los 30 días.
    <FilesMatch "\.(svg|png|jpe?g|webp|ico|pdf|mp4|webm|woff2?)$">
        Header always set Cache-Control "public, max-age=2592000" env=!ASSET_INMUTABLE
    </FilesMatch>

    #  El HTML se revalida siempre: es lo que hace que un despliegue se vea al instante.
    <FilesMatch "\.html$">
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    Header always unset Expires

    Header always set X-Frame-Options           "SAMEORIGIN"
    Header always set X-Content-Type-Options    "nosniff"
    Header always set Referrer-Policy           "strict-origin-when-cross-origin"
    Header always set Permissions-Policy        "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    #  Content-Security-Policy SOLO EN MODO INFORME: no bloquea nada. Cada
    #  violación llega al Worker (ruta /csp) y queda como una línea "CSP: …" en
    #  sus Logs. Pasa a Content-Security-Policy cuando dos semanas de uso no
    #  dejen ninguna (docs/deploy.md).
    #
    #  · style-src 'unsafe-inline' es obligado: Astro emite <style> en línea
    #    (las fuentes, y el de cada página) y atributos style="--var".
    #  · img-src data: porque Vite inlinea como data: las imágenes de menos de 4 KB.
    #  · Los dos sha256 son los únicos scripts en línea del build: la clase .js
    #    de BaseLayout (todas las páginas) y el de /mineria/, que cambia con cada
    #    edición de ese script. `npm run verificar` corta el CI si falta uno y
    #    dice cuál. El del Canal Ético sale como archivo porque importa
    #    scripts/formulario.ts.
    #  · Orígenes externos: Turnstile (script e iframe), Web Analytics (script y
    #    beacon), Google Maps y YouTube (iframes) y el Worker de los formularios,
    #    con su host exacto: *.workers.dev dejaba enviar datos a cualquier worker
    #    de terceros. Si cambia la URL del Worker (PUBLIC_CONTACT_ENDPOINT), se
    #    cambia aquí también, en connect-src y en los dos destinos de informes.
    #  · form-action no hereda de default-src: sin él, un formulario inyectado
    #    podía enviar a cualquier sitio.
    #  · report-to es el mecanismo actual; report-uri lo usan los navegadores
    #    que todavía no lo tienen. Los dos van al mismo sitio.
    Header always set Reporting-Endpoints "csp=\"https://inacons-contacto.inacons-contacto.workers.dev/csp\""
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo=' 'sha256-X7f38Rm03e4eDWszzUfulzld4NsflpG5r7sS0usZlr0=' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://inacons-contacto.inacons-contacto.workers.dev https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com https://www.google.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri https://inacons-contacto.inacons-contacto.workers.dev/csp; report-to csp"
</IfModule>
