# Error pages
ErrorDocument 404 /404.html

# ── URL corta para QR ───────────────────────────────────────────
#  home.inacons.com.pe/r/CODIGO  →  public/r/index.php, que resuelve contra
#  Supabase, registra el escaneo y hace el 302 al destino.
#
#  Usar SIEMPRE el host home.inacons.com.pe en el QR, nunca inacons.com.pe:
#  el dominio principal hace 301 a home, así que entrar por él agrega un
#  salto al inicio y otro al final (el destino también es home). Son cuatro
#  redirecciones en vez de dos, sobre la wifi saturada de un pabellón.
#
#  Menos caracteres = menos módulos = QR más legible en pantalla y video.
#  El destino sigue siendo editable sin reimprimir ni volver a renderizar el
#  video: esa es la razón de existir de esta capa.
<IfModule mod_rewrite.c>
    RewriteEngine On

    #  Reescritura INTERNA, no redirección: el visitante no paga un salto de
    #  más y la URL que ve sigue siendo /r/CODIGO.
    #
    #  [NC] NO ES OPCIONAL. El módulo codifica la URL entera en MAYÚSCULAS para
    #  habilitar el modo alfanumérico del estándar QR, así que lo que llega del
    #  escaneo es `/R/CODIGO`, no `/r/codigo`. Sin [NC] este patrón no engancha
    #  y Apache devuelve 404 antes de que el PHP llegue a ejecutarse: el código
    #  existe, la base está bien, el redirector funciona, y aun así falla.
    #
    #  Pasó: todos los QR generados por el panel devolvían "no encontrado"
    #  mientras los enlaces tecleados en minúsculas funcionaban. Se hizo
    #  insensible el CÓDIGO dentro de resolver_qr() y se olvidó el SEGMENTO de
    #  la ruta, que lo resuelve Apache y no Postgres.
    #
    #  El patrón no admite puntos, así que /r/index.php no se reescribe a sí
    #  mismo. La condición !-f es el cinturón además del tirante.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^r/([A-Za-z0-9_-]{2,24})/?$ /r/index.php?c=$1 [L,QSA,NC]

    #  Compatibilidad con la forma larga. /recursos/ generó códigos con este
    #  formato y alguno puede estar en un flyer o una presentación.
    #
    #  ── LEER ANTES DE TOCAR ───────────────────────────────────────────────
    #  Hasta la Fase 2 la regla era la INVERSA: /r/X → /empresa/?c=X. Tener
    #  las dos a la vez es un bucle infinito de redirecciones, y por eso la
    #  vieja se borró en el mismo commit que entró esta. Si alguna vez hay que
    #  revertir, se revierten las dos juntas o el sitio se cuelga.
    RewriteCond %{QUERY_STRING} (?:^|&)c=([A-Za-z0-9_-]{2,24})(?:&|$) [NC]
    RewriteRule ^empresa/?$ /r/%1? [R=301,L,NE,NC]
</IfModule>

# ── Compresión Deflate/Gzip ─────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/pdf
    AddOutputFilterByType DEFLATE font/woff font/woff2
</IfModule>

# ── Caché de activos estáticos ──────────────────────────────────────────────
#
#  LEER ANTES DE TOCAR. Este bloque no basta por sí solo.
#
#  El hosting inyecta su propio `Cache-Control` por encima de lo que declare
#  mod_expires, y cuando la respuesta lleva los dos, `Cache-Control: max-age`
#  le gana a `Expires`. Medido en producción: el HTML salía con
#  `Expires: <ahora>` —el "0 segundos" de aquí, aplicado correctamente— y a la
#  vez `Cache-Control: max-age=3600`. Ganaba el segundo, así que un despliegue
#  tardaba hasta una hora en llegarle a quien ya había visitado el sitio.
#
#  Por eso lo que de verdad importa se fija más abajo con mod_headers, que sí
#  se respeta. Esto queda como valor de base para lo que nadie pise.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/x-icon           "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType font/woff              "access plus 1 year"
    ExpiresByType application/pdf        "access plus 6 months"
    ExpiresByType video/mp4              "access plus 1 month"
    ExpiresByType text/html              "access plus 0 seconds"

    #  CSS y JS a un día, NO a un año.
    #
    #  /assets/css/design-system.css y /assets/js/main.js viven en public/ con
    #  un nombre fijo: si cambia el contenido, la URL no cambia. Cachearlos un
    #  año significa que un arreglo de estilos no le llega durante un año a
    #  quien ya visitó el sitio, sin forma de corregirlo salvo renombrar el
    #  archivo. Los que sí pueden cachearse para siempre son los de /_astro/,
    #  que llevan un hash en el nombre — ver la regla de abajo.
    ExpiresByType text/css               "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
</IfModule>

# ── Activos con hash: inmutables ────────────────────────────────────────────
#  Astro nombra lo de /_astro/ con un hash del contenido. Cambiar el contenido
#  cambia la URL, así que la respuesta vieja nunca queda obsoleta y se puede
#  guardar para siempre.
<IfModule mod_rewrite.c>
    RewriteRule ^_astro/ - [E=ASSET_INMUTABLE:1]
</IfModule>

# ── Cabeceras de seguridad ───────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always unset Cache-Control env=ASSET_INMUTABLE
    Header always set Cache-Control "public, max-age=31536000, immutable" env=ASSET_INMUTABLE

    #  El HTML se revalida SIEMPRE. Es la única forma de que un despliegue se
    #  vea al instante: sin esto el hosting le pone una hora, y durante esa
    #  hora quien ya había entrado sigue viendo la versión anterior. Pasó de
    #  verdad — una página quedó mostrando un código QR ya corregido.
    #  `unset` antes de `set`: el hosting agrega su propia cabecera y sin
    #  quitarla primero la respuesta sale con dos Cache-Control en conflicto.
    <FilesMatch "\.html$">
        Header always unset Cache-Control
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    Header always set X-Frame-Options        "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy        "strict-origin-when-cross-origin"
    Header always set Permissions-Policy     "camera=(), microphone=(), geolocation=(self)"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
