# Error pages
ErrorDocument 404 /404.html

# ── URL corta para QR ───────────────────────────────────────────
#  home.inacons.com.pe/r/CODIGO  →  home.inacons.com.pe/empresa/?c=CODIGO
#
#  Usar SIEMPRE el host home.inacons.com.pe en el QR, nunca inacons.com.pe:
#  el dominio principal hace 301 a home, así que entrar por él agrega un
#  salto al inicio y otro al final (el destino también es home). Son cuatro
#  redirecciones en vez de dos, sobre la wifi saturada de un pabellón.
#
#  Menos caracteres = menos módulos = QR más legible en pantalla y video.
#    https://home.inacons.com.pe/r/e   → 31 caracteres → 25x25 módulos
#  El destino sigue siendo editable desde /empresa/admin.php sin reimprimir
#  ni volver a renderizar el video: esa es la razón de existir de esta capa.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^r/([A-Za-z0-9_-]+)/?$ https://home.inacons.com.pe/empresa/?c=$1 [R=302,L,NE]
</IfModule>

# ── Compresión Deflate/Gzip ─────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/pdf
    AddOutputFilterByType DEFLATE font/woff font/woff2
</IfModule>

# ── Caché de activos estáticos ──────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/x-icon           "access plus 1 year"
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType font/woff              "access plus 1 year"
    ExpiresByType application/pdf        "access plus 6 months"
    ExpiresByType video/mp4              "access plus 1 month"
    ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

# ── Cabeceras de seguridad ───────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options        "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy        "strict-origin-when-cross-origin"
    Header always set Permissions-Policy     "camera=(), microphone=(), geolocation=(self)"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
