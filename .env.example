# Copiar como `.env` para desarrollo local. En producción los valores salen de
# las variables de repositorio del mismo nombre (ver .github/workflows/deploy.yml).

# URL que recibe el formulario de /contacto/ por POST (JSON). Es pública: viaja
# dentro del JavaScript del sitio. Vacía, el formulario abre el correo del
# visitante. Contrato en docs/contenido.md.
PUBLIC_CONTACT_ENDPOINT=

# Clave de sitio de Cloudflare Turnstile (anti-bots del formulario). Pública.
# Para probar en local: 1x00000000000000000000AA, la clave de prueba de
# Cloudflare que siempre aprueba.
PUBLIC_TURNSTILE_SITE_KEY=

# Token de Cloudflare Web Analytics (sin cookies). Público: va en el HTML.
# Vacío, no se carga ningún script de analítica.
PUBLIC_ANALYTICS_TOKEN=
