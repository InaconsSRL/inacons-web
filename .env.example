# Copiar como `.env` para desarrollo local. En producción el valor sale de la
# variable de repositorio PUBLIC_CONTACT_ENDPOINT (ver .github/workflows/deploy.yml).

# URL que recibe el formulario de /contacto/ por POST (JSON). Es pública: viaja
# dentro del JavaScript del sitio. Vacía, el formulario abre el correo del
# visitante. Contrato en docs/contenido.md.
PUBLIC_CONTACT_ENDPOINT=
