# Copiar este archivo como `.env` y rellenar con los valores del proyecto de
# Supabase: Project Settings > API.
#
# `.env` esta en .gitignore y no se sube nunca. Este `.env.example` si se sube,
# porque documenta QUE variables hacen falta sin revelar ningun valor.

# Project URL — algo como https://abcdefghijk.supabase.co
PUBLIC_SUPABASE_URL=

# Clave `anon` / `public`. Es publica por diseno: viaja dentro del JavaScript
# que descarga el navegador y cualquiera puede leerla. Lo que impide que sirva
# para algo es RLS, del lado de la base.
PUBLIC_SUPABASE_ANON_KEY=

# La clave `service_role` NO va aqui ni en ningun archivo de este repositorio.
# Se salta RLS entera: quien la tenga tiene la base completa, sin login.
